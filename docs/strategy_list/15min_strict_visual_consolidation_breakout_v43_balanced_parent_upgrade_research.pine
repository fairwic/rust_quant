//@version=6
// V43 识别合同：完整继承 V42；父区间仍允许向左升级，但候选 visual_parent 的实体中心不得超过 75% 聚集在同一半侧。
// 手工研究账本仍是精确净 R 真源；strategy.* 订单只镜像到 TradingView 策略测试器，不接 alert、Paper 或 Live。
// 内置测试器用双边各 4.5bps 对称费用近似手工账本的入场 3bps / 出场 6bps，总往返成本同为 9bps。
// 每笔按策略初始资金 1% 的初始止损风险定仓，保证金参数为 20%（最高 5x），用于把测试器盈亏换算到 R。
// 父区间继续显示 V39 visual_parent + V31 trade_core；橙黄双层为父内 V41 子区间。
// V43 只修正识别与绘图；冻结的开仓/回踩/止盈止损组合 L2 未晋级，所有输出仍为 Research-only。
strategy("15m Strict Visual Breakout - V43 Balanced Parent Research-only", overlay = true,
     pyramiding = 0, initial_capital = 100000, default_qty_type = strategy.fixed,
     default_qty_value = 1, process_orders_on_close = false,
     commission_type = strategy.commission.percent, commission_value = 0.045,
     margin_long = 20, margin_short = 20, max_bars_back = 300,
     max_boxes_count = 240, max_lines_count = 360, max_labels_count = 500)

const string RULE_VERSION = "strict_visual_v43_balanced_parent_upgrade_15m_research_v1"
const string VISUAL_RULE_VERSION = "v43_balanced_parent_upgrade_over_v42_contained_body"
const bool EXEMPT_FULLY_CONTAINED_INTERNAL_BODY = true
const float MAXIMUM_PARENT_UPGRADE_DOMINANT_HALF_RATIO = 0.75
const int MS_15M = 15 * 60 * 1000
const int LOAD_START_MS = 1779287400000  // 2026-05-20 14:30 UTC，V43 L2 评价窗前 60 天。
const int EVALUATION_START_MS = 1784471400000  // 2026-07-19 14:30 UTC。
const int EVALUATION_END_MS = 1786248000000  // 2026-08-09 04:00 UTC，V43 L2 最后一根完成棒。
const int ATR_LENGTH = 14
const int ACCEPTANCE_WINDOW_BARS = 5
const float MAXIMUM_WIDTH_RATIO = 0.03
const float MINIMUM_CONTAINMENT_RATIO = 0.80
const float MAXIMUM_DIRECTION_EFFICIENCY = 0.35
const int MINIMUM_EDGE_TRANSITIONS = 3
const float MAXIMUM_UPPER_DRIFT = 0.25
const float MAXIMUM_LOWER_DRIFT = 0.35
const int MINIMUM_TOUCH_GAP = 2
const float TOUCH_BAND_HEIGHT_RATIO = 0.10
const float TRANSITION_BAND_HEIGHT_RATIO = 0.20
const float DEFAULT_BREAKOUT_MIN_BODY_RATIO = 0.50
const float DEFAULT_BREAKOUT_MIN_DIRECTIONAL_MOVE_RATIO = 0.0015
const float RETEST_BAND_PRICE_RATIO = 0.001
const float RETEST_BAND_ATR_RATIO = 0.25
const float RETAINED_BREAKOUT_EXCESS_RATIO = 0.25
const float MINIMUM_ACCEPTANCE_RETENTION_RATIO = 0.75
const float MAXIMUM_INTERNAL_BODY_TO_RANGE_HEIGHT = 0.50
const float DEFAULT_MINIMUM_STOP_ATR = 1.0
// V43 成本合同：入场 maker 2 bps、出场 taker 5 bps，双边各加 1 bps 滑点等价成本。
const float MAKER_COST_RATE_PER_SIDE = 0.0002
const float TAKER_COST_RATE_PER_SIDE = 0.0005
const float SLIPPAGE_COST_RATE_PER_SIDE = 0.0001
const string TV_LONG_ENTRY_ID = "V43-TV-L"
const string TV_SHORT_ENTRY_ID = "V43-TV-S"
const string TV_LONG_EXIT_ID = "V43-TV-L-X"
const string TV_SHORT_EXIT_ID = "V43-TV-S-X"

// 横盘上下边界百分位可调：越接近 100/0 越贴近真实极值，区间更高、更宽松；
// 默认 90/10 是原始严格口径，改动会影响区间高度、结构止损与量度目标，属研究参数。
// 两个输入都按「贴近极值程度」表述，数值越大越贴近真实极值：
// 上边界 98 取 high 的 P98，下边界 98 取 low 的 P2，语义对齐，不用心算补数。
const string rangeGroup = "横盘边界"
upperBoundaryStrength = input.float(90.0, "上边界贴近极值 %", minval = 50.0, maxval = 100.0,
     step = 0.5, group = rangeGroup,
     tooltip = "取最近 N 根 high 的该百分位作为横盘上边界。90 = P90，98 = P98，越大区间越高。")
symmetricBoundary = input.bool(true, "下边界与上边界对称", group = rangeGroup,
     tooltip = "开启时下边界自动跟随上边界取值；关闭后可单独设定下边界。")
lowerBoundaryStrength = input.float(90.0, "下边界贴近极值 %", minval = 50.0, maxval = 100.0,
     step = 0.5, group = rangeGroup,
     tooltip = "仅在关闭对称时生效。取最近 N 根 low 的 (100 - 该值) 百分位：90 = P10，98 = P2。")

enableRawRangeGuard = input.bool(false, "启用真实极差门禁", group = rangeGroup,
     tooltip = "开启后，区间真实 high-low 极差相对 P90/P10 带的膨胀倍数超过阈值即判非横盘，用于排除被百分位边界掩盖的大波段与 U 形折返。60 币种全样本回测显示该门禁为负向，默认关闭。")
maximumRawToBandRatio = input.float(1.5, "真实极差 / 百分位带 上限倍数", minval = 1.0,
     maxval = 5.0, step = 0.1, group = rangeGroup,
     tooltip = "仅在启用真实极差门禁时生效。")

upperPercentile = upperBoundaryStrength / 100.0
lowerPercentile = (100.0 - (symmetricBoundary ? upperBoundaryStrength : lowerBoundaryStrength)) /
     100.0

// 横盘最少 K 线数：候选长度取自固定数组 8/12/16/24/32/48/64/96，
// 低于该值的候选整体跳过，用于排除过短、形态不足的伪横盘。
minimumRangeBars = input.int(8, "横盘最少 K 线数", minval = 4, maxval = 96, step = 1,
     group = rangeGroup,
     tooltip = "只接受长度不小于该值的横盘候选。实际长度仍取自 8/12/16/24/32/48/64/96。")
// 百分位边界会忽略最高/最低的极值影线，导致突破棒收盘可能只越过被压低的边界，
// 却没碰到区间内真实出现过的插针高点。开启后要求突破棒收盘越过区间真实极值。
requireRawExtreme = input.bool(false, "突破需越过区间真实极值",
     group = rangeGroup,
     tooltip = "开启后：多头突破棒收盘需 > 区间内真实最高价，空头需 < 真实最低价，把插针算进去。")
rawExtremeBufferAtr = input.float(0.0, "真实极值突破缓冲（ATR 倍数）",
     minval = 0.0, maxval = 3.0, step = 0.1, group = rangeGroup,
     tooltip = "在真实极值之外再要求越过的距离，仅在上面开关开启时生效。")

// ---------- 止损与止盈 ----------
// 三项都会改变风险模型与出场语义，属研究参数，不是显示选项。
const string exitGroup = "止损与止盈"
minimumStopAtr = input.float(DEFAULT_MINIMUM_STOP_ATR, "最小止损（ATR 倍数）",
     minval = 0.1, maxval = 5.0, step = 0.1, group = exitGroup,
     tooltip = "结构止损过窄时，用该 ATR 倍数作为止损下限，避免风险过小被噪声扫掉。")
stopAtrExtra = input.float(0.0, "结构止损额外缓冲（ATR 倍数）",
     minval = 0.0, maxval = 3.0, step = 0.1, group = exitGroup,
     tooltip = "在突破棒极值之外再退让的距离，0 表示保持原口径（极值 ± 1 tick）。")
targetRangeMultiple = input.float(1.0, "止盈量度目标（区间高度倍数）",
     minval = 0.2, maxval = 5.0, step = 0.1, group = exitGroup,
     tooltip = "目标 = 被突破边界 ± 区间高度 × 该倍数。1.0 为原始等量度口径。")

// ---------- 突破棒强度 ----------
// 三项都改变入场判定：前两项收紧强突破定义，第三项排除“开盘从低位发起”的假强棒。
const string breakoutGroup = "突破棒"
breakoutMinBodyRatio = input.float(DEFAULT_BREAKOUT_MIN_BODY_RATIO, "最小实体占比",
     minval = 0.0, maxval = 1.0, step = 0.05, group = breakoutGroup,
     tooltip = "实体 |收-开| 占整根 高-低 的最小比例。越大越要求突破棒是饱满的单向棒。")
breakoutMinMoveRatio = input.float(DEFAULT_BREAKOUT_MIN_DIRECTIONAL_MOVE_RATIO * 100.0,
     "最小方向涨跌幅 %", minval = 0.0, maxval = 5.0, step = 0.05, group = breakoutGroup,
     tooltip = "多头 (收-开)/开、空头 (开-收)/开 的最小百分比。0.15 = 0.15%，原始口径。")
breakoutMinOpenPosition = input.float(0.0, "最小开盘位置", minval = 0.0, maxval = 1.0,
     step = 0.05, group = breakoutGroup,
     tooltip = "突破棒开盘在整根 [低,高] 中的相对位置下限（多头）。0=不限制；0.5=开盘须在中点以上，排除从低位拉起的假强棒。空头对称。")

const string displayGroup = "显示"
showZones = input.bool(true, "显示父区间、交易核心与局部子区间", group = displayGroup,
     tooltip = "浅蓝/青蓝双层为父 visual_parent/trade_core；橙黄双层为父内局部子区间。父、子突破都使用各自 trade_core，父事件始终优先。")
showRangeStartAndConfirmation = input.bool(true, "显示横盘起点与确认点", group = displayGroup,
     tooltip = "橙色标记是确认后向左回画的横盘起点；蓝色标记是真正完成确认的 K 线。只有蓝色确认点之后才能把该横盘用于判断。")
showRangeLifecycle = input.bool(false, "显示横盘生命周期", group = displayGroup)
showTradeMarkers = input.bool(true, "显示开仓与平仓点", group = displayGroup)
showSignalLifecycle = input.bool(true, "显示突破与确认过程点", group = displayGroup)
showSweepMarkers = input.bool(true, "显示扫高/扫低收回", group = displayGroup,
     tooltip = "最高/最低价短暂越过活动横盘边界、但收盘重新回到原区间时标记；只增加图表审计，不改变信号。")
showWeakDepartureMarkers = input.bool(true, "显示弱离区", group = displayGroup,
     tooltip = "收盘已经离开区间，但突破棒未通过当前实体与方向位移门槛时标记。")
showAuditText = input.bool(false, "标签内联完整审计文本（逐字段比对用）", group = displayGroup)
showTradeLevels = input.bool(true, "显示当前止损与目标", group = displayGroup)
labelOffsetAtr = input.float(1.2, "标签离 K 线间距（ATR 倍数）", minval = 0.0, maxval = 6.0,
     step = 0.1, group = displayGroup)
maximumVisibleZones = input.int(30, "最多保留区间", minval = 5, maxval = 60, group = displayGroup)

// Rust 与 Pine 均按最近秩定义 P90/P10 等稳健边界，孤立长影线不会单独决定区间。
f_percentile(source, startOffset, length, percentile) =>
    samples = array.new_float(0)
    for sampleIndex = 0 to length - 1
        array.push(samples, source[startOffset + sampleIndex])
    array.sort(samples)
    rank = int(math.max(0, math.min(length - 1, math.ceil(percentile * length) - 1)))
    array.get(samples, rank)

// 直接按排序后的零基索引取值，避免小窗口用浮点百分位表达“允许几根扫单影线”时出现离散歧义。
f_rank_value(source, startOffset, length, zeroBasedRank) =>
    samples = array.new_float(0)
    for sampleIndex = 0 to length - 1
        array.push(samples, source[startOffset + sampleIndex])
    array.sort(samples)
    safeRank = int(math.max(0, math.min(length - 1, zeroBasedRank)))
    array.get(samples, safeRank)

// 相邻贴边棒属于同一触碰组；间隔至少两根才计入新的独立触碰。
f_touch_groups(source, edge, band, length, upperEdge) =>
    groups = 0
    lastTouchIndex = int(na)
    for chronologicalIndex = 0 to length - 1
        offset = length - 1 - chronologicalIndex
        touches = upperEdge ? source[offset] >= edge - band : source[offset] <= edge + band
        if touches
            if na(lastTouchIndex) or chronologicalIndex - lastTouchIndex >= MINIMUM_TOUCH_GAP
                groups += 1
            lastTouchIndex := chronologicalIndex
    groups

// 收盘容纳率允许少数越界影线，但要求绝大多数收盘仍属于同一价格区域。
f_containment_ratio(upper, lower, band, length) =>
    contained = 0
    for offset = 0 to length - 1
        if close[offset] <= upper + band and close[offset] >= lower - band
            contained += 1
    contained / length

// 净收盘位移除以完整收盘路径；单边推进接近 1，反复往返接近 0。
f_direction_efficiency(length) =>
    pathLength = 0.0
    for chronologicalIndex = 1 to length - 1
        olderOffset = length - chronologicalIndex
        newerOffset = olderOffset - 1
        pathLength += math.abs(close[newerOffset] - close[olderOffset])
    netDisplacement = math.abs(close - close[length - 1])
    pathLength <= 0 ? 0.0 : netDisplacement / pathLength

// 仅统计能够从 OHLC 确认先后顺序的上下沿交替；同棒双扫不补造盘中路径。
f_edge_transition_count(upper, lower, length) =>
    edgeBand = math.max(syminfo.mintick * 2.0, (upper - lower) * TRANSITION_BAND_HEIGHT_RATIO)
    previousEdge = 0
    transitions = 0
    for chronologicalIndex = 0 to length - 1
        offset = length - 1 - chronologicalIndex
        touchesUpper = high[offset] >= upper - edgeBand
        touchesLower = low[offset] <= lower + edgeBand
        edge = touchesUpper and not touchesLower ? 1 : touchesLower and not touchesUpper ? -1 : 0
        if edge != 0
            if previousEdge != 0 and edge != previousEdge
                transitions += 1
            previousEdge := edge
    transitions

// 固定长度候选同时通过宽度、触碰、容纳、漂移、方向效率、交替次数与 V43 内部冲击门禁。
f_evaluate_range(length) =>
    upper = f_percentile(high, 0, length, upperPercentile)
    lower = f_percentile(low, 0, length, lowerPercentile)
    // 区间内真实极值（含插针），供突破门禁使用，不参与形态判定。
    rawHigh = high
    rawLow = low
    bodyUpper = math.max(open, close)
    bodyLower = math.min(open, close)
    maximumInternalBodyToRangeHeight = 0.0
    for offset = 0 to length - 1
        rawHigh := math.max(rawHigh, high[offset])
        rawLow := math.min(rawLow, low[offset])
        bodyUpper := math.max(bodyUpper, math.max(open[offset], close[offset]))
        bodyLower := math.min(bodyLower, math.min(open[offset], close[offset]))
    allowedSweepWicksPerSide = int(math.max(1, math.floor(length / 10.0)))
    wickUpper = f_rank_value(high, 0, length, length - allowedSweepWicksPerSide - 1)
    wickLower = f_rank_value(low, 0, length, allowedSweepWicksPerSide)
    // visual_parent 始终包含 trade_core；这两个值只能用于绘图，不能反向参与 valid。
    visualParentUpper = math.max(upper, math.max(wickUpper, bodyUpper))
    visualParentLower = math.min(lower, math.min(wickLower, bodyLower))
    visualParentMiddle = (visualParentUpper + visualParentLower) * 0.5
    upperHalfBodyCenters = 0
    for offset = 0 to length - 1
        bodyCenter = (open[offset] + close[offset]) * 0.5
        if bodyCenter >= visualParentMiddle
            upperHalfBodyCenters += 1
    lowerHalfBodyCenters = length - upperHalfBodyCenters
    dominantHalfRatio = math.max(upperHalfBodyCenters, lowerHalfBodyCenters) / length
    height = upper - lower
    middle = (upper + lower) * 0.5
    halfLength = int(math.floor(length * 0.5))
    recentLength = length - halfLength
    touchBand = math.max(syminfo.mintick * 2.0, height * TOUCH_BAND_HEIGHT_RATIO)
    upperTouchGroups = f_touch_groups(high, upper, touchBand, length, true)
    lowerTouchGroups = f_touch_groups(low, lower, touchBand, length, false)
    containmentRatio = f_containment_ratio(upper, lower, touchBand, length)
    recentUpper = f_percentile(high, 0, recentLength, 0.80)
    earlierUpper = f_percentile(high, recentLength, halfLength, 0.80)
    recentLower = f_percentile(low, 0, recentLength, 0.20)
    earlierLower = f_percentile(low, recentLength, halfLength, 0.20)
    upperDrift = height > 0 ? math.abs(recentUpper - earlierUpper) / height : 1.0
    lowerDrift = height > 0 ? math.abs(recentLower - earlierLower) / height : 1.0
    directionEfficiency = f_direction_efficiency(length)
    edgeTransitions = f_edge_transition_count(upper, lower, length)
    // 真实极差相对百分位带的膨胀倍数；height<=0 时置为极大值直接判非横盘。
    rawToBandRatio = height > 0 ? (rawHigh - rawLow) / height : 1e10
    // V43：实体达到核心高度 50% 后，仅当整根 High/Low 未完整包含在同一核心内才视为内部冲击。
    hasInternalBodyImpulse = false
    if height > 0
        for offset = 0 to length - 1
            internalBodyRatio = math.abs(close[offset] - open[offset]) / height
            maximumInternalBodyToRangeHeight := math.max(maximumInternalBodyToRangeHeight,
                 internalBodyRatio)
            fullyContained = high[offset] <= upper and low[offset] >= lower
            hasInternalBodyImpulse := hasInternalBodyImpulse or
                 (internalBodyRatio >= MAXIMUM_INTERNAL_BODY_TO_RANGE_HEIGHT and
                 (not EXEMPT_FULLY_CONTAINED_INTERNAL_BODY or not fullyContained))
    valid = height > 0 and middle > 0 and height / middle <= MAXIMUM_WIDTH_RATIO and
         upperTouchGroups >= 2 and lowerTouchGroups >= 2 and
         containmentRatio >= MINIMUM_CONTAINMENT_RATIO and upperDrift <= MAXIMUM_UPPER_DRIFT and
         lowerDrift <= MAXIMUM_LOWER_DRIFT and directionEfficiency <= MAXIMUM_DIRECTION_EFFICIENCY and
         edgeTransitions >= MINIMUM_EDGE_TRANSITIONS and
         not hasInternalBodyImpulse and
         (not enableRawRangeGuard or rawToBandRatio <= maximumRawToBandRatio)
    [valid, upper, lower, containmentRatio, directionEfficiency, edgeTransitions,
         upperTouchGroups, lowerTouchGroups, upperDrift, lowerDrift, rawHigh, rawLow,
         visualParentUpper, visualParentLower, dominantHalfRatio]

// 强突破棒判定：方向、实体占比、方向涨跌幅三重门槛，可选叠加开盘位置门槛。
// 开盘位置门槛排除“开盘落在整根靠下、靠拉升才收上去”的假强棒（多头需开盘在上部）。
f_breakout_strength(direction) =>
    fullRange = high - low
    bodyRatio = fullRange > 0 ? math.abs(close - open) / fullRange : 0.0
    directionalBody = direction == 1 ? close - open : open - close
    directionalMoveRatio = open > 0 ? directionalBody / open : 0.0
    // 开盘在整根 K 线的相对位置：多头取 (open-low)/fullRange，越接近 1 越靠上部；
    // 空头镜像取 (high-open)/fullRange。门槛为 0 时该项不生效，保持原口径。
    openPosition = fullRange > 0 ?
         (direction == 1 ? (open - low) / fullRange : (high - open) / fullRange) : 1.0
    openPositionOk = breakoutMinOpenPosition <= 0.0 or openPosition >= breakoutMinOpenPosition
    // input 以百分比录入，比较前换回小数。
    minMoveRatio = breakoutMinMoveRatio / 100.0
    [bodyRatio >= breakoutMinBodyRatio and
         directionalMoveRatio >= minMoveRatio and openPositionOk,
         bodyRatio, directionalMoveRatio]

// 价格向下对齐用于多头结构止损与多头目标。
f_round_down(price) =>
    math.floor(price / syminfo.mintick) * syminfo.mintick

// 价格向上对齐用于空头结构止损与空头目标。
f_round_up(price) =>
    math.ceil(price / syminfo.mintick) * syminfo.mintick

// 单调 OHLC 路径上的区间判定与 Rust broker emulator 保持开区间起点、闭区间终点语义。
f_between(level, startPrice, endPrice) =>
    endPrice >= startPrice ? level > startPrice and level <= endPrice :
         level < startPrice and level >= endPrice

// 返回单段路径最先触及的保护价：1=止损，2=目标，0=未触发。
f_segment_action(startPrice, endPrice, stopPrice, targetPrice) =>
    stopIn = f_between(stopPrice, startPrice, endPrice)
    targetIn = not na(targetPrice) and f_between(targetPrice, startPrice, endPrice)
    action = 0
    price = float(na)
    if stopIn and targetIn
        price := endPrice >= startPrice ? math.min(stopPrice, targetPrice) :
             math.max(stopPrice, targetPrice)
        action := math.abs(price - stopPrice) <= syminfo.mintick * 0.1 ? 1 : 2
    else if stopIn
        action := 1
        price := stopPrice
    else if targetIn
        action := 2
        price := targetPrice
    [action, price]

// 完整 K 线按 TradingView 默认“离开盘更近的一侧先走”路径返回首个固定保护动作。
f_protective_action(direction, stopPrice, targetPrice) =>
    action = 0
    price = float(na)
    stopMarketable = direction == 1 ? open <= stopPrice : open >= stopPrice
    targetMarketable = not na(targetPrice) and (direction == 1 ? open >= targetPrice : open <= targetPrice)
    if stopMarketable
        action := 1
        price := open
    else if targetMarketable
        action := 2
        price := open
    else
        highFirst = math.abs(open - high) < math.abs(open - low)
        path1 = highFirst ? high : low
        path2 = highFirst ? low : high
        [firstAction, firstPrice] = f_segment_action(open, path1, stopPrice, targetPrice)
        if firstAction != 0
            action := firstAction
            price := firstPrice
        else
            [secondAction, secondPrice] = f_segment_action(path1, path2, stopPrice, targetPrice)
            if secondAction != 0
                action := secondAction
                price := secondPrice
            else
                [thirdAction, thirdPrice] = f_segment_action(path2, close, stopPrice, targetPrice)
                action := thirdAction
                price := thirdPrice
    [action, price]

// 把 Unix 毫秒格式化成图表时区的年月日与时分，仅用于 tooltip 展示。
f_format_time(milliseconds) =>
    str.format("{0,number,0000}-{1,number,00}-{2,number,00} {3,number,00}:{4,number,00}",
         year(milliseconds), month(milliseconds), dayofmonth(milliseconds),
         hour(milliseconds), minute(milliseconds))

// 把 "字段名=13位毫秒" 改写成 "字段名=可读时间"，保持字段名不变以便后续词典映射。
// 逐字段定位而不是全局扫数字，避免误伤价格、ATR 等非时间字段。
// Pine 不支持字符串大小比较，故用 | 分隔符切出字段值，再用数量级判定是否为毫秒时间戳。
f_localize_time_field(source, fieldName) =>
    result = source
    keyPosition = str.pos(result, fieldName)
    if not na(keyPosition)
        valueStart = keyPosition + str.length(fieldName)
        tail = str.substring(result, valueStart)
        separatorOffset = str.pos(tail, "|")
        valueText = na(separatorOffset) ? tail : str.substring(tail, 0, separatorOffset)
        numericValue = str.tonumber(valueText)
        if not na(numericValue) and numericValue >= 1000000000000
            result := str.substring(result, 0, valueStart) + f_format_time(int(numericValue)) +
                 (na(separatorOffset) ? "" : str.substring(tail, separatorOffset))
    result

// 把机器可解析的单行审计串拆成多行中文 tooltip。
// 审计串本身保持英文原样以便与 Rust 候选账本逐字段比对，只在展示层做词典映射。
// 替换顺序有硬要求：含子串的长字段必须先替换，否则会被短字段误伤
// （struct_stop= 先于 stop=、entry_px= 先于 entry=、required_close= 先于 close= 等）。
f_audit_tooltip(auditText) =>
    // 先在仍带 | 分隔符时格式化时间：用 "|entry=" 定位可避免误配 "|entry_px="。
    timed = f_localize_time_field(auditText, "|breakout=")
    timed := f_localize_time_field(timed, "|departure=")
    timed := f_localize_time_field(timed, "|sweep=")
    timed := f_localize_time_field(timed, "|reset=")
    timed := f_localize_time_field(timed, "|range_start_time=")
    timed := f_localize_time_field(timed, "|signal=")
    timed := f_localize_time_field(timed, "|entry=")
    timed := f_localize_time_field(timed, "|exit=")
    zh = str.replace_all(timed, "|", "\n")
    zh := str.replace_all(zh, "V43_DIAG_CHILD_WEAK_DEPARTURE", "子区间弱离场（诊断样本）")
    zh := str.replace_all(zh, "V43_DIAG_CHILD_BREAKOUT", "子区间突破（诊断样本）")
    zh := str.replace_all(zh, "V43_DIAG_CHILD_SIGNAL", "子区间确认信号（诊断样本）")
    zh := str.replace_all(zh, "V43_DIAG_INTERNAL_IMPULSE_RESET", "内部冲击重置（诊断样本）")
    zh := str.replace_all(zh, "V43_DIAG_DOUBLE_SWEEP_RETURN", "双向扫区收回（诊断样本）")
    zh := str.replace_all(zh, "V43_DIAG_SWEEP_HIGH_RETURN", "扫高收回（诊断样本）")
    zh := str.replace_all(zh, "V43_DIAG_SWEEP_LOW_RETURN", "扫低收回（诊断样本）")
    zh := str.replace_all(zh, "V43_DIAG_WEAK_DEPARTURE", "弱离场（诊断样本）")
    zh := str.replace_all(zh, "V43_DIAG_BREAKOUT", "突破（诊断样本）")
    zh := str.replace_all(zh, "V43_DIAG_SIGNAL", "确认信号（诊断样本）")
    zh := str.replace_all(zh, "V43_DIAG_ENTRY", "开仓（诊断样本）")
    zh := str.replace_all(zh, "V43_DIAG_EXIT", "平仓（诊断样本）")
    zh := str.replace_all(zh, "V43_DIAG_BLOCK", "已阻塞（诊断样本）")
    zh := str.replace_all(zh, "V43_CHILD_WEAK_DEPARTURE", "子区间弱离场")
    zh := str.replace_all(zh, "V43_CHILD_BREAKOUT", "子区间突破")
    zh := str.replace_all(zh, "V43_CHILD_SIGNAL", "子区间确认信号")
    zh := str.replace_all(zh, "V43_INTERNAL_IMPULSE_RESET", "内部冲击重置")
    zh := str.replace_all(zh, "V43_DOUBLE_SWEEP_RETURN", "双向扫区收回")
    zh := str.replace_all(zh, "V43_SWEEP_HIGH_RETURN", "扫高收回")
    zh := str.replace_all(zh, "V43_SWEEP_LOW_RETURN", "扫低收回")
    zh := str.replace_all(zh, "V43_WEAK_DEPARTURE", "弱离场")
    zh := str.replace_all(zh, "V43_BREAKOUT", "突破")
    zh := str.replace_all(zh, "V43_SIGNAL", "确认信号")
