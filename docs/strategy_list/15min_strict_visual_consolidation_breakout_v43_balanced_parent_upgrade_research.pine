var float childPendingRangeLower = na
var int childPendingBreakoutIndex = na
var int childPendingBreakoutTime = na
var float childPendingRetestBand = na
var float childPendingRequiredClose = na
var float childPendingMinimumRetentionClose = na
var float childPendingStructuralStop = na
var float childPendingMeasuredTarget = na

var array<box> storedBoxes = array.new_box(0)
var array<box> storedCoreBoxes = array.new_box(0)
var array<line> storedUpperLines = array.new_line(0)
var array<line> storedLowerLines = array.new_line(0)
var array<label> storedRangeStartLabels = array.new_label(0)
var array<label> storedRangeConfirmationLabels = array.new_label(0)
var array<box> storedChildVisualBoxes = array.new_box(0)
var array<box> storedChildCoreBoxes = array.new_box(0)
var array<line> storedChildUpperLines = array.new_line(0)
var array<line> storedChildLowerLines = array.new_line(0)
var array<label> storedChildStartLabels = array.new_label(0)
var array<label> storedChildConfirmationLabels = array.new_label(0)

var int rangeConfirmedCount = 0
var int rangeUpgradedCount = 0
var int weakReturnedCount = 0
var int weakConsumedCount = 0
var int internalImpulseResetCount = 0
var int strongBreakoutCount = 0
var int armedCount = 0
var int acceptanceConfirmedCount = 0
var int acceptanceInvalidatedCount = 0
var int acceptanceExpiredCount = 0
var int childRangeConfirmedCount = 0
var int childRangeUpgradedCount = 0
var int childWeakReturnedCount = 0
var int childWeakConsumedCount = 0
var int childInternalImpulseResetCount = 0
var int childStrongBreakoutCount = 0
var int childArmedCount = 0
var int childSignalCount = 0

// 冻结旧区间图形；离区棒本身不计入横盘右边界。
f_close_active_range(finalIndex) =>
    if not na(activeBox)
        finalRight = math.max(activeStartIndex, finalIndex)
        box.set_right(activeBox, finalRight)
        box.set_right(activeCoreBox, finalRight)
        line.set_x2(activeUpperLine, finalRight)
        line.set_x2(activeLowerLine, finalRight)

f_close_child_range(finalIndex) =>
    if not na(childVisualBox)
        finalRight = math.max(childStartIndex, finalIndex)
        box.set_right(childVisualBox, finalRight)
        box.set_right(childCoreBox, finalRight)
        line.set_x2(childUpperLine, finalRight)
        line.set_x2(childLowerLine, finalRight)

// ---------- 下一开盘手工账本 ----------

var bool entryPending = false
var int entryDirection = 0
var int entryRangeStartIndex = na
var int entryRangeLength = na
var int entryBreakoutTime = na
var int entrySignalTime = na
var float entrySignalAtr = na
var float entryStructuralStop = na
var float entryFrozenTarget = na
// 追高诊断：记录入场时被突破的那条边界，用于度量入场价离横盘区间多远。
var float entryBrokenBoundary = na
var int chaseBucket0 = 0      // 偏离 < 0.5 ATR
var int chaseBucket1 = 0      // 0.5 ~ 1.0 ATR
var int chaseBucket2 = 0      // 1.0 ~ 2.0 ATR
var int chaseBucket3 = 0      // >= 2.0 ATR，视为明显追高
var float chaseAtrSum = 0.0
var float chaseAtrMax = 0.0

var bool tradeActive = false
var int tradeDirection = 0
var int tradeBreakoutTime = na
var int tradeSignalTime = na
var int tradeEntryTime = na
var float tradeEntryPrice = na
var float tradeStopPrice = na
var float tradeTargetPrice = na
var float tradeInitialRisk = na

var int signalCount = 0
var int filledTradeCount = 0
var int closedTradeCount = 0
var int stopExitCount = 0
var int targetExitCount = 0
var int reverseExitCount = 0
var int invalidStructureCount = 0
var int targetPassedAtEntryCount = 0
var float cumulativeGrossR = 0.0
var float cumulativeNetR = 0.0

// 以入场时冻结的初始风险为 R，成本按实际入场与退出名义金额双边扣除。
f_trade_result(exitPrice) =>
    grossR = tradeDirection == 1 ? (exitPrice - tradeEntryPrice) / tradeInitialRisk :
         (tradeEntryPrice - exitPrice) / tradeInitialRisk
    // 成本只改变净 R：入场名义金额扣 maker+滑点，退出名义金额扣 taker+滑点。
    costR = (tradeEntryPrice * (MAKER_COST_RATE_PER_SIDE + SLIPPAGE_COST_RATE_PER_SIDE) +
         exitPrice * (TAKER_COST_RATE_PER_SIDE + SLIPPAGE_COST_RATE_PER_SIDE)) / tradeInitialRisk
    [grossR, costR, grossR - costR]

// 1=父确认，2=父升级，3=父弱离，4=父弱离回区，5=父弱离消费，6=父强突破，7=父内部冲击重置。
parentLifecycleEvent = 0

if processBar
    // Rust 在确认后的下一根实际开盘先处理待成交意图，再处理该根完整 OHLC 的保护单。
    if entryPending and time > entrySignalTime and time <= EVALUATION_END_MS
        structureValid = entryDirection == 1 ? entryStructuralStop < open : entryStructuralStop > open
        if not structureValid
            invalidStructureCount += 1
            f_audit_label(time, open, "已阻塞",
                 auditPrefix + "_BLOCK|reason=structure_invalid_at_entry|dir=" +
                 (entryDirection == 1 ? "long" : "short") + "|signal=" +
                 str.tostring(entrySignalTime) + "|open=" + f_price(open) + "|struct_stop=" +
                 f_price(entryStructuralStop), entryDirection == 1 ? label.style_label_down :
                 label.style_label_up, color.new(color.red, 0), showSignalLifecycle)
        else
            if tradeActive
                [reverseGrossR, reverseCostR, reverseNetR] = f_trade_result(open)
                cumulativeGrossR += reverseGrossR
                cumulativeNetR += reverseNetR
                closedTradeCount += 1
                reverseExitCount += 1
                f_audit_label(time, open, "反手平 " + f_r(reverseNetR) + "R",
                     auditPrefix + "_EXIT|reason=reverse_next_open|dir=" +
                     (tradeDirection == 1 ? "long" : "short") + "|entry=" +
                     str.tostring(tradeEntryTime) + "|exit=" + str.tostring(time) +
                     "|exit_px=" + f_price(open) + "|gross_r=" + f_price(reverseGrossR) +
                     "|cost_r=" + f_price(reverseCostR) + "|net_r=" + f_price(reverseNetR),
                     tradeDirection == 1 ? label.style_label_down : label.style_label_up,
                     color.new(color.orange, 0), showTradeMarkers)
            minimumRiskTicks = int(math.max(1.0,
                 math.ceil(minimumStopAtr * entrySignalAtr / syminfo.mintick)))
            atrFloorStop = entryDirection == 1 ? open - minimumRiskTicks * syminfo.mintick :
                 open + minimumRiskTicks * syminfo.mintick
            finalStop = entryDirection == 1 ? math.min(entryStructuralStop, atrFloorStop) :
                 math.max(entryStructuralStop, atrFloorStop)
            finalTarget = entryDirection == 1 ? f_round_down(entryFrozenTarget) :
                 f_round_up(entryFrozenTarget)
            tradeActive := true
            tradeDirection := entryDirection
            tradeBreakoutTime := entryBreakoutTime
            tradeSignalTime := entrySignalTime
            tradeEntryTime := time
            tradeEntryPrice := open
            tradeStopPrice := finalStop
            tradeTargetPrice := finalTarget
            tradeInitialRisk := math.abs(open - finalStop)
            filledTradeCount += 1
            // 信号棒已经提交下一开盘的镜像市价单；成交棒收盘后用真实开盘重算并刷新保护价。
            // 若入场棒内已经触发预挂保护单，TradingView 会先按其 broker emulator 结束该笔。
            reportEntryId = entryDirection == 1 ? TV_LONG_ENTRY_ID : TV_SHORT_ENTRY_ID
            reportExitId = entryDirection == 1 ? TV_LONG_EXIT_ID : TV_SHORT_EXIT_ID
            strategy.exit(reportExitId, from_entry = reportEntryId, stop = finalStop,
                 limit = finalTarget, comment = "V43 止损/止盈")
            targetAlreadyPassed = entryDirection == 1 ? open >= finalTarget : open <= finalTarget
            targetPassedAtEntryCount += targetAlreadyPassed ? 1 : 0
            // 追高幅度：入场价越过被突破边界的距离，按信号棒 ATR14 归一化。
            chaseAtr = entrySignalAtr > 0 ?
                 (entryDirection == 1 ? open - entryBrokenBoundary :
                 entryBrokenBoundary - open) / entrySignalAtr : 0.0
            chaseAtrSum += chaseAtr
            chaseAtrMax := math.max(chaseAtrMax, chaseAtr)
            chaseBucket0 += chaseAtr < 0.5 ? 1 : 0
            chaseBucket1 += chaseAtr >= 0.5 and chaseAtr < 1.0 ? 1 : 0
            chaseBucket2 += chaseAtr >= 1.0 and chaseAtr < 2.0 ? 1 : 0
            chaseBucket3 += chaseAtr >= 2.0 ? 1 : 0
            f_audit_label(time, open,
                 (entryDirection == 1 ? "▲ 多" : "▼ 空") + " " + f_r(open),
                 auditPrefix + "_ENTRY|dir=" +
                 (entryDirection == 1 ? "long" : "short") + "|range_start=" +
                 str.tostring(entryRangeStartIndex) + "|range_len=" + str.tostring(entryRangeLength) +
                 "|breakout=" + str.tostring(entryBreakoutTime) + "|signal=" +
                 str.tostring(entrySignalTime) + "|entry=" + str.tostring(time) +
                 "|entry_px=" + f_price(open) + "|struct_stop=" + f_price(entryStructuralStop) +
                 "|stop=" + f_price(finalStop) + "|target=" + f_price(finalTarget) +
                 "|atr14=" + f_price(entrySignalAtr) + "|risk_atr=" +
                 f_price(tradeInitialRisk / entrySignalAtr) + "|boundary=" +
                 f_price(entryBrokenBoundary) + "|chase_atr=" + f_price(chaseAtr) +
                 "|target_passed=" + (targetAlreadyPassed ? "true" : "false"),
                 entryDirection == 1 ? label.style_label_up : label.style_label_down,
                 color.new(color.blue, 0), showTradeMarkers)
        entryPending := false

    if tradeActive
        [protectiveAction, protectivePrice] =
             f_protective_action(tradeDirection, tradeStopPrice, tradeTargetPrice)
        if protectiveAction != 0
            [exitGrossR, exitCostR, exitNetR] = f_trade_result(protectivePrice)
            cumulativeGrossR += exitGrossR
            cumulativeNetR += exitNetR
            closedTradeCount += 1
            stopExitCount += protectiveAction == 1 ? 1 : 0
            targetExitCount += protectiveAction == 2 ? 1 : 0
            exitReason = protectiveAction == 1 ? "stop_loss" : "take_profit"
            f_audit_label(time, protectivePrice,
                 (protectiveAction == 1 ? "✕ 止损 " : "✓ 止盈 ") + f_r(exitNetR) + "R",
                 auditPrefix + "_EXIT|reason=" + exitReason +
                 "|dir=" + (tradeDirection == 1 ? "long" : "short") + "|entry=" +
                 str.tostring(tradeEntryTime) + "|exit=" + str.tostring(time) +
                 "|exit_px=" + f_price(protectivePrice) + "|gross_r=" + f_price(exitGrossR) +
                 "|cost_r=" + f_price(exitCostR) + "|net_r=" + f_price(exitNetR),
                 tradeDirection == 1 ? label.style_label_down : label.style_label_up,
                 protectiveAction == 1 ? color.new(color.red, 0) : color.new(color.green, 0),
                 showTradeMarkers)
            tradeActive := false

    // 有待确认突破时，本棒只处理旧来源；不得同时修改或重建横盘状态。
    handledByAcceptance = false
    if acceptancePending
        handledByAcceptance := true
        age = bar_index - pendingBreakoutIndex
        invalidated = pendingDirection == 1 ? close <= pendingRangeUpper : close >= pendingRangeLower
        touchedBoundary = pendingDirection == 1 ?
             low <= pendingRangeUpper + pendingRetestBand :
             high >= pendingRangeLower - pendingRetestBand
        retainedBreakout = pendingDirection == 1 ?
             close >= pendingRequiredClose : close <= pendingRequiredClose
        acceptedByRetest = age >= 1 and age <= ACCEPTANCE_WINDOW_BARS and
             not invalidated and touchedBoundary and retainedBreakout
        // V43 沿用 V23 的 75% 保留门；低于该价只继续等待，不提前消费尚未过期的突破来源。
        acceptanceRetentionPassed = pendingDirection == 1 ?
             close >= pendingMinimumRetentionClose : close <= pendingMinimumRetentionClose
        accepted = acceptedByRetest and acceptanceRetentionPassed
        if accepted
            acceptancePending := false
            acceptanceConfirmedCount += 1
            if time >= EVALUATION_START_MS and time <= EVALUATION_END_MS
                signalCount += 1
                f_audit_label(time, close, "信号",
                     auditPrefix + "_SIGNAL|dir=" +
                     (pendingDirection == 1 ? "long" : "short") + "|range_start=" +
                     str.tostring(pendingRangeStartIndex) + "|range_len=" +
                     str.tostring(pendingRangeLength) + "|upper=" + f_price(pendingRangeUpper) +
                     "|lower=" + f_price(pendingRangeLower) + "|breakout=" +
                     str.tostring(pendingBreakoutTime) + "|signal=" + str.tostring(time) +
                     "|age=" + str.tostring(age) + "|close=" + f_price(close) +
                     "|required_close=" + f_price(pendingRequiredClose) +
                     "|retention75_close=" + f_price(pendingMinimumRetentionClose) + "|atr14=" +
                     f_price(atr14) + "|struct_stop=" + f_price(pendingStructuralStop) +
                     "|target=" + f_price(pendingMeasuredTarget),
                     pendingDirection == 1 ? label.style_label_up : label.style_label_down,
                     color.new(color.purple, 0), showSignalLifecycle)
                entryPending := true
                entryDirection := pendingDirection
                entryRangeStartIndex := pendingRangeStartIndex
                entryRangeLength := pendingRangeLength
                entryBreakoutTime := pendingBreakoutTime
                entrySignalTime := time
                entrySignalAtr := atr14
                entryStructuralStop := pendingStructuralStop
                entryFrozenTarget := pendingMeasuredTarget
                entryBrokenBoundary := pendingDirection == 1 ? pendingRangeUpper :
                     pendingRangeLower
                // TradingView 默认在下一根开盘成交，和手工账本时序一致。保护单必须在信号棒同时预挂，
                // 才能覆盖入场棒内的止损/目标；连续市场的下一开盘通常等于本棒收盘，故以 close
                // 预估 ATR 止损下限，成交棒收盘后再由手工账本的真实 open 刷新。
                reportMinimumRiskTicks = int(math.max(1.0,
                     math.ceil(minimumStopAtr * atr14 / syminfo.mintick)))
                reportAtrFloorStop = pendingDirection == 1 ?
                     close - reportMinimumRiskTicks * syminfo.mintick :
                     close + reportMinimumRiskTicks * syminfo.mintick
                reportStop = pendingDirection == 1 ?
                     math.min(pendingStructuralStop, reportAtrFloorStop) :
                     math.max(pendingStructuralStop, reportAtrFloorStop)
                reportTarget = pendingDirection == 1 ? f_round_down(pendingMeasuredTarget) :
                     f_round_up(pendingMeasuredTarget)
                reportEntryId = pendingDirection == 1 ? TV_LONG_ENTRY_ID : TV_SHORT_ENTRY_ID
                reportExitId = pendingDirection == 1 ? TV_LONG_EXIT_ID : TV_SHORT_EXIT_ID
                reportRiskPerUnit = math.abs(close - reportStop)
                reportQuantity = reportRiskPerUnit > syminfo.mintick * 0.1 ?
                     strategy.initial_capital * 0.01 / reportRiskPerUnit : na
                if not na(reportQuantity)
                    strategy.cancel_all()
                    if strategy.position_size > 0
                        strategy.close(TV_LONG_ENTRY_ID, comment = "V43 下一开盘换仓")
                    else if strategy.position_size < 0
                        strategy.close(TV_SHORT_ENTRY_ID, comment = "V43 下一开盘换仓")
                    strategy.entry(reportEntryId,
                         pendingDirection == 1 ? strategy.long : strategy.short,
                         qty = reportQuantity,
                         comment = pendingDirection == 1 ? "V43 多" : "V43 空")
                    strategy.exit(reportExitId, from_entry = reportEntryId, stop = reportStop,
                         limit = reportTarget, comment = "V43 止损/止盈")
        else if invalidated
            acceptancePending := false
            acceptanceInvalidatedCount += 1
        else if age >= ACCEPTANCE_WINDOW_BARS
            acceptancePending := false
            acceptanceExpiredCount += 1

    if not handledByAcceptance
        // 弱离区只由紧邻下一根完成棒决定恢复或消费；该确认棒不再补算新锚点。
        handledByWeakDeparture = false
        if weakDeparturePending
            handledByWeakDeparture := true
            returnedInside = close >= activeLower and close <= activeUpper
            if returnedInside
                weakReturnedCount += 1
                parentLifecycleEvent := 4
                weakDeparturePending := false
                if not na(activeBox)
                    box.set_right(activeBox, bar_index)
                    box.set_right(activeCoreBox, bar_index)
                    line.set_x2(activeUpperLine, bar_index)
                    line.set_x2(activeLowerLine, bar_index)
            else
                weakConsumedCount += 1
                parentLifecycleEvent := 5
                f_close_active_range(weakDepartureIndex - 1)
                lastClosedIndex := weakDepartureIndex
                activeRange := false
                weakDeparturePending := false
                activeStartIndex := na
                activeFirstConfirmationIndex := na
                activeLength := na
                activeUpper := na
                activeLower := na
                activeRawHigh := na
                activeRawLow := na
                activeVisualUpper := na
                activeVisualLower := na
                activeBox := na
                activeCoreBox := na
                activeUpperLine := na
                activeLowerLine := na
                activeStartLabel := na
                activeConfirmationLabel := na

        if not handledByWeakDeparture
            if activeRange
                closedAbove = close > activeUpper
                closedBelow = close < activeLower
                if closedAbove or closedBelow
                    breakDirection = closedAbove ? 1 : -1
                    [rawBreakStrong, bodyRatio, directionalMoveRatio] =
                         f_breakout_strength(breakDirection)
                    // 真实极值门禁：突破棒收盘需越过区间内真实极值（含插针）+ ATR 缓冲。
                    rawBuffer = na(atr14) ? 0.0 : atr14 * rawExtremeBufferAtr
                    rawExtremeOk = not requireRawExtreme or (breakDirection == 1 ?
                         close > activeRawHigh + rawBuffer : close < activeRawLow - rawBuffer)
                    strongBreak = rawBreakStrong and rawExtremeOk
                    if not strongBreak
                        weakDeparturePending := true
                        weakDepartureIndex := bar_index
                        parentLifecycleEvent := 3
                        f_audit_label(time, breakDirection == 1 ? high : low, "弱离场",
                             auditPrefix + "_WEAK_DEPARTURE|dir=" +
                             (breakDirection == 1 ? "up" : "down") + "|departure=" +
                             str.tostring(time) + "|range_start_time=" +
                             str.tostring(time[bar_index - activeStartIndex]) + "|range_start=" +
                             str.tostring(activeStartIndex) + "|range_len=" +
                             str.tostring(activeLength) + "|upper=" + f_price(activeUpper) +
                             "|lower=" + f_price(activeLower) + "|open=" + f_price(open) +
                             "|high=" + f_price(high) + "|low=" + f_price(low) + "|close=" +
                             f_price(close) + "|body_ratio=" + f_price(bodyRatio) +
                             "|move_ratio=" + f_price(directionalMoveRatio),
                             breakDirection == 1 ? label.style_label_down :
                             label.style_label_up, color.new(color.gray, 20),
                             showWeakDepartureMarkers or showRangeLifecycle)
                    else
                        strongBreakoutCount += 1
                        parentLifecycleEvent := 6
                        f_close_active_range(bar_index - 1)
                        frozenStart = activeStartIndex
                        frozenLength = activeLength
                        frozenUpper = activeUpper
                        frozenLower = activeLower
                        activeRange := false
                        lastClosedIndex := bar_index
                        activeStartIndex := na
                        activeFirstConfirmationIndex := na
                        activeLength := na
                        activeUpper := na
                        activeLower := na
                        activeRawHigh := na
                        activeRawLow := na
                        activeVisualUpper := na
                        activeVisualLower := na
                        activeBox := na
                        activeCoreBox := na
                        activeUpperLine := na
                        activeLowerLine := na
                        activeStartLabel := na
                        activeConfirmationLabel := na
                        if atr14 > 0
                            boundary = breakDirection == 1 ? frozenUpper : frozenLower
                            breakoutExcess = breakDirection == 1 ? close - boundary : boundary - close
                            retainedExcess = math.max(syminfo.mintick,
                                 breakoutExcess * RETAINED_BREAKOUT_EXCESS_RATIO)
                            // V43 多空完全镜像，不再继承 V22 的三道空头附加门。
                            acceptancePending := true
                            pendingDirection := breakDirection
                            pendingRangeStartIndex := frozenStart
                            pendingRangeLength := frozenLength
                            pendingRangeUpper := frozenUpper
                            pendingRangeLower := frozenLower
                            pendingBreakoutIndex := bar_index
                            pendingBreakoutTime := time
                            pendingRetestBand := math.max(math.abs(boundary) * RETEST_BAND_PRICE_RATIO,
                                 atr14 * RETEST_BAND_ATR_RATIO)
                            pendingRequiredClose := breakDirection == 1 ?
                                 boundary + retainedExcess : boundary - retainedExcess
                            minimumRetainedExcess = breakoutExcess * MINIMUM_ACCEPTANCE_RETENTION_RATIO
                            pendingMinimumRetentionClose := breakDirection == 1 ?
                                 boundary + minimumRetainedExcess : boundary - minimumRetainedExcess
                            stopBuffer = syminfo.mintick + atr14 * stopAtrExtra
                            pendingStructuralStop := breakDirection == 1 ?
                                 f_round_down(low - stopBuffer) :
                                 f_round_up(high + stopBuffer)
                            rangeHeight = (frozenUpper - frozenLower) * targetRangeMultiple
                            pendingMeasuredTarget := breakDirection == 1 ?
                                 frozenUpper + rangeHeight : frozenLower - rangeHeight
                            armedCount += 1
                            f_audit_label(time, breakDirection == 1 ? high : low, "突破",
                                 auditPrefix + "_BREAKOUT|dir=" +
                                 (breakDirection == 1 ? "long" : "short") + "|range_start=" +
                                 str.tostring(frozenStart) + "|range_len=" + str.tostring(frozenLength) +
                                 "|upper=" + f_price(frozenUpper) + "|lower=" + f_price(frozenLower) +
                                 "|breakout=" + str.tostring(time) + "|close=" + f_price(close) +
                                 "|body_ratio=" + f_price(bodyRatio) + "|move_ratio=" +
                                 f_price(directionalMoveRatio) + "|required_close=" +
                                 f_price(pendingRequiredClose) + "|retention75_close=" +
                                 f_price(pendingMinimumRetentionClose) + "|retest_band=" +
                                 f_price(pendingRetestBand) + "|struct_stop=" +
                                 f_price(pendingStructuralStop) + "|target=" +
                                 f_price(pendingMeasuredTarget),
                                 breakDirection == 1 ? label.style_label_down : label.style_label_up,
                                 color.new(color.orange, 0), showSignalLifecycle)
                else
                    sweptUpperAndReturned = high > activeUpper and close >= activeLower and
                         close <= activeUpper
                    sweptLowerAndReturned = low < activeLower and close >= activeLower and
                         close <= activeUpper
                    if sweptUpperAndReturned and sweptLowerAndReturned
                        f_audit_label(time, high, "双扫收回",
                             auditPrefix + "_DOUBLE_SWEEP_RETURN|sweep=" + str.tostring(time) +
                             "|range_start_time=" +
                             str.tostring(time[bar_index - activeStartIndex]) + "|range_start=" +
                             str.tostring(activeStartIndex) + "|range_len=" +
                             str.tostring(activeLength) + "|upper=" + f_price(activeUpper) +
                             "|lower=" + f_price(activeLower) + "|high=" + f_price(high) +
                             "|low=" + f_price(low) + "|close=" + f_price(close),
                             label.style_label_down, color.new(color.blue, 10), showSweepMarkers)
                    else if sweptUpperAndReturned
                        f_audit_label(time, high, "扫高收回",
                             auditPrefix + "_SWEEP_HIGH_RETURN|sweep=" + str.tostring(time) +
                             "|range_start_time=" +
                             str.tostring(time[bar_index - activeStartIndex]) + "|range_start=" +
                             str.tostring(activeStartIndex) + "|range_len=" +
                             str.tostring(activeLength) + "|upper=" + f_price(activeUpper) +
                             "|lower=" + f_price(activeLower) + "|high=" + f_price(high) +
                             "|close=" + f_price(close), label.style_label_down,
                             color.new(color.orange, 5), showSweepMarkers)
                    else if sweptLowerAndReturned
                        f_audit_label(time, low, "扫低收回",
                             auditPrefix + "_SWEEP_LOW_RETURN|sweep=" + str.tostring(time) +
                             "|range_start_time=" +
                             str.tostring(time[bar_index - activeStartIndex]) + "|range_start=" +
                             str.tostring(activeStartIndex) + "|range_len=" +
                             str.tostring(activeLength) + "|upper=" + f_price(activeUpper) +
                             "|lower=" + f_price(activeLower) + "|low=" + f_price(low) +
                             "|close=" + f_price(close), label.style_label_up,
                             color.new(color.teal, 5), showSweepMarkers)
                    activeHeight = activeUpper - activeLower
                    internalBodyToRangeHeight = activeHeight > 0 ?
                         math.abs(close - open) / activeHeight : 1e10
                    internalImpulseFullyContained = high <= activeUpper and low >= activeLower
                    internalImpulse = internalBodyToRangeHeight >=
                         MAXIMUM_INTERNAL_BODY_TO_RANGE_HEIGHT and
                         (not EXEMPT_FULLY_CONTAINED_INTERNAL_BODY or
                         not internalImpulseFullyContained)
                    if internalImpulse
                        // 冲击棒只负责消费旧横盘；它本身不能成为下一段新横盘的第一根。
                        f_close_active_range(bar_index - 1)
                        lastClosedIndex := bar_index
                        internalImpulseResetCount += 1
                        parentLifecycleEvent := 7
                        f_audit_label(time, close, "内部冲击重置",
                             auditPrefix + "_INTERNAL_IMPULSE_RESET|reset=" + str.tostring(time) +
                             "|range_start_time=" +
                             str.tostring(time[bar_index - activeStartIndex]) + "|range_start=" +
                             str.tostring(activeStartIndex) + "|range_len=" +
                             str.tostring(activeLength) + "|upper=" + f_price(activeUpper) +
                             "|lower=" + f_price(activeLower) + "|body_to_range_height=" +
                             f_price(internalBodyToRangeHeight), close >= open ?
                             label.style_label_down : label.style_label_up,
                             color.new(color.gray, 5), showRangeLifecycle)
                        activeRange := false
                        activeStartIndex := na
                        activeFirstConfirmationIndex := na
                        activeLength := na
                        activeUpper := na
                        activeLower := na
                        activeRawHigh := na
                        activeRawLow := na
                        activeVisualUpper := na
                        activeVisualLower := na
                        activeBox := na
                        activeCoreBox := na
                        activeUpperLine := na
                        activeLowerLine := na
                        activeStartLabel := na
                        activeConfirmationLabel := na
                    else
                        candidateStart = selectedAnyValid ? bar_index - selectedAnyLength + 1 : bar_index
                        overlapsActive = selectedAnyValid and selectedAnyUpper >= activeLower and
                             selectedAnyLower <= activeUpper
                        proposesParentUpgrade = overlapsActive and candidateStart < activeStartIndex
                        balancedParentUpgrade = selectedAnyDominantHalfRatio <=
                             MAXIMUM_PARENT_UPGRADE_DOMINANT_HALF_RATIO
                        upgradesParent = proposesParentUpgrade and balancedParentUpgrade
                        if proposesParentUpgrade and not balancedParentUpgrade
                            unbalancedParentUpgradeRejectedCount += 1
                        if upgradesParent
                            activeStartIndex := candidateStart
                            activeLength := selectedAnyLength
                            activeUpper := selectedAnyUpper
                            activeLower := selectedAnyLower
                            activeRawHigh := selectedAnyRawHigh
                            activeRawLow := selectedAnyRawLow
                            activeVisualUpper := selectedAnyVisualUpper
                            activeVisualLower := selectedAnyVisualLower
                            rangeUpgradedCount += 1
                            parentLifecycleEvent := 2
                            if not na(activeStartLabel)
                                label.set_xy(activeStartLabel, activeStartIndex, activeVisualLower)
                            if not na(activeConfirmationLabel)
                                label.set_y(activeConfirmationLabel, activeVisualUpper)
                                label.set_text(activeConfirmationLabel,
                                     "横盘确认\n" + str.tostring(activeLength) + "根父区间")
                        if not na(activeBox)
                            box.set_lefttop(activeBox, activeStartIndex, activeVisualUpper)
                            box.set_rightbottom(activeBox, bar_index, activeVisualLower)
                            box.set_lefttop(activeCoreBox, activeStartIndex, activeUpper)
                            box.set_rightbottom(activeCoreBox, bar_index, activeLower)
                            line.set_xy1(activeUpperLine, activeStartIndex, activeUpper)
                            line.set_xy2(activeUpperLine, bar_index, activeUpper)
                            line.set_xy1(activeLowerLine, activeStartIndex, activeLower)
                            line.set_xy2(activeLowerLine, bar_index, activeLower)
            else if selectedFreshValid
                activeRange := true
                activeStartIndex := bar_index - selectedFreshLength + 1
                activeFirstConfirmationIndex := bar_index
                activeLength := selectedFreshLength
                activeUpper := selectedFreshUpper
                activeLower := selectedFreshLower
                activeRawHigh := selectedFreshRawHigh
                activeRawLow := selectedFreshRawLow
                activeVisualUpper := selectedFreshVisualUpper
                activeVisualLower := selectedFreshVisualLower
                rangeConfirmedCount += 1
                parentLifecycleEvent := 1
                if showZones
                    activeBox := box.new(activeStartIndex, activeVisualUpper, bar_index,
                         activeVisualLower,
                         xloc = xloc.bar_index, border_color = color.new(color.blue, 40),
                         border_style = line.style_solid, bgcolor = color.new(color.blue, 91))
                    activeCoreBox := box.new(activeStartIndex, activeUpper, bar_index, activeLower,
                         xloc = xloc.bar_index, border_color = color.new(color.aqua, 35),
                         border_style = line.style_dotted, bgcolor = color.new(color.aqua, 83))
                    activeUpperLine := line.new(activeStartIndex, activeUpper, bar_index, activeUpper,
                         xloc = xloc.bar_index, color = color.new(color.red, 5),
                         style = line.style_dashed)
                    activeLowerLine := line.new(activeStartIndex, activeLower, bar_index, activeLower,
                         xloc = xloc.bar_index, color = color.new(color.lime, 5),
                         style = line.style_dashed)
                    array.push(storedBoxes, activeBox)
                    array.push(storedCoreBoxes, activeCoreBox)
                    array.push(storedUpperLines, activeUpperLine)
                    array.push(storedLowerLines, activeLowerLine)
                    if array.size(storedBoxes) > maximumVisibleZones
                        box.delete(array.shift(storedBoxes))
                        box.delete(array.shift(storedCoreBoxes))
                        line.delete(array.shift(storedUpperLines))
                        line.delete(array.shift(storedLowerLines))
                activeStartLabel := (showRangeStartAndConfirmation or showRangeLifecycle) ?
                     label.new(activeStartIndex, activeVisualLower, "横盘起点\n确认后回画",
                          xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up,
                          color = color.new(color.orange, 10), textcolor = color.white,
                          size = size.tiny,
                          tooltip = "这是首次确认后向左回画的形态起点。\n该历史位置当时尚不可用于交易判断；请以右侧蓝色“横盘确认”标记为因果起点。") : na
                activeConfirmationLabel := (showRangeStartAndConfirmation or showRangeLifecycle) ?
                     label.new(bar_index, activeVisualUpper,
                          "横盘确认\n" + str.tostring(activeLength) + "根",
                          xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down,
                          color = color.new(color.blue, 15), textcolor = color.white,
                          size = size.tiny,
                          tooltip = "首次确认只在本棒收盘后可见\n交易核心 " +
                               f_price(activeUpper) + " / " + f_price(activeLower) +
                               "\n视觉父区间 " + f_price(activeVisualUpper) + " / " +
                               f_price(activeVisualLower) + "\n触碰组 " +
                               str.tostring(selectedFreshUpperTouches) + "/" +
                               str.tostring(selectedFreshLowerTouches) + "\n交替 " +
                               str.tostring(selectedFreshTransitions) + "\n容纳率 " +
                               str.tostring(selectedFreshContainment * 100.0, "#.0") + "%\n方向效率 " +
                               f_price(selectedFreshEfficiency) + "\n漂移 " +
                               f_price(selectedFreshUpperDrift) + "/" +
                               f_price(selectedFreshLowerDrift)) : na
                if showRangeStartAndConfirmation or showRangeLifecycle
                    array.push(storedRangeStartLabels, activeStartLabel)
                    array.push(storedRangeConfirmationLabels, activeConfirmationLabel)
                    if array.size(storedRangeStartLabels) > maximumVisibleZones
                        label.delete(array.shift(storedRangeStartLabels))
                        label.delete(array.shift(storedRangeConfirmationLabels))

    // ---------- V43 父内局部子区间 ----------
    // Rust 合同的父优先语义：本棒只要产生父生命周期事件，就不再推进子状态。
    if parentLifecycleEvent != 0
        resetsChild = parentLifecycleEvent == 1 or parentLifecycleEvent == 2 or
             parentLifecycleEvent == 3 or parentLifecycleEvent == 5 or
             parentLifecycleEvent == 6 or parentLifecycleEvent == 7
        if resetsChild
            if childActiveRange
                f_close_child_range(bar_index - 1)
            childActiveRange := false
            childStartIndex := na
            childLength := na
            childUpper := na
            childLower := na
            childRawHigh := na
            childRawLow := na
            childVisualUpper := na
            childVisualLower := na
            childVisualBox := na
            childCoreBox := na
            childUpperLine := na
            childLowerLine := na
            childStartLabel := na
            childConfirmationLabel := na
            childWeakDeparturePending := false
            childWeakDepartureIndex := na
            childAcceptancePending := false
            childLastClosedIndex := na
        if parentLifecycleEvent == 1 or parentLifecycleEvent == 2
            childScopeActive := true
            childScopeParentStartIndex := activeStartIndex
            childScopeParentConfirmationIndex := activeFirstConfirmationIndex
            childScopeParentUpper := activeUpper
            childScopeParentLower := activeLower
            childScopeVisualUpper := activeVisualUpper
            childScopeVisualLower := activeVisualLower
        else if parentLifecycleEvent == 5 or parentLifecycleEvent == 6 or
             parentLifecycleEvent == 7
            childScopeActive := false
            childScopeParentStartIndex := na
            childScopeParentConfirmationIndex := na
            childScopeParentUpper := na
            childScopeParentLower := na
            childScopeVisualUpper := na
            childScopeVisualLower := na
    else if childScopeActive
        childHandledByAcceptance = false
        if childAcceptancePending
            childHandledByAcceptance := true
            childAge = bar_index - childPendingBreakoutIndex
            childInvalidated = childPendingDirection == 1 ?
                 close <= childPendingRangeUpper : close >= childPendingRangeLower
            childTouchedBoundary = childPendingDirection == 1 ?
                 low <= childPendingRangeUpper + childPendingRetestBand :
                 high >= childPendingRangeLower - childPendingRetestBand
            childRetainedBreakout = childPendingDirection == 1 ?
                 close >= childPendingRequiredClose : close <= childPendingRequiredClose
            childRetention75Passed = childPendingDirection == 1 ?
                 close >= childPendingMinimumRetentionClose :
                 close <= childPendingMinimumRetentionClose
            childAccepted = childAge >= 1 and childAge <= ACCEPTANCE_WINDOW_BARS and
                 not childInvalidated and childTouchedBoundary and childRetainedBreakout and
                 childRetention75Passed
            if childAccepted
                childAcceptancePending := false
                acceptanceConfirmedCount += 1
                childSignalCount += 1
                if time >= EVALUATION_START_MS and time <= EVALUATION_END_MS
                    signalCount += 1
                    f_audit_label(time, close, "子信号",
                         auditPrefix + "_CHILD_SIGNAL|dir=" +
                         (childPendingDirection == 1 ? "long" : "short") +
                         "|range_start=" + str.tostring(childPendingRangeStartIndex) +
                         "|range_len=" + str.tostring(childPendingRangeLength) +
                         "|upper=" + f_price(childPendingRangeUpper) + "|lower=" +
                         f_price(childPendingRangeLower) + "|breakout=" +
                         str.tostring(childPendingBreakoutTime) + "|signal=" +
                         str.tostring(time) + "|age=" + str.tostring(childAge) +
                         "|close=" + f_price(close) + "|required_close=" +
                         f_price(childPendingRequiredClose) + "|retention75_close=" +
                         f_price(childPendingMinimumRetentionClose) + "|atr14=" +
                         f_price(atr14) + "|struct_stop=" +
                         f_price(childPendingStructuralStop) + "|target=" +
                         f_price(childPendingMeasuredTarget),
                         childPendingDirection == 1 ? label.style_label_up :
                         label.style_label_down, color.new(color.fuchsia, 0), showSignalLifecycle)
                    entryPending := true
                    entryDirection := childPendingDirection
                    entryRangeStartIndex := childPendingRangeStartIndex
                    entryRangeLength := childPendingRangeLength
                    entryBreakoutTime := childPendingBreakoutTime
                    entrySignalTime := time
                    entrySignalAtr := atr14
                    entryStructuralStop := childPendingStructuralStop
                    entryFrozenTarget := childPendingMeasuredTarget
                    entryBrokenBoundary := childPendingDirection == 1 ?
                         childPendingRangeUpper : childPendingRangeLower
                    childReportMinimumRiskTicks = int(math.max(1.0,
                         math.ceil(minimumStopAtr * atr14 / syminfo.mintick)))
                    childReportAtrFloorStop = childPendingDirection == 1 ?
                         close - childReportMinimumRiskTicks * syminfo.mintick :
                         close + childReportMinimumRiskTicks * syminfo.mintick
                    childReportStop = childPendingDirection == 1 ?
                         math.min(childPendingStructuralStop, childReportAtrFloorStop) :
                         math.max(childPendingStructuralStop, childReportAtrFloorStop)
                    childReportTarget = childPendingDirection == 1 ?
                         f_round_down(childPendingMeasuredTarget) :
                         f_round_up(childPendingMeasuredTarget)
                    childReportEntryId = childPendingDirection == 1 ?
                         TV_LONG_ENTRY_ID : TV_SHORT_ENTRY_ID
                    childReportExitId = childPendingDirection == 1 ?
                         TV_LONG_EXIT_ID : TV_SHORT_EXIT_ID
                    childReportRiskPerUnit = math.abs(close - childReportStop)
                    childReportQuantity = childReportRiskPerUnit > syminfo.mintick * 0.1 ?
                         strategy.initial_capital * 0.01 / childReportRiskPerUnit : na
                    if not na(childReportQuantity)
                        strategy.cancel_all()
                        if strategy.position_size > 0
                            strategy.close(TV_LONG_ENTRY_ID, comment = "V43 子信号下一开盘换仓")
                        else if strategy.position_size < 0
                            strategy.close(TV_SHORT_ENTRY_ID, comment = "V43 子信号下一开盘换仓")
                        strategy.entry(childReportEntryId,
                             childPendingDirection == 1 ? strategy.long : strategy.short,
                             qty = childReportQuantity,
                             comment = childPendingDirection == 1 ? "V43 子多" : "V43 子空")
                        strategy.exit(childReportExitId, from_entry = childReportEntryId,
                             stop = childReportStop, limit = childReportTarget,
                             comment = "V43 子区间止损/止盈")
            else if childInvalidated
                childAcceptancePending := false
                acceptanceInvalidatedCount += 1
            else if childAge >= ACCEPTANCE_WINDOW_BARS
                childAcceptancePending := false
                acceptanceExpiredCount += 1

        if not childHandledByAcceptance
            childHandledByWeakDeparture = false
            if childWeakDeparturePending
                childHandledByWeakDeparture := true
                childReturnedInside = close >= childLower and close <= childUpper
                if childReturnedInside
                    childWeakReturnedCount += 1
                    childWeakDeparturePending := false
                    if not na(childVisualBox)
                        box.set_right(childVisualBox, bar_index)
                        box.set_right(childCoreBox, bar_index)
                        line.set_x2(childUpperLine, bar_index)
                        line.set_x2(childLowerLine, bar_index)
                else
                    childWeakConsumedCount += 1
                    f_close_child_range(childWeakDepartureIndex - 1)
                    childLastClosedIndex := childWeakDepartureIndex
                    childActiveRange := false
                    childWeakDeparturePending := false
                    childStartIndex := na
                    childLength := na
                    childUpper := na
                    childLower := na
                    childRawHigh := na
                    childRawLow := na
                    childVisualUpper := na
                    childVisualLower := na
                    childVisualBox := na
                    childCoreBox := na
                    childUpperLine := na
                    childLowerLine := na
                    childStartLabel := na
                    childConfirmationLabel := na

            if not childHandledByWeakDeparture
                if childActiveRange
                    childClosedAbove = close > childUpper
                    childClosedBelow = close < childLower
                    if childClosedAbove or childClosedBelow
                        childBreakDirection = childClosedAbove ? 1 : -1
                        [childRawBreakStrong, childBodyRatio, childDirectionalMoveRatio] =
                             f_breakout_strength(childBreakDirection)
                        childRawBuffer = na(atr14) ? 0.0 : atr14 * rawExtremeBufferAtr
                        childRawExtremeOk = not requireRawExtreme or
                             (childBreakDirection == 1 ?
                             close > childRawHigh + childRawBuffer :
                             close < childRawLow - childRawBuffer)
                        childStrongBreak = childRawBreakStrong and childRawExtremeOk
                        if not childStrongBreak
                            childWeakDeparturePending := true
                            childWeakDepartureIndex := bar_index
                            f_audit_label(time, childBreakDirection == 1 ? high : low,
                                 "子弱离",
                                 auditPrefix + "_CHILD_WEAK_DEPARTURE|dir=" +
                                 (childBreakDirection == 1 ? "up" : "down") +
                                 "|departure=" + str.tostring(time) + "|range_start=" +
                                 str.tostring(childStartIndex) + "|range_len=" +
                                 str.tostring(childLength) + "|upper=" + f_price(childUpper) +
                                 "|lower=" + f_price(childLower) + "|open=" + f_price(open) +
                                 "|high=" + f_price(high) + "|low=" + f_price(low) +
                                 "|close=" + f_price(close) + "|body_ratio=" +
                                 f_price(childBodyRatio) + "|move_ratio=" +
                                 f_price(childDirectionalMoveRatio),
                                 childBreakDirection == 1 ? label.style_label_down :
                                 label.style_label_up, color.new(color.gray, 20),
                                 showWeakDepartureMarkers or showRangeLifecycle)
                        else
                            childStrongBreakoutCount += 1
                            f_close_child_range(bar_index - 1)
                            frozenChildStart = childStartIndex
                            frozenChildLength = childLength
                            frozenChildUpper = childUpper
                            frozenChildLower = childLower
                            childActiveRange := false
                            childLastClosedIndex := bar_index
                            childStartIndex := na
                            childLength := na
                            childUpper := na
                            childLower := na
                            childRawHigh := na
                            childRawLow := na
                            childVisualUpper := na
                            childVisualLower := na
                            childVisualBox := na
                            childCoreBox := na
                            childUpperLine := na
                            childLowerLine := na
                            childStartLabel := na
                            childConfirmationLabel := na
                            if atr14 > 0
                                childBoundary = childBreakDirection == 1 ?
                                     frozenChildUpper : frozenChildLower
                                childBreakoutExcess = childBreakDirection == 1 ?
                                     close - childBoundary : childBoundary - close
                                childRetainedExcess = math.max(syminfo.mintick,
                                     childBreakoutExcess * RETAINED_BREAKOUT_EXCESS_RATIO)
                                childAcceptancePending := true
                                childPendingDirection := childBreakDirection
                                childPendingRangeStartIndex := frozenChildStart
                                childPendingRangeLength := frozenChildLength
                                childPendingRangeUpper := frozenChildUpper
                                childPendingRangeLower := frozenChildLower
                                childPendingBreakoutIndex := bar_index
                                childPendingBreakoutTime := time
                                childPendingRetestBand := math.max(
                                     math.abs(childBoundary) * RETEST_BAND_PRICE_RATIO,
                                     atr14 * RETEST_BAND_ATR_RATIO)
                                childPendingRequiredClose := childBreakDirection == 1 ?
                                     childBoundary + childRetainedExcess :
                                     childBoundary - childRetainedExcess
                                childMinimumRetainedExcess = childBreakoutExcess *
                                     MINIMUM_ACCEPTANCE_RETENTION_RATIO
                                childPendingMinimumRetentionClose := childBreakDirection == 1 ?
                                     childBoundary + childMinimumRetainedExcess :
                                     childBoundary - childMinimumRetainedExcess
                                childStopBuffer = syminfo.mintick + atr14 * stopAtrExtra
                                childPendingStructuralStop := childBreakDirection == 1 ?
                                     f_round_down(low - childStopBuffer) :
                                     f_round_up(high + childStopBuffer)
                                childRangeHeight = (frozenChildUpper - frozenChildLower) *
                                     targetRangeMultiple
                                childPendingMeasuredTarget := childBreakDirection == 1 ?
                                     frozenChildUpper + childRangeHeight :
                                     frozenChildLower - childRangeHeight
                                childArmedCount += 1
                                armedCount += 1
                                f_audit_label(time, childBreakDirection == 1 ? high : low,
                                     "子突破",
                                     auditPrefix + "_CHILD_BREAKOUT|dir=" +
                                     (childBreakDirection == 1 ? "long" : "short") +
                                     "|range_start=" + str.tostring(frozenChildStart) +
                                     "|range_len=" + str.tostring(frozenChildLength) +
                                     "|upper=" + f_price(frozenChildUpper) + "|lower=" +
                                     f_price(frozenChildLower) + "|breakout=" +
                                     str.tostring(time) + "|close=" + f_price(close) +
                                     "|body_ratio=" + f_price(childBodyRatio) +
                                     "|move_ratio=" + f_price(childDirectionalMoveRatio) +
                                     "|required_close=" + f_price(childPendingRequiredClose) +
                                     "|retention75_close=" +
                                     f_price(childPendingMinimumRetentionClose) +
                                     "|retest_band=" + f_price(childPendingRetestBand) +
                                     "|struct_stop=" + f_price(childPendingStructuralStop) +
                                     "|target=" + f_price(childPendingMeasuredTarget),
                                     childBreakDirection == 1 ? label.style_label_down :
                                     label.style_label_up, color.new(color.fuchsia, 0),
                                     showSignalLifecycle)
                    else
                        childHeight = childUpper - childLower
                        childInternalBodyToRangeHeight = childHeight > 0 ?
                             math.abs(close - open) / childHeight : 1e10
                        childImpulseFullyContained = high <= childUpper and low >= childLower
                        childInternalImpulse = childInternalBodyToRangeHeight >=
                             MAXIMUM_INTERNAL_BODY_TO_RANGE_HEIGHT and
                             (not EXEMPT_FULLY_CONTAINED_INTERNAL_BODY or
                             not childImpulseFullyContained)
                        if childInternalImpulse
                            f_close_child_range(bar_index - 1)
                            childLastClosedIndex := bar_index
                            childInternalImpulseResetCount += 1
                            childActiveRange := false
                            childStartIndex := na
                            childLength := na
                            childUpper := na
                            childLower := na
                            childRawHigh := na
                            childRawLow := na
                            childVisualUpper := na
                            childVisualLower := na
                            childVisualBox := na
                            childCoreBox := na
                            childUpperLine := na
                            childLowerLine := na
                            childStartLabel := na
                            childConfirmationLabel := na
                        else
                            childCandidateStart = selectedChildAnyValid ?
                                 bar_index - selectedChildAnyLength + 1 : bar_index
                            childOverlapsActive = selectedChildAnyValid and
                                 selectedChildAnyUpper >= childLower and
                                 selectedChildAnyLower <= childUpper
                            childUpgrades = childOverlapsActive and
                                 childCandidateStart < childStartIndex
                            if childUpgrades
                                childStartIndex := childCandidateStart
                                childLength := selectedChildAnyLength
                                childUpper := selectedChildAnyUpper
                                childLower := selectedChildAnyLower
                                childRawHigh := selectedChildAnyRawHigh
                                childRawLow := selectedChildAnyRawLow
                                childVisualUpper := selectedChildAnyVisualUpper
                                childVisualLower := selectedChildAnyVisualLower
                                childRangeUpgradedCount += 1
                                if not na(childStartLabel)
                                    label.set_xy(childStartLabel, childStartIndex,
                                         childVisualLower)
                                if not na(childConfirmationLabel)
                                    label.set_y(childConfirmationLabel, childVisualUpper)
                                    label.set_text(childConfirmationLabel,
                                         "局部确认\n" + str.tostring(childLength) + "根")
                            if not na(childVisualBox)
                                box.set_lefttop(childVisualBox, childStartIndex,
                                     childVisualUpper)
                                box.set_rightbottom(childVisualBox, bar_index,
                                     childVisualLower)
                                box.set_lefttop(childCoreBox, childStartIndex, childUpper)
                                box.set_rightbottom(childCoreBox, bar_index, childLower)
                                line.set_xy1(childUpperLine, childStartIndex, childUpper)
                                line.set_xy2(childUpperLine, bar_index, childUpper)
                                line.set_xy1(childLowerLine, childStartIndex, childLower)
                                line.set_xy2(childLowerLine, bar_index, childLower)
                else if selectedChildFreshValid
                    childActiveRange := true
                    childStartIndex := bar_index - selectedChildFreshLength + 1
                    childLength := selectedChildFreshLength
                    childUpper := selectedChildFreshUpper
                    childLower := selectedChildFreshLower
                    childRawHigh := selectedChildFreshRawHigh
                    childRawLow := selectedChildFreshRawLow
                    childVisualUpper := selectedChildFreshVisualUpper
                    childVisualLower := selectedChildFreshVisualLower
                    childRangeConfirmedCount += 1
                    if showZones
                        childVisualBox := box.new(childStartIndex, childVisualUpper, bar_index,
                             childVisualLower, xloc = xloc.bar_index,
                             border_color = color.new(color.orange, 20),
                             border_style = line.style_solid,
                             bgcolor = color.new(color.orange, 91))
                        childCoreBox := box.new(childStartIndex, childUpper, bar_index,
                             childLower, xloc = xloc.bar_index,
                             border_color = color.new(color.yellow, 10),
                             border_style = line.style_dotted,
                             bgcolor = color.new(color.yellow, 84))
                        childUpperLine := line.new(childStartIndex, childUpper, bar_index,
                             childUpper, xloc = xloc.bar_index,
                             color = color.new(color.orange, 0), style = line.style_dashed)
                        childLowerLine := line.new(childStartIndex, childLower, bar_index,
                             childLower, xloc = xloc.bar_index,
                             color = color.new(color.yellow, 0), style = line.style_dashed)
                        array.push(storedChildVisualBoxes, childVisualBox)
                        array.push(storedChildCoreBoxes, childCoreBox)
                        array.push(storedChildUpperLines, childUpperLine)
                        array.push(storedChildLowerLines, childLowerLine)
                        if array.size(storedChildVisualBoxes) > maximumVisibleZones
                            box.delete(array.shift(storedChildVisualBoxes))
                            box.delete(array.shift(storedChildCoreBoxes))
                            line.delete(array.shift(storedChildUpperLines))
                            line.delete(array.shift(storedChildLowerLines))
                    childStartLabel := (showRangeStartAndConfirmation or showRangeLifecycle) ?
                         label.new(childStartIndex, childVisualLower,
                              "局部起点\n确认后回画", xloc = xloc.bar_index,
                              yloc = yloc.price, style = label.style_label_up,
                              color = color.new(color.orange, 0), textcolor = color.white,
                              size = size.tiny) : na
                    childConfirmationLabel :=
                         (showRangeStartAndConfirmation or showRangeLifecycle) ?
                         label.new(bar_index, childVisualUpper,
                              "局部确认\n" + str.tostring(childLength) + "根",
                              xloc = xloc.bar_index, yloc = yloc.price,
                              style = label.style_label_down,
                              color = color.new(color.yellow, 15), textcolor = color.black,
                              size = size.tiny,
                              tooltip = "V43 父内局部横盘\n交易核心 " +
                                   f_price(childUpper) + " / " + f_price(childLower) +
                                   "\n视觉外壳 " + f_price(childVisualUpper) + " / " +
                                   f_price(childVisualLower)) : na
                    if showRangeStartAndConfirmation or showRangeLifecycle
                        array.push(storedChildStartLabels, childStartLabel)
                        array.push(storedChildConfirmationLabels, childConfirmationLabel)
                        if array.size(storedChildStartLabels) > maximumVisibleZones
                            label.delete(array.shift(storedChildStartLabels))
                            label.delete(array.shift(storedChildConfirmationLabels))

activeStopPlot = showTradeLevels and tradeActive ? tradeStopPrice : na
activeTargetPlot = showTradeLevels and tradeActive ? tradeTargetPrice : na
plot(activeStopPlot, "V43 Active Stop", color = color.new(color.red, 0), style = plot.style_linebr)
plot(activeTargetPlot, "V43 Active Target", color = color.new(color.green, 0), style = plot.style_linebr)

// ---------- 图表内审计摘要 ----------

var table audit = table.new(position.bottom_right, 2, 19,
     bgcolor = color.new(color.black, 10), border_width = 1)
if barstate.islastconfirmedhistory
    modeText = strictDataReady ? "严格全历史" : localDataReady ? "本地诊断，非严格" : "数据未就绪"
    table.cell(audit, 0, 0, "V43父升级纵向均衡", text_color = color.white,
         bgcolor = color.new(color.blue, 35), text_size = size.tiny)
    table.cell(audit, 1, 0, "识别保留 / 交易未晋级", text_color = color.yellow,
         bgcolor = color.new(color.blue, 35), text_size = size.tiny)
    table.cell(audit, 0, 1, "模式 / 周期", text_size = size.tiny)
    table.cell(audit, 1, 1, modeText + " / " + (timeframeReady ? "15m" : "周期错误"),
         text_color = strictDataReady ? color.lime : color.yellow, text_size = size.tiny)
    table.cell(audit, 0, 2, "横盘确认 / 升级", text_size = size.tiny)
    table.cell(audit, 1, 2, str.tostring(rangeConfirmedCount) + " / " +
         str.tostring(rangeUpgradedCount), text_size = size.tiny)
    table.cell(audit, 0, 3, "弱离区回区 / 消费", text_size = size.tiny)
    table.cell(audit, 1, 3, str.tostring(weakReturnedCount) + " / " +
         str.tostring(weakConsumedCount), text_size = size.tiny)
    table.cell(audit, 0, 4, "内部重置 / 强突破 / 武装", text_size = size.tiny)
    table.cell(audit, 1, 4, str.tostring(internalImpulseResetCount) + " / " +
         str.tostring(strongBreakoutCount) + " / " + str.tostring(armedCount),
         text_size = size.tiny)
    table.cell(audit, 0, 5, "确认 / 失效 / 过期", text_size = size.tiny)
    table.cell(audit, 1, 5, str.tostring(acceptanceConfirmedCount) + " / " +
         str.tostring(acceptanceInvalidatedCount) + " / " +
         str.tostring(acceptanceExpiredCount), text_size = size.tiny)
    table.cell(audit, 0, 6, "信号 / 入场 / 退出", text_size = size.tiny)
    table.cell(audit, 1, 6, str.tostring(signalCount) + " / " +
         str.tostring(filledTradeCount) + " / " + str.tostring(closedTradeCount),
         text_size = size.tiny)
    table.cell(audit, 0, 7, "止损 / 目标 / 反手", text_size = size.tiny)
    table.cell(audit, 1, 7, str.tostring(stopExitCount) + " / " +
         str.tostring(targetExitCount) + " / " + str.tostring(reverseExitCount),
         text_size = size.tiny)
    table.cell(audit, 0, 8, "结构阻塞 / 目标已过", text_size = size.tiny)
    table.cell(audit, 1, 8, str.tostring(invalidStructureCount) + " / " +
         str.tostring(targetPassedAtEntryCount),
         text_color = targetPassedAtEntryCount > 0 ? color.yellow : color.white,
         text_size = size.tiny)
    // 追高分布：入场价越过被突破边界的 ATR 倍数，按 <0.5 / 0.5~1 / 1~2 / >=2 分桶。
    table.cell(audit, 0, 9, "追高 <0.5/0.5-1/1-2/>=2", text_size = size.tiny)
    table.cell(audit, 1, 9, str.tostring(chaseBucket0) + " / " + str.tostring(chaseBucket1) +
         " / " + str.tostring(chaseBucket2) + " / " + str.tostring(chaseBucket3),
         text_color = chaseBucket3 > 0 ? color.orange : color.white, text_size = size.tiny)
    table.cell(audit, 0, 10, "追高均值 / 最大", text_size = size.tiny)
    table.cell(audit, 1, 10, (filledTradeCount > 0 ?
         f_r(chaseAtrSum / filledTradeCount) : "0") + " / " + f_r(chaseAtrMax) + " ATR",
         text_size = size.tiny)
    table.cell(audit, 0, 11, "Gross R / Net R", text_size = size.tiny)
    table.cell(audit, 1, 11, f_price(cumulativeGrossR) + " / " + f_price(cumulativeNetR),
         text_color = cumulativeNetR >= 0 ? color.lime : color.red, text_size = size.tiny)
    table.cell(audit, 0, 12, "成本", text_size = size.tiny)
    table.cell(audit, 1, 12, "入maker2+滑点1 / 出taker5+滑点1 bps",
         text_size = size.tiny)
    table.cell(audit, 0, 13, "TV报告 已平 / 持仓", text_size = size.tiny)
    table.cell(audit, 1, 13, str.tostring(strategy.closedtrades) + " / " +
         str.tostring(strategy.opentrades) + "（每边4.5bps近似）", text_size = size.tiny)
    table.cell(audit, 0, 14, "TV报告 仓位 / 保证金", text_size = size.tiny)
    table.cell(audit, 1, 14, "初始资金1%风险 / 20%（最高5x）", text_size = size.tiny)
    table.cell(audit, 0, 15, "版本", text_size = size.tiny)
    table.cell(audit, 1, 15, "V43 Balanced Parent / Research-only",
         text_size = size.tiny, tooltip = RULE_VERSION + "\n" + VISUAL_RULE_VERSION)
    table.cell(audit, 0, 16, "子确认 / 升级 / 信号", text_size = size.tiny)
    table.cell(audit, 1, 16, str.tostring(childRangeConfirmedCount) + " / " +
         str.tostring(childRangeUpgradedCount) + " / " + str.tostring(childSignalCount),
         text_size = size.tiny)
    table.cell(audit, 0, 17, "子弱回/消费/重置/突破", text_size = size.tiny)
    table.cell(audit, 1, 17, str.tostring(childWeakReturnedCount) + " / " +
         str.tostring(childWeakConsumedCount) + " / " +
         str.tostring(childInternalImpulseResetCount) + " / " +
         str.tostring(childStrongBreakoutCount), text_size = size.tiny)
    table.cell(audit, 0, 18, "单侧父升级拒绝", text_size = size.tiny)
    table.cell(audit, 1, 18, str.tostring(unbalancedParentUpgradeRejectedCount) +
         "（单侧占比 > 75%）", text_color = color.orange, text_size = size.tiny)
