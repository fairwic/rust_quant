// 父区间之外独立维护一个活动子区间；父生命周期事件总是先处理并可重置/清空该状态。
var bool childActiveRange = false
var int childStartIndex = na
var int childLength = na
var float childUpper = na
var float childLower = na
var float childRawHigh = na
var float childRawLow = na
