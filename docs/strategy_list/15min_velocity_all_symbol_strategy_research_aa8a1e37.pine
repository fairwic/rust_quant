//@version=6
// 研究图表版：严格在 15 分钟已确认 K 线上评估；包含锚定区间、大型水平箱体、大型上升三角、EMA 压缩扩张与空头延续扩展止盈。
// TradingView 的 volume 按当前研究约定直接作为 vol_ccy 使用；MACD 背离因 Z/D_min 未发布而关闭。
strategy("15m Velocity All Symbol - Research Chart", overlay = true, pyramiding = 0,
     initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 1,
     process_orders_on_close = false, max_labels_count = 500, max_lines_count = 500)

// 图表版无法在下一根开盘成交前取得实际成交价，因而固定为 1 单位，不复刻 Core 的 1% 风险仓位计算。
const int volumeLookback = 10
const int minValidVolumeSamples = 5
const int weeklyLookback = 672
const int bollingerLength = 20
const float bollingerDeviation = 2.0
const int anchorMinDistance = 5
const int anchorLookback = 32
const int divergenceWeakMaxGap = 7
const float volumeEventRatio = 2.5
const float divergenceRsiMidline = 50.0
const float divergenceMinBreakRatio = 0.0035
const float divergenceMinBreakAtr = 0.50
const float divergenceMinIntermediateSwingAtr = 1.0
const float divergenceBreakEvenRisk = 1.0
const float divergenceFinalTargetRisk = 1.5
const float divergenceDirectionalShadowMin = 0.25
const int divergenceDirectionalShadowMinTicks = 2
const string divergenceStructureVersion = "rsi_divergence_directional_candle_gate_v4"
const string rsiOpposingWickGuardVersion = "rsi_opposing_long_wick_guard_15m_v7"
const int falseBreakoutAnchorLength = 20
const int falseBreakoutFailureWindow = 8
const string rangeUpsideBreakLongVersion = "volume_anchor_range_upside_break_long_15m_v1"
const string confirmedRangeBreakLongVersion = "volume_confirmed_range_acceptance_break_long_15m_v2"
const int confirmedRangeTouchGap = 2
const int confirmedRangeAcceptanceWindow = 3
const float confirmedRangeMaxWidthRatio = 0.03
const float confirmedRangeTouchBandRatio = 0.0015
const float confirmedRangeTouchBandAtr = 0.35
const float confirmedRangeContainmentMin = 0.80
const float confirmedRangeUpperDriftMax = 0.25
const float confirmedRangeLowerDriftMax = 0.35
const float confirmedRangeContractionMax = 1.00
const float confirmedRangeRetestBandRatio = 0.001
const float confirmedRangeRetestBandAtr = 0.25
const string largeHorizontalRangeLongVersion = "volume_large_horizontal_range_break_long_15m_v1"
const int largeHorizontalRangeLookbackMin = 96
const int largeHorizontalRangeLookbackMax = 240
const int largeHorizontalRangeLookbackStep = 24
const int largeHorizontalRangeTouchGap = 8
const float largeHorizontalRangeMaxWidthRatio = 0.03
const float largeHorizontalRangeTouchBandRatio = 0.002
const float largeHorizontalRangeTouchBandAtr = 0.50
const float largeHorizontalRangeContainmentMin = 0.90
const float largeHorizontalRangeBoundaryDriftMax = 0.45
const float largeHorizontalRangeBreakoutRsiMin = 70.0
const float largeHorizontalRangeBreakoutRsiMax = 85.0
const string largeAscendingTriangleLongVersion = "volume_large_ascending_triangle_break_long_15m_v1"
const int largeTriangleLookbackMin = 96
const int largeTriangleLookbackMax = 192
const int largeTriangleLookbackStep = 24
const int largeTriangleTouchGap = 8
const float largeTriangleResistanceSpreadMax = 0.005
const float largeTriangleTouchBandRatio = 0.003
const float largeTriangleTouchBandAtr = 0.50
const float largeTriangleLowStepAtrMin = 0.25
const float largeTriangleLowRiseAtrMin = 1.0
const float largeTriangleContractionMax = 0.70
const float largeTriangleBreakoutRsiMin = 70.0
const float largeTriangleBreakoutRsiMax = 80.0
const string bullishTransitionShortGuardVersion = "recent_bullish_volume_ema_transition_short_guard_15m_v1"
const int bullishTransitionProtectionWindow = 5
const float bullishTransitionImpulseVolumeRatio = 6.0
const float bullishTransitionImpulseBodyAtr = 1.0
const string transitionLiquiditySweepShortVersion = "volume_transition_liquidity_sweep_short_15m_v1"
