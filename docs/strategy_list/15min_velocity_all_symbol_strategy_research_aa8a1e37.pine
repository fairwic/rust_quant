const float effortNoResultBodyAtrMin = 0.50
const float effortNoResultCloseLocationMax = 0.20
const float effortNoResultBreakEvenRisk = 1.0
const float effortNoResultFinalTargetRisk = 1.5
const int counterTrendRangeLength = 8
const int counterTrendRangeLookback = 48
const int counterTrendTouchGap = 2
const float counterTrendRangeMaxWidthRatio = 0.03
const float counterTrendTouchBandRatio = 0.10
const int counterTrendFreshBreakWindow = 8
const int counterTrendDisplacementLookback = 96
const float counterTrendDisplacementAtrMin = 6.0
const float counterTrendDisplacementRatioMin = 0.05
const float counterTrendTrailingDistanceRisk = 1.0
const string counterTrendStructureExitVersion = "counter_trend_structure_1r_trailing_v1"
