const int transitionSweepTouchGap = 2
const int transitionSweepMinTouchGroups = 2
const float transitionSweepTouchBandRatio = 0.0015
const float transitionSweepTouchBandAtr = 0.50
const float transitionSweepAnchorRsiMin = 80.0
const float transitionSweepSignalRsiMin = 70.0
const string effortNoResultShortVersion = "volume_effort_no_result_lower_high_boll_reclaim_short_15m_v1"
const int effortNoResultAnchorMinDistance = 20
const int effortNoResultAnchorMaxDistance = 80
const float effortNoResultMaxGapRatio = 0.005
const float effortNoResultMaxGapAtr = 0.50
const float effortNoResultVolumeMultiplierMin = 1.25
const float effortNoResultAnchorRsiMin = 70.0
const float effortNoResultSignalRsiMin = 55.0
