const int rsiCounterTrendMaturityBars = 600
const float rsiCounterTrendCostRatePerSide = 0.0008
const float rsiCounterTrendWideTrailRisk = 2.0
const string rsiCounterTrendMaturityExitVersion = "rsi_counter_trend_ema_age_structure_exit_v5"
const int emaCompressionLookback = 12
const int emaSlopeLookback = 3
const int emaExpansionCooldown = 12
const int emaExpansionStructureLookback = 20
const int recentMacdDirectionLookback = 3
const float emaCompressionMeanAtrMax = 0.25
const float emaCompressionMaxAtrMax = 0.50
const float emaCompressionTouchAtrMax = 0.10
const float ema12SlopeAtrMin = 0.05
const float ema144SlopeAtrMin = 0.015
const float ema596SlopeAtrMin = 0.0015
const float emaSlopeAccelerationMin = 1.20
const float emaExpansionTakeProfitAtr = 3.0
const float shortTrendExtensionTargetAtr = 8.0
const string threeBarEngulfReversalLongVersion = "volume_three_bear_bullish_engulfing_reversal_long_15m_v1"
const float threeBarEngulfMinBodyRangeRatio = 0.75
const float threeBarEngulfMinBodyAtr = 1.5
const float threeBarEngulfMinCloseLocation = 0.90
const float threeBarEngulfBottomBandAtr = 0.25
const float threeBarEngulfBreakEvenRisk = 1.0
const float threeBarEngulfFinalTargetRisk = 1.5
const string bollingerLowerReclaimLongVersion = "volume_bollinger_lower_reclaim_long_15m_v1"
const int bollingerLowerReclaimLocationLookback = 48
const float bollingerLowerReclaimShadowMin = 0.50
const float bollingerLowerReclaimCloseLocationMin = 0.75
const float bollingerLowerReclaimBottomPositionMax = 0.15
const float bollingerLowerReclaimRsiMin = 35.0
const float bollingerLowerReclaimRsiMax = 50.0
const float bollingerLowerReclaimMinRewardRisk = 1.10
const string ema596ReclaimDepartureLongVersion = "volume_ema596_reclaim_departure_hh_hl_long_15m_v2"
const int ema596ReclaimMaxAge = 32
const int ema596DepartureStructureLookback = 4
const int ema596DepartureVolumeMedianLookback = 20
const float ema596DepartureMedianVolumeRatioMin = 2.5
const float ema596DeparturePreviousDistanceAtrMax = 0.50
const float ema596DepartureCurrentDistanceAtrMin = 1.0
const float ema596DepartureBodyRangeMin = 0.60
const float ema596DepartureTargetRisk = 2.0

// 止损距离向外取整，止盈距离向内取整，保持交易所 tick 精度且不缩小初始风险空间。
f_stop_distance_ticks(distance) =>
    int(math.max(1, math.ceil(distance / syminfo.mintick)))

f_target_distance_ticks(distance) =>
    int(math.max(1, math.floor(distance / syminfo.mintick)))

f_round_long_stop(price) =>
    math.floor(price / syminfo.mintick) * syminfo.mintick

f_round_short_stop(price) =>
    math.ceil(price / syminfo.mintick) * syminfo.mintick

f_round_long_target(price) =>
    math.floor(price / syminfo.mintick) * syminfo.mintick

f_round_short_target(price) =>
    math.ceil(price / syminfo.mintick) * syminfo.mintick

// 成本后保本属于保护价：多单必须向上、空单必须向下取整，避免 tick 取整后重新落回净亏损。
f_round_long_net_break_even(price) =>
    math.ceil(price / syminfo.mintick) * syminfo.mintick

f_round_short_net_break_even(price) =>
    math.floor(price / syminfo.mintick) * syminfo.mintick

// 同方向多个候选分支可以同时成立，悬浮信息需要完整保留全部触发原因。
f_append_trigger(current, matched, trigger) =>
    matched ? (str.length(current) == 0 ? trigger : current + " + " + trigger) : current

// 透明热区覆盖信号 K 线主体，让悬浮提示不必精确命中尺寸很小的可见标记。
f_add_hover_target(x, y, details) =>
    label.new(x, y, "■■■\n■■■", xloc = xloc.bar_index, yloc = yloc.price,
         style = label.style_none, textcolor = color.new(color.white, 100),
         size = size.large, tooltip = details)

// 图表版用固定 8 根确认窗落实“至少 8 根”，防止为追求更远目标而事后向外扩张横盘边界。
f_sideways_window(endOffset) =>
    float candidateHigh = na
    float candidateLow = na
    bool samplesReady = true
    for windowIndex = 0 to counterTrendRangeLength - 1
        offset = endOffset + windowIndex
        sampleReady = not na(high[offset]) and not na(low[offset]) and
             high[offset] >= low[offset] and low[offset] > 0
        samplesReady := samplesReady and sampleReady
        if sampleReady
            candidateHigh := na(candidateHigh) ? high[offset] : math.max(candidateHigh, high[offset])
            candidateLow := na(candidateLow) ? low[offset] : math.min(candidateLow, low[offset])

    candidateHeight = samplesReady ? candidateHigh - candidateLow : na
    candidateWidthRatio = samplesReady and candidateLow > 0 ? candidateHeight / candidateLow : na
    touchBand = samplesReady ? math.max(syminfo.mintick * 2, candidateHeight * counterTrendTouchBandRatio) : na
    int upperTouchGroups = 0
    int lowerTouchGroups = 0
    int lastUpperTouchIndex = na
    int lastLowerTouchIndex = na

    // 连续触碰属于同一组；只有与上一触碰至少相隔 2 根，才记为新的独立测试。
    for chronologicalIndex = 0 to counterTrendRangeLength - 1
        offset = endOffset + counterTrendRangeLength - 1 - chronologicalIndex
        if samplesReady and high[offset] >= candidateHigh - touchBand
            if na(lastUpperTouchIndex) or chronologicalIndex - lastUpperTouchIndex >= counterTrendTouchGap
                upperTouchGroups += 1
            lastUpperTouchIndex := chronologicalIndex
        if samplesReady and low[offset] <= candidateLow + touchBand
            if na(lastLowerTouchIndex) or chronologicalIndex - lastLowerTouchIndex >= counterTrendTouchGap
                lowerTouchGroups += 1
            lastLowerTouchIndex := chronologicalIndex

    valid = samplesReady and candidateHeight > 0 and
         candidateWidthRatio <= counterTrendRangeMaxWidthRatio and
         upperTouchGroups >= 2 and lowerTouchGroups >= 2
    [valid, candidateHigh, candidateLow, candidateWidthRatio, upperTouchGroups, lowerTouchGroups]

// “刚突破/跌破”必须是横盘结束后的首次收盘穿越，且从穿越棒到 t 的每根收盘都留在区间外。
// 这样旧区间被收回后不会因二次穿越重新取得 fresh 身份，也不会把长期离轨误写成刚破位。
f_held_break_age(zoneEndOffset, boundary, breakDown) =>
    int firstBreakAge = na
    // 从横盘结束后最老的一根向 t 扫描；若首次穿越早于8根，即使近期二次穿越也不能重新标成 fresh。
    for scanIndex = 0 to counterTrendRangeLookback - 1
        candidateAge = counterTrendRangeLookback - 1 - scanIndex
        candidateReady = candidateAge < zoneEndOffset and
             not na(close[candidateAge]) and not na(close[candidateAge + 1])
        crossed = candidateReady and
             (breakDown ?
                  close[candidateAge] < boundary and close[candidateAge + 1] >= boundary :
                  close[candidateAge] > boundary and close[candidateAge + 1] <= boundary)
        if na(firstBreakAge) and crossed
            firstBreakAge := candidateAge

    bool heldOutside = not na(firstBreakAge)
    if heldOutside
        for heldAge = 0 to counterTrendRangeLookback - 1
            if heldAge <= firstBreakAge
                sampleOutside = not na(close[heldAge]) and
                     (breakDown ? close[heldAge] < boundary : close[heldAge] > boundary)
                heldOutside := heldOutside and sampleOutside
    heldOutside and firstBreakAge < counterTrendFreshBreakWindow ? firstBreakAge : na

// 20 根短箱体使用稳健边界识别横盘、真实极值确认突破；两者分离可避免单根异常影线伪造箱体边界。
f_confirmed_anchor_range(currentAtr) =>
    int halfLength = int(falseBreakoutAnchorLength / 2)
    int recentContractionLength = 5
    bool samplesReady = not na(currentAtr) and currentAtr > 0
    array<float> highSamples = array.new_float()
    array<float> lowSamples = array.new_float()
    array<float> earlyHighSamples = array.new_float()
    array<float> recentHighSamples = array.new_float()
    array<float> earlyLowSamples = array.new_float()
    array<float> recentLowSamples = array.new_float()
    float earlierTrueRangeSum = 0.0
    float recentTrueRangeSum = 0.0

    for chronologicalIndex = 0 to falseBreakoutAnchorLength - 1
        offset = falseBreakoutAnchorLength - chronologicalIndex
        sampleReady = not na(high[offset]) and not na(low[offset]) and not na(close[offset]) and
             not na(close[offset + 1]) and high[offset] >= low[offset] and low[offset] > 0
        samplesReady := samplesReady and sampleReady
        if sampleReady
            array.push(highSamples, high[offset])
            array.push(lowSamples, low[offset])
            if chronologicalIndex < halfLength
                array.push(earlyHighSamples, high[offset])
                array.push(earlyLowSamples, low[offset])
            else
                array.push(recentHighSamples, high[offset])
                array.push(recentLowSamples, low[offset])

            sampleTrueRange = math.max(high[offset] - low[offset],
                 math.max(math.abs(high[offset] - close[offset + 1]),
                 math.abs(low[offset] - close[offset + 1])))
            if chronologicalIndex < falseBreakoutAnchorLength - recentContractionLength
                earlierTrueRangeSum += sampleTrueRange
            else
                recentTrueRangeSum += sampleTrueRange

    candidateUpper = samplesReady ? array.percentile_nearest_rank(highSamples, 85) : na
    candidateLower = samplesReady ? array.percentile_nearest_rank(lowSamples, 15) : na
    candidateRawHigh = samplesReady ? array.max(highSamples) : na
    candidateRawLow = samplesReady ? array.min(lowSamples) : na
    candidateHeight = samplesReady ? candidateUpper - candidateLower : na
    candidateMid = samplesReady ? (candidateUpper + candidateLower) * 0.5 : na
    candidateWidthRatio = samplesReady and candidateMid > 0 ? candidateHeight / candidateMid : na
    touchBand = samplesReady ? math.max(candidateMid * confirmedRangeTouchBandRatio,
         currentAtr * confirmedRangeTouchBandAtr) : na
    int upperTouchGroups = 0
    int lowerTouchGroups = 0
    int lastUpperTouchIndex = na
    int lastLowerTouchIndex = na
    int containedCloses = 0

    if samplesReady
        for chronologicalIndex = 0 to falseBreakoutAnchorLength - 1
            offset = falseBreakoutAnchorLength - chronologicalIndex
            if high[offset] >= candidateUpper - touchBand
                if na(lastUpperTouchIndex) or chronologicalIndex - lastUpperTouchIndex >= confirmedRangeTouchGap
                    upperTouchGroups += 1
                lastUpperTouchIndex := chronologicalIndex
            if low[offset] <= candidateLower + touchBand
                if na(lastLowerTouchIndex) or chronologicalIndex - lastLowerTouchIndex >= confirmedRangeTouchGap
                    lowerTouchGroups += 1
                lastLowerTouchIndex := chronologicalIndex
            if close[offset] >= candidateLower - touchBand and close[offset] <= candidateUpper + touchBand
                containedCloses += 1

    containmentRatio = samplesReady ? float(containedCloses) / falseBreakoutAnchorLength : na
    earlyUpper = samplesReady ? array.percentile_nearest_rank(earlyHighSamples, 80) : na
    recentUpper = samplesReady ? array.percentile_nearest_rank(recentHighSamples, 80) : na
    earlyLower = samplesReady ? array.percentile_nearest_rank(earlyLowSamples, 20) : na
    recentLower = samplesReady ? array.percentile_nearest_rank(recentLowSamples, 20) : na
    upperBoundaryDriftRatio = samplesReady and candidateHeight > 0 ?
         math.abs(recentUpper - earlyUpper) / candidateHeight : na
    lowerBoundaryDriftRatio = samplesReady and candidateHeight > 0 ?
         math.abs(recentLower - earlyLower) / candidateHeight : na
    earlierTrueRangeMean = samplesReady ?
         earlierTrueRangeSum / (falseBreakoutAnchorLength - recentContractionLength) : na
    recentTrueRangeMean = samplesReady ? recentTrueRangeSum / recentContractionLength : na
    contractionRatio = samplesReady and earlierTrueRangeMean > 0 ?
         recentTrueRangeMean / earlierTrueRangeMean : na

    valid = samplesReady and candidateHeight > 0 and
         candidateWidthRatio <= confirmedRangeMaxWidthRatio and
         upperTouchGroups >= 2 and lowerTouchGroups >= 2 and
         containmentRatio >= confirmedRangeContainmentMin and
         // 上破交易要求压力线更水平；下沿可轻微抬升，但仍须受限，避免把趋势段冒充箱体。
         upperBoundaryDriftRatio <= confirmedRangeUpperDriftMax and
         lowerBoundaryDriftRatio <= confirmedRangeLowerDriftMax and
         contractionRatio <= confirmedRangeContractionMax
    [valid, candidateUpper, candidateLower, candidateRawHigh, candidateRawLow,
         candidateWidthRatio, containmentRatio, upperBoundaryDriftRatio,
         lowerBoundaryDriftRatio, contractionRatio, upperTouchGroups, lowerTouchGroups]

// 固定五个24～48小时窗口，避免逐长度搜索把已见形态变成隐性参数优化；每个窗口只读取信号棒之前的数据。
f_large_ascending_triangle(candidateLength, currentAtr) =>
    int segmentLength = int(candidateLength / 3)
    bool samplesReady = not na(currentAtr) and currentAtr > 0
    float earlyHigh = na
    float middleHigh = na
    float recentHigh = na
    float earlyLow = na
    float middleLow = na
    float recentLow = na

    // 三等分后的高点衡量水平阻力，低点负责证明买方承接在逐段抬高。
    for chronologicalIndex = 0 to candidateLength - 1
        offset = candidateLength - chronologicalIndex
        sampleReady = not na(high[offset]) and not na(low[offset]) and
             high[offset] >= low[offset] and low[offset] > 0
        samplesReady := samplesReady and sampleReady
        if sampleReady
            if chronologicalIndex < segmentLength
                earlyHigh := na(earlyHigh) ? high[offset] : math.max(earlyHigh, high[offset])
                earlyLow := na(earlyLow) ? low[offset] : math.min(earlyLow, low[offset])
            else if chronologicalIndex < 2 * segmentLength
                middleHigh := na(middleHigh) ? high[offset] : math.max(middleHigh, high[offset])
                middleLow := na(middleLow) ? low[offset] : math.min(middleLow, low[offset])
            else
                recentHigh := na(recentHigh) ? high[offset] : math.max(recentHigh, high[offset])
                recentLow := na(recentLow) ? low[offset] : math.min(recentLow, low[offset])

    candidateResistance = samplesReady ? math.max(earlyHigh, math.max(middleHigh, recentHigh)) : na
    lowestSegmentPeak = samplesReady ? math.min(earlyHigh, math.min(middleHigh, recentHigh)) : na
    resistanceSpreadRatio = samplesReady and candidateResistance > 0 ?
         (candidateResistance - lowestSegmentPeak) / candidateResistance : na
    touchBand = samplesReady ? math.max(candidateResistance * largeTriangleTouchBandRatio,
         currentAtr * largeTriangleTouchBandAtr) : na
    int upperTouchGroups = 0
    int lastUpperTouchIndex = na

    // 一串连续贴边只算一次测试，至少相隔8根才证明阻力经历过独立回踩。
    if samplesReady
        for chronologicalIndex = 0 to candidateLength - 1
            offset = candidateLength - chronologicalIndex
            if high[offset] >= candidateResistance - touchBand
                if na(lastUpperTouchIndex) or chronologicalIndex - lastUpperTouchIndex >= largeTriangleTouchGap
                    upperTouchGroups += 1
                lastUpperTouchIndex := chronologicalIndex

    lowStepMinimum = currentAtr * largeTriangleLowStepAtrMin
    lowsRising = samplesReady and middleLow - earlyLow >= lowStepMinimum and
         recentLow - middleLow >= lowStepMinimum and
         recentLow - earlyLow >= currentAtr * largeTriangleLowRiseAtrMin
    earlyWidth = samplesReady ? candidateResistance - earlyLow : na
    recentWidth = samplesReady ? candidateResistance - recentLow : na
    contractionRatio = samplesReady and earlyWidth > 0 and recentWidth > 0 ? recentWidth / earlyWidth : na
    valid = samplesReady and resistanceSpreadRatio <= largeTriangleResistanceSpreadMax and
         upperTouchGroups >= 3 and lowsRising and
         not na(contractionRatio) and contractionRatio <= largeTriangleContractionMax
    [valid, candidateResistance, earlyLow, middleLow, recentLow,
         resistanceSpreadRatio, contractionRatio, upperTouchGroups]

// 大型水平箱体用稳健分位边界忽略少数异常影线，再以真实最高价确认突破，避免“未过前高”的伪箱体信号。
f_large_horizontal_range(candidateLength, currentAtr) =>
    int segmentLength = int(candidateLength / 3)
    bool samplesReady = not na(currentAtr) and currentAtr > 0
    array<float> highSamples = array.new_float()
    array<float> lowSamples = array.new_float()
    array<float> earlyHighSamples = array.new_float()
    array<float> middleHighSamples = array.new_float()
    array<float> recentHighSamples = array.new_float()
    array<float> earlyLowSamples = array.new_float()
    array<float> middleLowSamples = array.new_float()
    array<float> recentLowSamples = array.new_float()

    for chronologicalIndex = 0 to candidateLength - 1
        offset = candidateLength - chronologicalIndex
        sampleReady = not na(high[offset]) and not na(low[offset]) and not na(close[offset]) and
             high[offset] >= low[offset] and low[offset] > 0
        samplesReady := samplesReady and sampleReady
        if sampleReady
            array.push(highSamples, high[offset])
            array.push(lowSamples, low[offset])
            if chronologicalIndex < segmentLength
                array.push(earlyHighSamples, high[offset])
                array.push(earlyLowSamples, low[offset])
            else if chronologicalIndex < 2 * segmentLength
                array.push(middleHighSamples, high[offset])
                array.push(middleLowSamples, low[offset])
            else
                array.push(recentHighSamples, high[offset])
                array.push(recentLowSamples, low[offset])

    candidateUpper = samplesReady ? array.percentile_nearest_rank(highSamples, 90) : na
    candidateLower = samplesReady ? array.percentile_nearest_rank(lowSamples, 10) : na
    candidateRawHigh = samplesReady ? array.max(highSamples) : na
    candidateHeight = samplesReady ? candidateUpper - candidateLower : na
    candidateMid = samplesReady ? (candidateUpper + candidateLower) * 0.5 : na
    candidateWidthRatio = samplesReady and candidateMid > 0 ? candidateHeight / candidateMid : na
    touchBand = samplesReady ? math.max(candidateMid * largeHorizontalRangeTouchBandRatio,
         currentAtr * largeHorizontalRangeTouchBandAtr) : na
    int upperTouchGroups = 0
    int lowerTouchGroups = 0
    int lastUpperTouchIndex = na
    int lastLowerTouchIndex = na
    int containedCloses = 0

    if samplesReady
        for chronologicalIndex = 0 to candidateLength - 1
            offset = candidateLength - chronologicalIndex
            if high[offset] >= candidateUpper - touchBand
                if na(lastUpperTouchIndex) or chronologicalIndex - lastUpperTouchIndex >= largeHorizontalRangeTouchGap
                    upperTouchGroups += 1
                lastUpperTouchIndex := chronologicalIndex
            if low[offset] <= candidateLower + touchBand
                if na(lastLowerTouchIndex) or chronologicalIndex - lastLowerTouchIndex >= largeHorizontalRangeTouchGap
                    lowerTouchGroups += 1
                lastLowerTouchIndex := chronologicalIndex
            if close[offset] >= candidateLower - touchBand and close[offset] <= candidateUpper + touchBand
                containedCloses += 1

    containmentRatio = samplesReady ? float(containedCloses) / candidateLength : na
    earlyUpper = samplesReady ? array.percentile_nearest_rank(earlyHighSamples, 90) : na
    middleUpper = samplesReady ? array.percentile_nearest_rank(middleHighSamples, 90) : na
    recentUpper = samplesReady ? array.percentile_nearest_rank(recentHighSamples, 90) : na
    earlyLower = samplesReady ? array.percentile_nearest_rank(earlyLowSamples, 10) : na
    middleLower = samplesReady ? array.percentile_nearest_rank(middleLowSamples, 10) : na
    recentLower = samplesReady ? array.percentile_nearest_rank(recentLowSamples, 10) : na
    upperBoundaryDriftRatio = samplesReady and candidateHeight > 0 ?
         (math.max(earlyUpper, math.max(middleUpper, recentUpper)) -
         math.min(earlyUpper, math.min(middleUpper, recentUpper))) / candidateHeight : na
    lowerBoundaryDriftRatio = samplesReady and candidateHeight > 0 ?
         (math.max(earlyLower, math.max(middleLower, recentLower)) -
         math.min(earlyLower, math.min(middleLower, recentLower))) / candidateHeight : na

    valid = samplesReady and candidateHeight > 0 and
         candidateWidthRatio <= largeHorizontalRangeMaxWidthRatio and
         upperTouchGroups >= 2 and lowerTouchGroups >= 2 and
         containmentRatio >= largeHorizontalRangeContainmentMin and
         upperBoundaryDriftRatio <= largeHorizontalRangeBoundaryDriftMax and
         lowerBoundaryDriftRatio <= largeHorizontalRangeBoundaryDriftMax
    [valid, candidateUpper, candidateLower, candidateRawHigh, candidateWidthRatio,
         containmentRatio, upperBoundaryDriftRatio, lowerBoundaryDriftRatio,
         upperTouchGroups, lowerTouchGroups]

// 历史放量标记只使用各自之前十根原始成交量，避免递归地过滤更早放量 K 线。
rawVolumeAverage = ta.sma(volume, volumeLookback)[1]
rawVolumeSpike = not na(rawVolumeAverage) and rawVolumeAverage > 0 and volume >= volumeEventRatio * rawVolumeAverage

// 当前 K 线的过滤后量比：只保留前十根中自身未被标为放量的历史成交量。
f_filtered_volume_ratio() =>
    float retainedVolume = 0.0
    int retainedCount = 0
    for offset = 1 to volumeLookback
        if not na(volume[offset]) and not rawVolumeSpike[offset]
            retainedVolume += volume[offset]
            retainedCount += 1
    retainedCount >= minValidVolumeSamples and retainedVolume > 0 ? volume / (retainedVolume / retainedCount) : na

filteredVolumeRatio = f_filtered_volume_ratio()
// Pine 的 nearest-rank P90 作用于 t 之前连续 672 根 K 线，当前 K 线不进入基准样本。
weeklyP90 = ta.percentile_nearest_rank(volume[1], weeklyLookback, 90)
weeklyMinVolume = ta.lowest(volume[1], weeklyLookback)
weeklyVolumeReady = bar_index >= weeklyLookback + volumeLookback and not na(weeklyP90) and weeklyMinVolume >= 0
volumeEvent = not na(filteredVolumeRatio) and filteredVolumeRatio >= volumeEventRatio and weeklyVolumeReady and volume > 0 and volume >= weeklyP90

rsi14 = ta.rsi(close, 14)
ema12 = ta.ema(close, 12)
ema144 = ta.ema(close, 144)
ema596 = ta.ema(close, 596)
ema696 = ta.ema(close, 696)
atr14 = ta.atr(14)
bollingerMiddle = ta.sma(close, bollingerLength)
bollingerRange = bollingerDeviation * ta.stdev(close, bollingerLength)
bollingerUpper = bollingerMiddle + bollingerRange
bollingerLower = bollingerMiddle - bollingerRange
[macdLine12_26, macdSignal9, macdHistogram] = ta.macd(close, 12, 26, 9)
macdDeathCross = ta.crossunder(macdLine12_26, macdSignal9)
macdDeathCrossAge = ta.barssince(macdDeathCross)
macdDirectionGuardReady = not na(macdHistogram) and not na(macdHistogram[1]) and
     not na(macdHistogram[2]) and not na(macdHistogram[3])
recentMacdDeathCross = not macdDirectionGuardReady or
     (not na(macdDeathCrossAge) and macdDeathCrossAge < recentMacdDirectionLookback)

// 新扩张分支按用户指定的 EMA596 可视化；旧趋势分支仍计算 EMA696，避免本次新增信号静默改写旧行为。
plot(ema12, "EMA 12", color = color.rgb(38, 166, 154), linewidth = 1)
plot(ema144, "EMA 144", color = color.rgb(255, 152, 0), linewidth = 2)
plot(ema596, "EMA 596", color = color.rgb(171, 71, 188), linewidth = 2)

// 布林带保留真实价格量纲，因此只绘制在 overlay 主图；副图继续使用归一化的 RSI、MACD 与成交量。
bollingerUpperPlot = plot(bollingerUpper, "BOLL Upper 20,2", color = color.new(color.rgb(33, 150, 243), 15), linewidth = 1)
plot(bollingerMiddle, "BOLL Middle 20", color = color.new(color.gray, 25), linewidth = 1)
bollingerLowerPlot = plot(bollingerLower, "BOLL Lower 20,2", color = color.new(color.rgb(33, 150, 243), 15), linewidth = 1)
fill(bollingerUpperPlot, bollingerLowerPlot, color = color.new(color.rgb(33, 150, 243), 92), title = "BOLL Band 20,2")

// 只扫描 t 之前的 48 根已完成 K 线，并按结束位置从近到远选取第一个有效确认窗。
bool sidewaysZoneFound = false
float sidewaysZoneHigh = na
float sidewaysZoneLow = na
float sidewaysZoneWidthRatio = na
int sidewaysZoneUpperTouchGroups = na
int sidewaysZoneLowerTouchGroups = na
int sidewaysZoneStartOffset = na
int sidewaysZoneEndOffset = na
for candidateEndOffset = 1 to counterTrendRangeLookback - counterTrendRangeLength + 1
    [candidateValid, candidateHigh, candidateLow, candidateWidthRatio, candidateUpperTouches, candidateLowerTouches] =
         f_sideways_window(candidateEndOffset)
    if not sidewaysZoneFound and candidateValid
        sidewaysZoneFound := true
        sidewaysZoneHigh := candidateHigh
        sidewaysZoneLow := candidateLow
        sidewaysZoneWidthRatio := candidateWidthRatio
        sidewaysZoneUpperTouchGroups := candidateUpperTouches
        sidewaysZoneLowerTouchGroups := candidateLowerTouches
        sidewaysZoneStartOffset := candidateEndOffset + counterTrendRangeLength - 1
        sidewaysZoneEndOffset := candidateEndOffset

// fresh 只评估“从近到远找到的第一个有效横盘区”。最近区不 fresh 时禁止回退挑选更老区间，
// 否则同一根信号会因退出规则而悄悄改写 nearest-sideways 的既有结构归属。
int freshBreakdownAge = sidewaysZoneFound ?
     f_held_break_age(sidewaysZoneEndOffset, sidewaysZoneLow, true) : na
int freshBreakoutAge = sidewaysZoneFound ?
     f_held_break_age(sidewaysZoneEndOffset, sidewaysZoneHigh, false) : na
bool freshBreakdownZoneFound = sidewaysZoneFound and not na(freshBreakdownAge)
bool freshBreakoutZoneFound = sidewaysZoneFound and not na(freshBreakoutAge)
float freshBreakdownZoneHigh = freshBreakdownZoneFound ? sidewaysZoneHigh : na
float freshBreakdownZoneLow = freshBreakdownZoneFound ? sidewaysZoneLow : na
int freshBreakdownZoneStartOffset = freshBreakdownZoneFound ? sidewaysZoneStartOffset : na
int freshBreakdownZoneEndOffset = freshBreakdownZoneFound ? sidewaysZoneEndOffset : na
float freshBreakoutZoneHigh = freshBreakoutZoneFound ? sidewaysZoneHigh : na
float freshBreakoutZoneLow = freshBreakoutZoneFound ? sidewaysZoneLow : na
int freshBreakoutZoneStartOffset = freshBreakoutZoneFound ? sidewaysZoneStartOffset : na
int freshBreakoutZoneEndOffset = freshBreakoutZoneFound ? sidewaysZoneEndOffset : na

// 从 t-5 向过去搜索并在首个完整量能事件处停止；窗口包含 t-5/t-32，t-1～t-4 不具备锚点资格。
int qOffset = na
if volumeEvent
    for offset = anchorMinDistance to anchorLookback
        if na(qOffset) and volumeEvent[offset]
            qOffset := offset

float qHigh = na
float qLow = na
float qRsi = na
float qAtr = na
if not na(qOffset)
    qHigh := high[qOffset]
    qLow := low[qOffset]
    qRsi := rsi14[qOffset]
    qAtr := atr14[qOffset]

// 固定间隔不能证明 q/t 属于两个独立波段；同时记录中间价格摆动，以免把连续下跌或上涨中的微小插针误判为背离。
float pathRsiMin = na
float pathRsiMax = na
float pathPriceHigh = na
float pathPriceLow = na
bool pathRsiComplete = not na(qOffset)
if not na(qOffset)
    for offset = 1 to anchorLookback - 1
        if offset < qOffset
            pathRsi = rsi14[offset]
            if na(pathRsi)
                pathRsiComplete := false
            else
                pathRsiMin := na(pathRsiMin) ? pathRsi : math.min(pathRsiMin, pathRsi)
                pathRsiMax := na(pathRsiMax) ? pathRsi : math.max(pathRsiMax, pathRsi)
            pathPriceHigh := na(pathPriceHigh) ? high[offset] : math.max(pathPriceHigh, high[offset])
            pathPriceLow := na(pathPriceLow) ? low[offset] : math.min(pathPriceLow, low[offset])

topDivergenceRsiPathValid = pathRsiComplete and not na(pathRsiMin) and pathRsiMin >= divergenceRsiMidline
bottomDivergenceRsiPathValid = pathRsiComplete and not na(pathRsiMax) and pathRsiMax <= divergenceRsiMidline
divergenceAtrScale = not na(atr14) and atr14 > 0 and not na(qAtr) and qAtr > 0 ? math.max(atr14, qAtr) : na
bearishBreakDistance = not na(qHigh) ? high - qHigh : na
bullishBreakDistance = not na(qLow) ? qLow - low : na
bearishBreakRatio = not na(bearishBreakDistance) and qHigh > 0 ? bearishBreakDistance / qHigh : na
bullishBreakRatio = not na(bullishBreakDistance) and qLow > 0 ? bullishBreakDistance / qLow : na
bearishBreakAtr = not na(divergenceAtrScale) ? bearishBreakDistance / divergenceAtrScale : na
bullishBreakAtr = not na(divergenceAtrScale) ? bullishBreakDistance / divergenceAtrScale : na
bearishIntermediateSwingAtr = not na(divergenceAtrScale) and not na(pathPriceLow) ? (qHigh - pathPriceLow) / divergenceAtrScale : na
bullishIntermediateSwingAtr = not na(divergenceAtrScale) and not na(pathPriceHigh) ? (pathPriceHigh - qLow) / divergenceAtrScale : na

// 0.35% 创新和双 ATR 门槛负责排除微小插针并证明独立波段；最近 q 不合格时仍禁止回退。
// q/t 仅相隔 5～7 根时属于弱背离，必须在信号棒收盘收回锚点极值；完整背离保留原结构确认。
bearishDivergencePriceValid = not na(bearishBreakRatio) and bearishBreakRatio >= divergenceMinBreakRatio and
     bearishBreakAtr >= divergenceMinBreakAtr and bearishIntermediateSwingAtr >= divergenceMinIntermediateSwingAtr
bullishDivergencePriceValid = not na(bullishBreakRatio) and bullishBreakRatio >= divergenceMinBreakRatio and
     bullishBreakAtr >= divergenceMinBreakAtr and bullishIntermediateSwingAtr >= divergenceMinIntermediateSwingAtr
bearishDivergenceReclaimed = not na(qHigh) and close < qHigh
bullishDivergenceReclaimed = not na(qLow) and close > qLow
rawRsiBearishDivergence = volumeEvent and not na(qOffset) and topDivergenceRsiPathValid and bearishDivergencePriceValid and
     rsi14 > 60 and qRsi >= 70 and high > qHigh and rsi14 < qRsi
rawRsiBullishDivergence = volumeEvent and not na(qOffset) and bottomDivergenceRsiPathValid and bullishDivergencePriceValid and
     rsi14 < 40 and qRsi <= 30 and low < qLow and rsi14 > qRsi
bearishDivergenceWeak = not na(qOffset) and qOffset <= divergenceWeakMaxGap
bullishDivergenceWeak = not na(qOffset) and qOffset <= divergenceWeakMaxGap

// 形态只使用已完成的 t（吞没额外读取 t-1），并且在 OHLC 非法时整体关闭。
candleValid = high >= math.max(open, close) and low <= math.min(open, close) and high > low and open > 0
previousCandleValid = high[1] >= math.max(open[1], close[1]) and low[1] <= math.min(open[1], close[1]) and high[1] > low[1] and open[1] > 0
candleRange = high - low
body = math.abs(close - open)
bodyRangeRatio = candleValid ? body / candleRange : na
bodyOpenRatio = candleValid ? body / open : na
upperShadow = high - math.max(open, close)
lowerShadow = math.min(open, close) - low
isDoji = candleValid and bodyRangeRatio <= 0.10
isModerateLargeBody = candleValid and bodyRangeRatio >= 0.60 and bodyOpenRatio > 0.01 and bodyOpenRatio < 0.03
longUpperShadow = candleValid and not isDoji and upperShadow / candleRange >= 0.60 and upperShadow > lowerShadow
longLowerShadow = candleValid and not isDoji and lowerShadow / candleRange >= 0.60 and lowerShadow > upperShadow
bullishEngulfing = candleValid and previousCandleValid and close[1] < open[1] and close > open and open <= close[1] and close >= open[1]
bearishEngulfing = candleValid and previousCandleValid and close[1] > open[1] and close < open and open >= close[1] and close <= open[1]
// V7 区分“实体几何吞没”和“可交易反转吞没”：方向相反的长影代表拒绝，
// 只阻断 RSI 形态/背离家族，不能污染三棒反包或其他独立信号。
acceptedBullishEngulfing = bullishEngulfing and not longUpperShadow
acceptedBearishEngulfing = bearishEngulfing and not longLowerShadow
bullishReversalPattern = acceptedBullishEngulfing or longLowerShadow
bearishReversalPattern = acceptedBearishEngulfing or longUpperShadow

// 背离本身只证明价量/动量相对变化；V4 还要求信号棒给出方向性拒绝。
// 25% 影线明显低于既有“长影线”60%门槛，允许温和反转，同时以2 tick排除几乎无意义的细小影线。
divergenceDirectionalShadowThreshold = math.max(
     divergenceDirectionalShadowMinTicks * syminfo.mintick,
     divergenceDirectionalShadowMin * candleRange)
bullishDivergenceCandleGate = candleValid and
     (close > open or lowerShadow >= divergenceDirectionalShadowThreshold)
bearishDivergenceCandleGate = candleValid and
     (close < open or upperShadow >= divergenceDirectionalShadowThreshold)
rsiBearishDivergence = rawRsiBearishDivergence and bearishDivergenceCandleGate and not longLowerShadow and
     (not bearishDivergenceWeak or bearishDivergenceReclaimed)
// 底背离还保留三根 MACD 死叉门禁，避免仅凭一根拒绝棒逆着重新增强的下行动量抢反转。
rsiBullishDivergence = rawRsiBullishDivergence and bullishDivergenceCandleGate and not longUpperShadow and
     (not bullishDivergenceWeak or bullishDivergenceReclaimed) and not recentMacdDeathCross

// q 先仅按 t-20～t-80 的最高价唯一确定；同高保留最近一根，后续条件失败时不得回退挑选更老锚点。
// 这让锚点选择不受当前量能、RSI 或收益结果反向影响，避免在窗口内事后挑选最有利对照点。
bool effortNoResultAnchorHistoryReady = true
int effortNoResultAnchorOffset = na
float effortNoResultAnchorHigh = na
for offset = effortNoResultAnchorMinDistance to effortNoResultAnchorMaxDistance
    candidateHigh = high[offset]
    if na(candidateHigh)
        effortNoResultAnchorHistoryReady := false
    else if na(effortNoResultAnchorHigh) or candidateHigh > effortNoResultAnchorHigh
        effortNoResultAnchorHigh := candidateHigh
        effortNoResultAnchorOffset := offset

float effortNoResultAnchorVolume = na
float effortNoResultAnchorRsi = na
if not na(effortNoResultAnchorOffset)
    effortNoResultAnchorVolume := volume[effortNoResultAnchorOffset]
    effortNoResultAnchorRsi := rsi14[effortNoResultAnchorOffset]

effortNoResultHighGap = not na(effortNoResultAnchorHigh) ? effortNoResultAnchorHigh - high : na
effortNoResultHighGapRatio = not na(effortNoResultHighGap) and effortNoResultAnchorHigh > 0 ?
     effortNoResultHighGap / effortNoResultAnchorHigh : na
effortNoResultHighGapAtr = not na(effortNoResultHighGap) and not na(atr14) and atr14 > 0 ?
     effortNoResultHighGap / atr14 : na
// 用户定义中的“0.5% 或 0.5 ATR”按字面 OR 实现；任一尺度足够接近即可通过。
effortNoResultLowerHighNear = not na(effortNoResultHighGap) and effortNoResultHighGap > 0 and
     (effortNoResultHighGapRatio <= effortNoResultMaxGapRatio or
     effortNoResultHighGapAtr <= effortNoResultMaxGapAtr)
effortNoResultVolumeMultiple = not na(effortNoResultAnchorVolume) and effortNoResultAnchorVolume > 0 ?
     volume / effortNoResultAnchorVolume : na
effortNoResultBearBodyAtr = candleValid and close < open and not na(atr14) and atr14 > 0 ?
     (open - close) / atr14 : na
effortNoResultCloseLocation = candleValid ? (close - low) / candleRange : na
effortNoResultUpperBandReclaim = not na(bollingerUpper) and high > bollingerUpper and close < bollingerUpper

// 该结构是“量价努力无结果”，不是要求价格创新高的 RSI 顶背离；只在 t 收盘后确认。
effortNoResultShortSetup = barstate.isconfirmed and effortNoResultAnchorHistoryReady and
     not na(effortNoResultAnchorOffset) and candleValid and volumeEvent and
     effortNoResultLowerHighNear and
     effortNoResultVolumeMultiple >= effortNoResultVolumeMultiplierMin and
     effortNoResultAnchorRsi >= effortNoResultAnchorRsiMin and
     rsi14 >= effortNoResultSignalRsiMin and rsi14 <= effortNoResultSignalRsiMax and
     rsi14 < effortNoResultAnchorRsi and close < open and
     bodyRangeRatio >= effortNoResultBodyRangeMin and
     effortNoResultBearBodyAtr >= effortNoResultBodyAtrMin and
     effortNoResultCloseLocation <= effortNoResultCloseLocationMax and
     effortNoResultUpperBandReclaim
effortNoResultStop = effortNoResultShortSetup ?
     f_round_short_stop(math.max(effortNoResultAnchorHigh, high) + syminfo.mintick) : na

// 该分支识别“放量卖出高潮后的三棒下跌冲击反包”，不要求前三根机械地全为阴线，
// 但当前强阳必须吞没三根实体包络，并在底部同时完成量能、趋势与动量收回确认。
threeBarHistoryValid = previousCandleValid and
     high[2] >= math.max(open[2], close[2]) and low[2] <= math.min(open[2], close[2]) and high[2] > low[2] and open[2] > 0 and
     high[3] >= math.max(open[3], close[3]) and low[3] <= math.min(open[3], close[3]) and high[3] > low[3] and open[3] > 0
threeBarBearCount = (close[1] < open[1] ? 1 : 0) + (close[2] < open[2] ? 1 : 0) + (close[3] < open[3] ? 1 : 0)
threeBarBodyLow = math.min(math.min(open[1], close[1]), math.min(math.min(open[2], close[2]), math.min(open[3], close[3])))
threeBarBodyHigh = math.max(math.max(open[1], close[1]), math.max(math.max(open[2], close[2]), math.max(open[3], close[3])))
threeBarPatternLow = math.min(low, math.min(low[1], math.min(low[2], low[3])))
threeBarPrior48Low = ta.lowest(low[1], 48)
threeBarEngulfBodyAtr = not na(atr14) and atr14 > 0 ? body / atr14 : na
threeBarEngulfCloseLocation = candleValid ? (close - low) / candleRange : na
threeBarEngulfDownRegime = ema12[1] < ema144[1] and ema144[1] < ema596[1] and
     ema12[1] < ema12[4] and ema144[1] < ema144[4] and ema596[1] < ema596[4] and
     close[1] < close[48]
threeBarEngulfBottomLocation = not na(threeBarPrior48Low) and not na(atr14) and atr14 > 0 and
     threeBarPatternLow <= threeBarPrior48Low + threeBarEngulfBottomBandAtr * atr14
rsiCrossedMidlineUp = ta.crossover(rsi14, divergenceRsiMidline)
threeBarEngulfReversalLong = barstate.isconfirmed and candleValid and threeBarHistoryValid and
     close > open and threeBarBearCount >= 2 and close[1] < open[3] and
     open <= threeBarBodyLow and close >= threeBarBodyHigh and
     bodyRangeRatio >= threeBarEngulfMinBodyRangeRatio and
     threeBarEngulfBodyAtr >= threeBarEngulfMinBodyAtr and
     threeBarEngulfCloseLocation >= threeBarEngulfMinCloseLocation and
     volumeEvent[1] and not na(filteredVolumeRatio) and filteredVolumeRatio >= volumeEventRatio and
     threeBarEngulfDownRegime and threeBarEngulfBottomLocation and
     close > ema12 and close > bollingerMiddle and rsiCrossedMidlineUp

// 该分支只读取 t-1～t-48 的价格区间；信号棒不能用自身低点重新定义“区间底部”。
bollingerLowerReclaimPriorHigh = ta.highest(high[1], bollingerLowerReclaimLocationLookback)
bollingerLowerReclaimPriorLow = ta.lowest(low[1], bollingerLowerReclaimLocationLookback)
bollingerLowerReclaimPriorRange = bollingerLowerReclaimPriorHigh - bollingerLowerReclaimPriorLow
bollingerLowerReclaimBottomPosition = not na(bollingerLowerReclaimPriorRange) and
     bollingerLowerReclaimPriorRange > 0 ?
     math.max(0.0, (low - bollingerLowerReclaimPriorLow) / bollingerLowerReclaimPriorRange) : na
bollingerLowerReclaimShadowRatio = candleValid ? lowerShadow / candleRange : na
bollingerLowerReclaimCloseLocation = candleValid ? (close - low) / candleRange : na
bollingerLowerReclaimRsiRising = rsi14 >= bollingerLowerReclaimRsiMin and
     rsi14 <= bollingerLowerReclaimRsiMax and rsi14 > rsi14[1] and rsi14[1] > rsi14[2]
// V1 只把连续缩短的负柱视为下跌动量衰减，避免把正柱减弱误标为多头改善。
bollingerLowerReclaimMacdContracting = macdHistogram < 0 and macdHistogram[1] < 0 and
     macdHistogram[2] < 0 and macdHistogram > macdHistogram[1] and
     macdHistogram[1] > macdHistogram[2]
bollingerLowerReclaimStop = f_round_long_stop(low - syminfo.mintick)
bollingerLowerReclaimTarget = f_round_long_target(bollingerMiddle)
bollingerLowerReclaimRisk = close - bollingerLowerReclaimStop
bollingerLowerReclaimReward = bollingerLowerReclaimTarget - close
bollingerLowerReclaimRewardRisk = bollingerLowerReclaimRisk > 0 ?
     bollingerLowerReclaimReward / bollingerLowerReclaimRisk : na
// t+1 开盘尚不可见，1.1R 只能以 t 收盘预检；绝不读取下一根开盘反向决定历史信号。
bollingerLowerReclaimLong = barstate.isconfirmed and candleValid and volumeEvent and
     low < bollingerLower and close > bollingerLower and
     bollingerLowerReclaimShadowRatio >= bollingerLowerReclaimShadowMin and
     bollingerLowerReclaimCloseLocation >= bollingerLowerReclaimCloseLocationMin and
     bollingerLowerReclaimBottomPosition <= bollingerLowerReclaimBottomPositionMax and
     bollingerLowerReclaimRsiRising and bollingerLowerReclaimMacdContracting and
     bollingerLowerReclaimTarget > close and
     bollingerLowerReclaimRewardRisk >= bollingerLowerReclaimMinRewardRisk

// 现有 RSI 与 EMA696 趋势分支继续受量能门槛约束；EMA596 压缩扩张是后文单独计算的新假设。
rsiPatternLong = volumeEvent and not rsiBearishDivergence and not rsiBullishDivergence and rsi14 <= 30 and bullishReversalPattern
rawRsiPatternShort = volumeEvent and not rsiBearishDivergence and not rsiBullishDivergence and rsi14 >= 70 and bearishReversalPattern

// t-4～t 的五根已完成 K 线共同描述刚启动的多头制度切换；两个上穿可发生在窗口内不同 K 线上。
// 保护只拦截 RSI 超买形态空单，结构性顶背离、EMA 空头趋势与假突破空单仍按各自证据独立判断。
strongBullishVolumeImpulse = barstate.isconfirmed and volumeEvent and filteredVolumeRatio >= bullishTransitionImpulseVolumeRatio and
     close > open and not na(atr14) and atr14 > 0 and (close - open) / atr14 >= bullishTransitionImpulseBodyAtr
ema12Crossed144Up = ta.crossover(ema12, ema144)
ema12Crossed596Up = ta.crossover(ema12, ema596)
barsSinceBullishVolumeImpulse = ta.barssince(strongBullishVolumeImpulse)
barsSinceEma12Crossed144Up = ta.barssince(ema12Crossed144Up)
barsSinceEma12Crossed596Up = ta.barssince(ema12Crossed596Up)
recentBullishVolumeImpulse = not na(barsSinceBullishVolumeImpulse) and barsSinceBullishVolumeImpulse < bullishTransitionProtectionWindow
recentEma12Crossed144Up = not na(barsSinceEma12Crossed144Up) and barsSinceEma12Crossed144Up < bullishTransitionProtectionWindow
recentEma12Crossed596Up = not na(barsSinceEma12Crossed596Up) and barsSinceEma12Crossed596Up < bullishTransitionProtectionWindow
recentBullishVolumeEmaTransition = recentBullishVolumeImpulse and recentEma12Crossed144Up and recentEma12Crossed596Up and
     ema12 > ema144 and ema12 > ema596 and close > ema12
rsiPatternShort = rawRsiPatternShort and not recentBullishVolumeEmaTransition
rsiLong = rsiBullishDivergence or rsiPatternLong
rsiShort = rsiBearishDivergence or rsiPatternShort
emaLong = volumeEvent and ema12 > ema144 and ema144 > ema696 and close > ema12 and close > open and isModerateLargeBody and rsi14 < 70
emaShort = volumeEvent and ema12 < ema144 and ema144 < ema696 and close < ema12 and close < open and isModerateLargeBody and rsi14 > 30

// 首根放量长上影只是观察锚点；只有后续完成多次独立测试并再次扫高收回，才把它升级为可交易假突破。
// 锚点必须在当时触发多头切换保护，避免用本分支绕回已经证伪的首次拒绝空单。
int transitionSweepAnchorOffset = na
float transitionSweepAnchorPriorHigh = na
for offset = transitionSweepAnchorMinDistance to transitionSweepAnchorMaxDistance
    float candidatePriorHigh = na
    bool candidateHistoryReady = true
    for priorOffset = 1 to transitionSweepPriorHighLookback
        candidateHighSample = high[offset + priorOffset]
        if na(candidateHighSample)
            candidateHistoryReady := false
        else
            candidatePriorHigh := na(candidatePriorHigh) ? candidateHighSample : math.max(candidatePriorHigh, candidateHighSample)

    candidateRange = high[offset] - low[offset]
    candidateBody = math.abs(close[offset] - open[offset])
    candidateUpperShadow = high[offset] - math.max(open[offset], close[offset])
    candidateLowerShadow = math.min(open[offset], close[offset]) - low[offset]
    candidateLongUpperShadow = candidateRange > 0 and candidateBody / candidateRange > 0.10 and
         candidateUpperShadow / candidateRange >= 0.60 and candidateUpperShadow > candidateLowerShadow
    candidateAnchor = candidateHistoryReady and volumeEvent[offset] and recentBullishVolumeEmaTransition[offset] and
         rsi14[offset] >= transitionSweepAnchorRsiMin and candidateLongUpperShadow and
         high[offset] > candidatePriorHigh and close[offset] < candidatePriorHigh
    if na(transitionSweepAnchorOffset) and candidateAnchor
        transitionSweepAnchorOffset := offset
        transitionSweepAnchorPriorHigh := candidatePriorHigh

float transitionSweepAnchorHigh = na
float transitionSweepAnchorRsi = na
float transitionSweepAnchorAtr = na
float transitionSweepAnchorVolumeRatio = na
float transitionSweepTouchBand = na
float transitionSweepConsolidationLow = na
int transitionSweepTouchGroups = 0
int transitionSweepLastTouchOffset = na
if not na(transitionSweepAnchorOffset)
    transitionSweepAnchorHigh := high[transitionSweepAnchorOffset]
    transitionSweepAnchorRsi := rsi14[transitionSweepAnchorOffset]
    transitionSweepAnchorAtr := atr14[transitionSweepAnchorOffset]
    transitionSweepAnchorVolumeRatio := filteredVolumeRatio[transitionSweepAnchorOffset]
    transitionSweepTouchBand := math.max(
         transitionSweepAnchorHigh * transitionSweepTouchBandRatio,
         transitionSweepAnchorAtr * transitionSweepTouchBandAtr)

    // 从近到远统计不会改变“至少间隔2根”的分组结果；路径低点只读取锚点和信号之间的已完成K线。
    for pathOffset = 1 to transitionSweepAnchorMaxDistance - 1
        if pathOffset < transitionSweepAnchorOffset
            transitionSweepConsolidationLow := na(transitionSweepConsolidationLow) ?
                 low[pathOffset] : math.min(transitionSweepConsolidationLow, low[pathOffset])
            touchesAnchor = high[pathOffset] >= transitionSweepAnchorHigh - transitionSweepTouchBand and
                 high[pathOffset] <= transitionSweepAnchorHigh and close[pathOffset] < transitionSweepAnchorHigh
            if touchesAnchor
                if na(transitionSweepLastTouchOffset) or pathOffset - transitionSweepLastTouchOffset >= transitionSweepTouchGap
                    transitionSweepTouchGroups += 1
                transitionSweepLastTouchOffset := pathOffset

transitionLiquiditySweepShort = barstate.isconfirmed and not na(transitionSweepAnchorOffset) and
     transitionSweepTouchGroups >= transitionSweepMinTouchGroups and
     high > transitionSweepAnchorHigh and close < transitionSweepAnchorHigh and
     rsi14 >= transitionSweepSignalRsiMin and rsi14 < transitionSweepAnchorRsi and
     ema12 > ema144 and ema12 > ema596 and close > ema12 and
     not na(transitionSweepConsolidationLow) and transitionSweepConsolidationLow < close

// 压缩只读取 t 之前12根，信号棒本身不参与“此前几乎重合”的判定，避免下跌后反向美化 setup。
emaCompressionDistanceAtr = not na(atr14) and atr14 > 0 ? math.abs(ema12 - ema596) / atr14 : na
emaCompressionMeanDistanceAtr = ta.sma(emaCompressionDistanceAtr[1], emaCompressionLookback)
emaCompressionMaxDistanceAtr = ta.highest(emaCompressionDistanceAtr[1], emaCompressionLookback)
emaCompressionMinDistanceAtr = ta.lowest(emaCompressionDistanceAtr[1], emaCompressionLookback)
emaCompressionReady = not na(emaCompressionMeanDistanceAtr) and
     emaCompressionMeanDistanceAtr <= emaCompressionMeanAtrMax and
     emaCompressionMaxDistanceAtr <= emaCompressionMaxAtrMax and
     emaCompressionMinDistanceAtr <= emaCompressionTouchAtrMax

ema12SlopeAtr = not na(atr14) and atr14 > 0 ? (ema12 - ema12[emaSlopeLookback]) / (emaSlopeLookback * atr14) : na
ema144SlopeAtr = not na(atr14) and atr14 > 0 ? (ema144 - ema144[emaSlopeLookback]) / (emaSlopeLookback * atr14) : na
ema596SlopeAtr = not na(atr14) and atr14 > 0 ? (ema596 - ema596[emaSlopeLookback]) / (emaSlopeLookback * atr14) : na
emaSlopesReady = not na(ema12SlopeAtr) and not na(ema144SlopeAtr) and not na(ema596SlopeAtr) and
     not na(ema12SlopeAtr[1]) and not na(ema144SlopeAtr[1]) and not na(ema596SlopeAtr[1])
emaSlopeMagnitudesExpanding = emaSlopesReady and
     math.abs(ema12SlopeAtr) >= math.abs(ema12SlopeAtr[1]) * emaSlopeAccelerationMin and
     math.abs(ema144SlopeAtr) >= math.abs(ema144SlopeAtr[1]) * emaSlopeAccelerationMin and
     math.abs(ema596SlopeAtr) >= math.abs(ema596SlopeAtr[1]) * emaSlopeAccelerationMin
emaLongSpreadsExpanding = ema12 - ema144 > ema12[1] - ema144[1] and
     ema12 - ema596 > ema12[1] - ema596[1]
emaShortSpreadsExpanding = ema144 - ema12 > ema144[1] - ema12[1] and
     ema596 - ema12 > ema596[1] - ema12[1]
emaExpansionPriorStructureLow = ta.lowest(low[1], emaExpansionStructureLookback)
emaExpansionShortStructureAccepted = not na(emaExpansionPriorStructureLow) and
     close < emaExpansionPriorStructureLow

emaExpansionLongState = emaCompressionReady and emaSlopeMagnitudesExpanding and
     ema12SlopeAtr >= ema12SlopeAtrMin and ema144SlopeAtr >= ema144SlopeAtrMin and ema596SlopeAtr >= ema596SlopeAtrMin and
     ema12 > ema144 and ema12 > ema596 and emaLongSpreadsExpanding and close > ema12 and close > open and
     not recentMacdDeathCross
// 斜率同步向下只能证明方向，不能证明横盘支撑已被市场接受性跌破。
// V3 冻结读取 t 之前20根的最低点，并要求信号棒收盘严格位于其下方；影线刺破不算。
emaExpansionShortState = emaCompressionReady and emaSlopeMagnitudesExpanding and
     ema12SlopeAtr <= -ema12SlopeAtrMin and ema144SlopeAtr <= -ema144SlopeAtrMin and ema596SlopeAtr <= -ema596SlopeAtrMin and
     ema12 < ema144 and ema12 < ema596 and emaShortSpreadsExpanding and close < ema12 and close < open and
     emaExpansionShortStructureAccepted

// 同一次扩张只取状态首次成立的一根；12根冷却覆盖完整压缩窗，避免短暂反抽后重复追同一段趋势。
var int lastEmaExpansionSignalBar = na
emaExpansionCooldownReady = na(lastEmaExpansionSignalBar) or bar_index - lastEmaExpansionSignalBar > emaExpansionCooldown
emaCompressionExpansionLong = barstate.isconfirmed and emaExpansionCooldownReady and
     emaExpansionLongState and not emaExpansionLongState[1]
emaCompressionExpansionShort = barstate.isconfirmed and emaExpansionCooldownReady and
     emaExpansionShortState and not emaExpansionShortState[1]
if emaCompressionExpansionLong or emaCompressionExpansionShort
    lastEmaExpansionSignalBar := bar_index

// 收复发生后允许最多观察一个8小时交易段；窗口内任一收盘重新跌回EMA596即宣告接受失败。
// 当前棒必须从贴线状态一次性扩张至1 ATR之外，避免在已经远离均线的成熟趋势中重复追涨。
ema596PriceCrossedUp = ta.crossover(close, ema596)
ema596ReclaimAge = ta.barssince(ema596PriceCrossedUp)
bool ema596ReclaimHeld = not na(ema596ReclaimAge) and ema596ReclaimAge <= ema596ReclaimMaxAge
for offset = 0 to ema596ReclaimMaxAge
    if ema596ReclaimHeld and offset <= ema596ReclaimAge and close[offset] <= ema596[offset]
        ema596ReclaimHeld := false

ema596DeparturePreviousDistanceAtr = not na(atr14[1]) and atr14[1] > 0 ?
     (close[1] - ema596[1]) / atr14[1] : na
ema596DepartureCurrentDistanceAtr = not na(atr14) and atr14 > 0 ?
     (close - ema596) / atr14 : na
ema596DeparturePriorHigh = ta.highest(high[1], ema596DepartureStructureLookback)
ema596DeparturePriorLow = ta.lowest(low[1], ema596DepartureStructureLookback)
ema596DepartureMedianVolume = ta.percentile_nearest_rank(
     volume[1], ema596DepartureVolumeMedianLookback, 50)
ema596DepartureMedianVolumeRatio = not na(ema596DepartureMedianVolume) and ema596DepartureMedianVolume > 0 ?
     volume / ema596DepartureMedianVolume : na
ema596DepartureVolumeReady = weeklyVolumeReady and volume >= weeklyP90 and
     ema596DepartureMedianVolumeRatio >= ema596DepartureMedianVolumeRatioMin
ema596DepartureStructureReady = close > ema596DeparturePriorHigh and
     high > high[1] and low > low[1]
// 只读取信号前已经完成的慢均线方向；信号大阳线不能反过来替下跌趋势中的追涨入场洗白。
ema596DeparturePriorSlowBearTrend = emaSlopesReady and
     ema144SlopeAtr[1] <= -ema144SlopeAtrMin and
     ema596SlopeAtr[1] <= -ema596SlopeAtrMin
ema596ReclaimDepartureStop = f_round_long_stop(ema596DeparturePriorLow - syminfo.mintick)
ema596ReclaimDepartureRisk = close - ema596ReclaimDepartureStop
ema596ReclaimDepartureTarget = f_round_long_target(
     close + ema596DepartureTargetRisk * ema596ReclaimDepartureRisk)

// V2 要求 EMA596 在信号前已经被收复：前棒仍在线下时，负离轨值不能再天然通过“<= 0.5 ATR”。
// 该分支仍不要求完整量能事件，避免刚经历抛售后被均值污染的基准误杀。
ema596ReclaimDepartureLongSetup = barstate.isconfirmed and candleValid and
     ema596ReclaimHeld and ema596ReclaimAge >= 1 and ema596DepartureVolumeReady and
     ema596DeparturePreviousDistanceAtr > 0 and
     ema596DeparturePreviousDistanceAtr <= ema596DeparturePreviousDistanceAtrMax and
     ema596DepartureCurrentDistanceAtr >= ema596DepartureCurrentDistanceAtrMin and
     not ema596DeparturePriorSlowBearTrend and
     ema596DepartureStructureReady and close > open and
     bodyRangeRatio >= ema596DepartureBodyRangeMin and
     ema596ReclaimDepartureRisk > 0 and ema596ReclaimDepartureTarget > close

// Z 与 D_min 尚未经过发布回测，规范要求 MACD 背离默认关闭，故不在图表版中生成其候选。
hasLong = rsiLong or emaLong
hasShort = rsiShort or emaShort
patternLongParticipated = rsiPatternLong
patternShortParticipated = rsiPatternShort

// 规范只给出量比不低于 3 的固定 ATR 止盈档位；2.5 <= ratio < 3 仅保留观察，不创建订单。
takeProfitAtr = filteredVolumeRatio >= 6 ? 4.5 : filteredVolumeRatio >= 4 ? 3.6 : filteredVolumeRatio >= 3 ? 2.7 : na

// 大型水平箱体研究的是长期均线尚未完成多头排列时的结构突破，因此只要求收盘站上EMA696，不要求EMA144已在其上方。
largeHorizontalRangeMomentumGate = barstate.isconfirmed and volumeEvent and not na(takeProfitAtr) and close > open and
     rsi14[1] < largeHorizontalRangeBreakoutRsiMin and
     rsi14 >= largeHorizontalRangeBreakoutRsiMin and rsi14 <= largeHorizontalRangeBreakoutRsiMax and
     ema12 > ema144 and ema12[1] <= ema144[1] and close > ema696
bool largeHorizontalRangeBreakoutLong = false
int largeHorizontalRangeSelectedLength = na
float largeHorizontalRangeUpper = na
float largeHorizontalRangeLower = na
float largeHorizontalRangeRawHigh = na
float largeHorizontalRangeWidthRatio = na
float largeHorizontalRangeContainmentRatio = na
float largeHorizontalRangeUpperDriftRatio = na
float largeHorizontalRangeLowerDriftRatio = na
int largeHorizontalRangeUpperTouchGroups = na
int largeHorizontalRangeLowerTouchGroups = na
if largeHorizontalRangeMomentumGate
    for candidateLength = largeHorizontalRangeLookbackMin to largeHorizontalRangeLookbackMax by largeHorizontalRangeLookbackStep
        [candidateValid, candidateUpper, candidateLower, candidateRawHigh, candidateWidthRatio,
             candidateContainmentRatio, candidateUpperDriftRatio, candidateLowerDriftRatio,
             candidateUpperTouchGroups, candidateLowerTouchGroups] =
             f_large_horizontal_range(candidateLength, atr14)
        // 稳健上沿负责识别箱体，收盘还必须越过窗口真实最高价；最长有效窗口代表当前可确认的大结构。
        if candidateValid and close > candidateRawHigh
            largeHorizontalRangeBreakoutLong := true
            largeHorizontalRangeSelectedLength := candidateLength
            largeHorizontalRangeUpper := candidateUpper
            largeHorizontalRangeLower := candidateLower
            largeHorizontalRangeRawHigh := candidateRawHigh
            largeHorizontalRangeWidthRatio := candidateWidthRatio
            largeHorizontalRangeContainmentRatio := candidateContainmentRatio
            largeHorizontalRangeUpperDriftRatio := candidateUpperDriftRatio
            largeHorizontalRangeLowerDriftRatio := candidateLowerDriftRatio
            largeHorizontalRangeUpperTouchGroups := candidateUpperTouchGroups
            largeHorizontalRangeLowerTouchGroups := candidateLowerTouchGroups

// 大型三角只在动量、量能和“本根刚上穿”门禁已满足时扫描，既减少历史计算，也不会借后续K线回填信号。
largeTriangleMomentumGate = barstate.isconfirmed and volumeEvent and not na(takeProfitAtr) and close > open and
     rsi14[1] < largeTriangleBreakoutRsiMin and
     rsi14 >= largeTriangleBreakoutRsiMin and rsi14 <= largeTriangleBreakoutRsiMax and
     ema12 > ema144 and ema12[1] <= ema144[1] and ema144 > ema696
bool largeTriangleBreakoutLong = false
int largeTriangleSelectedLength = na
float largeTriangleResistance = na
float largeTriangleEarlyLow = na
float largeTriangleMiddleLow = na
float largeTriangleRecentLow = na
float largeTriangleResistanceSpreadRatio = na
float largeTriangleContractionRatio = na
int largeTriangleUpperTouchGroups = na
if largeTriangleMomentumGate
    for candidateLength = largeTriangleLookbackMin to largeTriangleLookbackMax by largeTriangleLookbackStep
        [candidateValid, candidateResistance, candidateEarlyLow, candidateMiddleLow, candidateRecentLow,
             candidateResistanceSpreadRatio, candidateContractionRatio, candidateUpperTouchGroups] =
             f_large_ascending_triangle(candidateLength, atr14)
        // 由短到长扫描并覆盖已选结果，最终保留最长有效结构，避免把大形态降格成短窗口突破。
        if candidateValid and close > candidateResistance
            largeTriangleBreakoutLong := true
            largeTriangleSelectedLength := candidateLength
            largeTriangleResistance := candidateResistance
            largeTriangleEarlyLow := candidateEarlyLow
            largeTriangleMiddleLow := candidateMiddleLow
            largeTriangleRecentLow := candidateRecentLow
            largeTriangleResistanceSpreadRatio := candidateResistanceSpreadRatio
            largeTriangleContractionRatio := candidateContractionRatio
            largeTriangleUpperTouchGroups := candidateUpperTouchGroups

// 原 v1 极值突破继续只负责假突破做空观察；做多由独立 v2 箱体确认与接受状态机负责，避免改写旧空头样本。
failureAnchorHigh = ta.highest(high[1], falseBreakoutAnchorLength)
failureAnchorLow = ta.lowest(low[1], falseBreakoutAnchorLength)
anchorUpsideBreakout = barstate.isconfirmed and volumeEvent and not na(takeProfitAtr) and
     not na(failureAnchorHigh) and not na(failureAnchorLow) and
     close > failureAnchorHigh and close > open

var bool falseBreakoutPending = false
var int pendingBreakoutBarIndex = na
var int pendingBreakoutTime = na
var int pendingAnchorStartTime = na
var int pendingAnchorEndTime = na
var float pendingAnchorHigh = na
var float pendingAnchorLow = na
var float pendingBreakoutVolumeRatio = na
var float pendingBreakoutTakeProfitAtr = na

[confirmedRangeValid, confirmedRangeUpper, confirmedRangeLower, confirmedRangeRawHigh,
     confirmedRangeRawLow, confirmedRangeWidthRatio, confirmedRangeContainmentRatio,
     confirmedRangeUpperDriftRatio, confirmedRangeLowerDriftRatio,
     confirmedRangeContractionRatio, confirmedRangeUpperTouchGroups,
     confirmedRangeLowerTouchGroups] = f_confirmed_anchor_range(atr14[1])

var bool confirmedRangeAcceptancePending = false
var int pendingConfirmedRangeBreakoutBarIndex = na
var int pendingConfirmedRangeBreakoutTime = na
var int pendingConfirmedRangeStartTime = na
var int pendingConfirmedRangeEndTime = na
var float pendingConfirmedRangeUpper = na
var float pendingConfirmedRangeLower = na
var float pendingConfirmedRangeRawHigh = na
var float pendingConfirmedRangeRawLow = na
var float pendingConfirmedRangeWidthRatio = na
var float pendingConfirmedRangeContainmentRatio = na
var float pendingConfirmedRangeUpperDriftRatio = na
var float pendingConfirmedRangeLowerDriftRatio = na
var float pendingConfirmedRangeContractionRatio = na
var int pendingConfirmedRangeUpperTouchGroups = na
var int pendingConfirmedRangeLowerTouchGroups = na
var float pendingConfirmedRangeVolumeRatio = na
var float pendingConfirmedRangeTakeProfitAtr = na
var float pendingConfirmedRangeRetestBand = na

bool falseBreakoutShort = false
int falseBreakoutBarsElapsed = na
int falseBreakoutSourceTime = na
int falseBreakoutAnchorStartTime = na
int falseBreakoutAnchorEndTime = na
float falseBreakoutFrozenHigh = na
float falseBreakoutFrozenLow = na
float falseBreakoutVolumeRatio = na
float falseBreakoutTakeProfitAtr = na

if falseBreakoutPending
    candidateAge = bar_index - pendingBreakoutBarIndex
    if candidateAge >= 1 and candidateAge <= falseBreakoutFailureWindow and close < open and close < pendingAnchorLow
        falseBreakoutShort := true
        falseBreakoutBarsElapsed := candidateAge
        falseBreakoutSourceTime := pendingBreakoutTime
        falseBreakoutAnchorStartTime := pendingAnchorStartTime
        falseBreakoutAnchorEndTime := pendingAnchorEndTime
        falseBreakoutFrozenHigh := pendingAnchorHigh
        falseBreakoutFrozenLow := pendingAnchorLow
        falseBreakoutVolumeRatio := pendingBreakoutVolumeRatio
        falseBreakoutTakeProfitAtr := pendingBreakoutTakeProfitAtr
        falseBreakoutPending := false
    else if candidateAge >= falseBreakoutFailureWindow
        falseBreakoutPending := false

// 首个原始上破启动失败观察；等待期内后续冲高不重置倒计时。
newAnchorUpsideBreakout = not falseBreakoutPending and anchorUpsideBreakout
if newAnchorUpsideBreakout
    falseBreakoutPending := true
    pendingBreakoutBarIndex := bar_index
    pendingBreakoutTime := time
    pendingAnchorStartTime := time[falseBreakoutAnchorLength]
    pendingAnchorEndTime := time[1]
    pendingAnchorHigh := failureAnchorHigh
    pendingAnchorLow := failureAnchorLow
    pendingBreakoutVolumeRatio := filteredVolumeRatio
    pendingBreakoutTakeProfitAtr := takeProfitAtr

confirmedRangeBreakoutCandidate = newAnchorUpsideBreakout and confirmedRangeValid and
     ema12 > ema144 and ema144 > ema696 and rsi14 < 70
bool rangeUpsideBreakoutLong = false
int confirmedRangeAcceptanceBars = na
int acceptedConfirmedRangeBreakoutTime = na
int acceptedConfirmedRangeStartTime = na
int acceptedConfirmedRangeEndTime = na
float acceptedConfirmedRangeUpper = na
float acceptedConfirmedRangeLower = na
float acceptedConfirmedRangeRawHigh = na
float acceptedConfirmedRangeRawLow = na
float acceptedConfirmedRangeWidthRatio = na
float acceptedConfirmedRangeContainmentRatio = na
float acceptedConfirmedRangeUpperDriftRatio = na
float acceptedConfirmedRangeLowerDriftRatio = na
float acceptedConfirmedRangeContractionRatio = na
int acceptedConfirmedRangeUpperTouchGroups = na
int acceptedConfirmedRangeLowerTouchGroups = na
float acceptedConfirmedRangeVolumeRatio = na
float acceptedConfirmedRangeTakeProfitAtr = na
string confirmedRangeAcceptanceType = ""

if confirmedRangeAcceptancePending
    acceptanceAge = bar_index - pendingConfirmedRangeBreakoutBarIndex
    acceptanceRetest = low <= pendingConfirmedRangeRawHigh + pendingConfirmedRangeRetestBand and
         close > pendingConfirmedRangeRawHigh
    acceptanceHeldTwice = close > pendingConfirmedRangeRawHigh and close[1] > pendingConfirmedRangeRawHigh
    acceptanceInvalidated = close < pendingConfirmedRangeUpper
    if acceptanceAge >= 1 and acceptanceAge <= confirmedRangeAcceptanceWindow and
         not acceptanceInvalidated and (acceptanceRetest or acceptanceHeldTwice) and
         ema12 > ema144 and ema144 > ema696
        rangeUpsideBreakoutLong := true
        confirmedRangeAcceptanceBars := acceptanceAge
        confirmedRangeAcceptanceType := acceptanceRetest ? "回踩真实上沿后收回" : "连续两根收盘站稳真实上沿"
        acceptedConfirmedRangeBreakoutTime := pendingConfirmedRangeBreakoutTime
        acceptedConfirmedRangeStartTime := pendingConfirmedRangeStartTime
        acceptedConfirmedRangeEndTime := pendingConfirmedRangeEndTime
        acceptedConfirmedRangeUpper := pendingConfirmedRangeUpper
        acceptedConfirmedRangeLower := pendingConfirmedRangeLower
        acceptedConfirmedRangeRawHigh := pendingConfirmedRangeRawHigh
        acceptedConfirmedRangeRawLow := pendingConfirmedRangeRawLow
        acceptedConfirmedRangeWidthRatio := pendingConfirmedRangeWidthRatio
        acceptedConfirmedRangeContainmentRatio := pendingConfirmedRangeContainmentRatio
        acceptedConfirmedRangeUpperDriftRatio := pendingConfirmedRangeUpperDriftRatio
        acceptedConfirmedRangeLowerDriftRatio := pendingConfirmedRangeLowerDriftRatio
        acceptedConfirmedRangeContractionRatio := pendingConfirmedRangeContractionRatio
        acceptedConfirmedRangeUpperTouchGroups := pendingConfirmedRangeUpperTouchGroups
        acceptedConfirmedRangeLowerTouchGroups := pendingConfirmedRangeLowerTouchGroups
        acceptedConfirmedRangeVolumeRatio := pendingConfirmedRangeVolumeRatio
        acceptedConfirmedRangeTakeProfitAtr := pendingConfirmedRangeTakeProfitAtr
        confirmedRangeAcceptancePending := false
    else if acceptanceInvalidated or acceptanceAge >= confirmedRangeAcceptanceWindow
        confirmedRangeAcceptancePending := false

if confirmedRangeBreakoutCandidate and not confirmedRangeAcceptancePending
    // setup 只在突破棒收盘冻结；接受窗内绝不重算历史边界，防止用后续走势美化原箱体。
    confirmedRangeAcceptancePending := true
    pendingConfirmedRangeBreakoutBarIndex := bar_index
    pendingConfirmedRangeBreakoutTime := time
    pendingConfirmedRangeStartTime := time[falseBreakoutAnchorLength]
    pendingConfirmedRangeEndTime := time[1]
    pendingConfirmedRangeUpper := confirmedRangeUpper
    pendingConfirmedRangeLower := confirmedRangeLower
    pendingConfirmedRangeRawHigh := confirmedRangeRawHigh
    pendingConfirmedRangeRawLow := confirmedRangeRawLow
    pendingConfirmedRangeWidthRatio := confirmedRangeWidthRatio
    pendingConfirmedRangeContainmentRatio := confirmedRangeContainmentRatio
    pendingConfirmedRangeUpperDriftRatio := confirmedRangeUpperDriftRatio
    pendingConfirmedRangeLowerDriftRatio := confirmedRangeLowerDriftRatio
    pendingConfirmedRangeContractionRatio := confirmedRangeContractionRatio
    pendingConfirmedRangeUpperTouchGroups := confirmedRangeUpperTouchGroups
    pendingConfirmedRangeLowerTouchGroups := confirmedRangeLowerTouchGroups
    pendingConfirmedRangeVolumeRatio := filteredVolumeRatio
    pendingConfirmedRangeTakeProfitAtr := takeProfitAtr
    pendingConfirmedRangeRetestBand := math.max(confirmedRangeRawHigh * confirmedRangeRetestBandRatio,
         atr14[1] * confirmedRangeRetestBandAtr)

// 突破多单只冻结产生真实入场订单的结构线；同棒多结构取最高线，代表价格最近越过的有效阻力。
// 保护状态只由确认收盘跌回该线或既有重复扫高收回结构解除，单根影线触碰不会提前放行普通反手空单。
currentBreakoutLongCandidate = rangeUpsideBreakoutLong or largeHorizontalRangeBreakoutLong or largeTriangleBreakoutLong
float currentBreakoutLongLine = na
string currentBreakoutLongSource = ""
if rangeUpsideBreakoutLong
    currentBreakoutLongLine := acceptedConfirmedRangeRawHigh
    currentBreakoutLongSource := "20根确认箱体"
if largeHorizontalRangeBreakoutLong and
     (na(currentBreakoutLongLine) or largeHorizontalRangeRawHigh > currentBreakoutLongLine)
    currentBreakoutLongLine := largeHorizontalRangeRawHigh
    currentBreakoutLongSource := "大型水平箱体"
if largeTriangleBreakoutLong and
     (na(currentBreakoutLongLine) or largeTriangleResistance > currentBreakoutLongLine)
    currentBreakoutLongLine := largeTriangleResistance
    currentBreakoutLongSource := "大型上升三角"

var bool postBreakoutLongShortGuardActive = false
var float postBreakoutLongFrozenLine = na
var int postBreakoutLongSignalBarIndex = na
postBreakoutLongClosedBackBelow = postBreakoutLongShortGuardActive and
     barstate.isconfirmed and close <= postBreakoutLongFrozenLine
postBreakoutLongSecondSweepReclaimed = postBreakoutLongShortGuardActive and
     barstate.isconfirmed and bar_index > postBreakoutLongSignalBarIndex and transitionLiquiditySweepShort
if postBreakoutLongClosedBackBelow or postBreakoutLongSecondSweepReclaimed
    postBreakoutLongShortGuardActive := false
    postBreakoutLongFrozenLine := na
    postBreakoutLongSignalBarIndex := na

postBreakoutLongOrdinaryShortGuard = (postBreakoutLongShortGuardActive and close > postBreakoutLongFrozenLine) or
     currentBreakoutLongCandidate
rsiPatternShort := rsiPatternShort and not postBreakoutLongOrdinaryShortGuard
rsiShort := rsiBearishDivergence or rsiPatternShort
hasShort := rsiShort or emaShort
patternShortParticipated := rsiPatternShort
// 新家族属于独立高位拒绝结构，但仍尊重已冻结的突破多单保护，避免在有效突破线上方过早反手。
effortNoResultShort = effortNoResultShortSetup and not postBreakoutLongOrdinaryShortGuard

standardLongCandidate = volumeEvent and hasLong and not na(takeProfitAtr)
standardShortCandidate = volumeEvent and hasShort and not na(takeProfitAtr)
existingRawLongCandidate = standardLongCandidate or rangeUpsideBreakoutLong or
     largeHorizontalRangeBreakoutLong or largeTriangleBreakoutLong or emaCompressionExpansionLong or
     threeBarEngulfReversalLong or bollingerLowerReclaimLong
// 重合棒继续归属旧家族及其退出合同；新版本只统计此前没有被覆盖的独占机会。
ema596ReclaimDepartureLong = ema596ReclaimDepartureLongSetup and not existingRawLongCandidate
rawLongCandidate = existingRawLongCandidate or ema596ReclaimDepartureLong
rawShortCandidate = standardShortCandidate or falseBreakoutShort or
     transitionLiquiditySweepShort or emaCompressionExpansionShort or effortNoResultShort
counterTrendLong = ema12 < ema144 and ema144 < ema696
counterTrendShort = ema12 > ema144 and ema144 > ema696
strictTrendLong = ema12 > ema144 and ema144 > ema696
strictTrendShort = ema12 < ema144 and ema144 < ema696
// 严格排列年龄包含当前已确认信号棒；任一层级失效立即归零，并在600封顶以避免无意义增长。
var int strictBearEmaOrderAge = 0
var int strictBullEmaOrderAge = 0
strictBearEmaOrderAge := counterTrendLong ?
     int(math.min(rsiCounterTrendMaturityBars, nz(strictBearEmaOrderAge[1], 0) + 1)) : 0
strictBullEmaOrderAge := counterTrendShort ?
     int(math.min(rsiCounterTrendMaturityBars, nz(strictBullEmaOrderAge[1], 0) + 1)) : 0
// 只有不与其他独立家族重合的纯 RSI 背离才按 EMA 三态分流：严格逆势进入 V5，
// 严格顺势保留 V4 原退出合同；只有两种严格排列都不成立的中性/过渡状态才阻断。
divergenceOnlyLongCandidate = standardLongCandidate and rsiBullishDivergence and not emaLong and
     not rangeUpsideBreakoutLong and not largeHorizontalRangeBreakoutLong and
     not largeTriangleBreakoutLong and not emaCompressionExpansionLong and
     not threeBarEngulfReversalLong and not bollingerLowerReclaimLong and
     not ema596ReclaimDepartureLong
divergenceOnlyShortCandidate = standardShortCandidate and rsiBearishDivergence and not emaShort and
     not falseBreakoutShort and not transitionLiquiditySweepShort and not emaCompressionExpansionShort and
     not effortNoResultShort
pureRsiCounterTrendLongCandidate = divergenceOnlyLongCandidate and counterTrendLong
pureRsiCounterTrendShortCandidate = divergenceOnlyShortCandidate and counterTrendShort
pureRsiStrictTrendLongCandidate = divergenceOnlyLongCandidate and strictTrendLong
pureRsiStrictTrendShortCandidate = divergenceOnlyShortCandidate and strictTrendShort
// 与其他家族重合时仍由原家族决定；本门禁只删除 EMA 排列无法归类的纯背离交易。
blockedPureRsiLongCandidate = divergenceOnlyLongCandidate and
     not pureRsiCounterTrendLongCandidate and not pureRsiStrictTrendLongCandidate
blockedPureRsiShortCandidate = divergenceOnlyShortCandidate and
     not pureRsiCounterTrendShortCandidate and not pureRsiStrictTrendShortCandidate
qualifiedRawLongCandidate = rawLongCandidate and not blockedPureRsiLongCandidate
qualifiedRawShortCandidate = rawShortCandidate and not blockedPureRsiShortCandidate
// V4 的1R/1.5R“中性背离反转”分支已被中性门禁取代；严格顺势仍走其原 ATR 合同。
divergenceReversalLongCandidate = false
divergenceReversalShortCandidate = false
// 只把截图中的两个续跌家族纳入扩展退出。假突破还必须已经形成可见的空头排列、三线负斜率与扩大价差，
// 避免把任意反转空单仅凭“顺势”标签放大目标。
falseBreakoutBearTrendContinuation = falseBreakoutShort and emaSlopesReady and
     ema12 < ema144 and ema144 < ema596 and
     ema12SlopeAtr < 0 and ema144SlopeAtr < 0 and ema596SlopeAtr < 0 and
     emaShortSpreadsExpanding and close < ema12
shortTrendExtension = emaCompressionExpansionShort or falseBreakoutBearTrendContinuation
counterTrendPrior96High = ta.highest(high[1], counterTrendDisplacementLookback)
counterTrendPrior96Low = ta.lowest(low[1], counterTrendDisplacementLookback)
counterTrendDownDisplacement = not na(counterTrendPrior96High) ? counterTrendPrior96High - close : na
counterTrendUpDisplacement = not na(counterTrendPrior96Low) ? close - counterTrendPrior96Low : na
counterTrendDownDisplacementAtr = not na(counterTrendDownDisplacement) and not na(atr14) and atr14 > 0 ?
     counterTrendDownDisplacement / atr14 : na
counterTrendUpDisplacementAtr = not na(counterTrendUpDisplacement) and not na(atr14) and atr14 > 0 ?
     counterTrendUpDisplacement / atr14 : na
counterTrendDownDisplacementRatio = not na(counterTrendDownDisplacement) and counterTrendPrior96High > 0 ?
     counterTrendDownDisplacement / counterTrendPrior96High : na
counterTrendUpDisplacementRatio = not na(counterTrendUpDisplacement) and counterTrendPrior96Low > 0 ?
     counterTrendUpDisplacement / counterTrendPrior96Low : na
counterTrendLargeDownDisplacement = not na(counterTrendDownDisplacement) and
     not na(atr14) and atr14 > 0 and counterTrendPrior96High > 0 and
     counterTrendDownDisplacement >= math.max(
          counterTrendDisplacementAtrMin * atr14,
          counterTrendDisplacementRatioMin * counterTrendPrior96High)
counterTrendLargeUpDisplacement = not na(counterTrendUpDisplacement) and
     not na(atr14) and atr14 > 0 and counterTrendPrior96Low > 0 and
     counterTrendUpDisplacement >= math.max(
          counterTrendDisplacementAtrMin * atr14,
          counterTrendDisplacementRatioMin * counterTrendPrior96Low)
counterTrendFreshBreakLong = counterTrendLong and freshBreakdownZoneFound
counterTrendFreshBreakShort = counterTrendShort and freshBreakoutZoneFound

// fresh 破位后的逆势仓只吃回被破区间的近边；96根位移同时达到6ATR与5%时，才放大到远边。
// 没有 fresh 身份的逆势仓保留原来的远边目标，避免这次 V4 静默改写全部历史结构目标。
longStructureTarget = counterTrendFreshBreakLong ?
     f_round_long_target(counterTrendLargeDownDisplacement ?
          freshBreakdownZoneHigh : freshBreakdownZoneLow) :
     sidewaysZoneFound ? f_round_long_target(sidewaysZoneHigh) : na
shortStructureTarget = counterTrendFreshBreakShort ?
     f_round_short_target(counterTrendLargeUpDisplacement ?
          freshBreakoutZoneLow : freshBreakoutZoneHigh) :
     transitionLiquiditySweepShort ?
     f_round_short_target(transitionSweepConsolidationLow) :
     sidewaysZoneFound ? f_round_short_target(sidewaysZoneLow) : na
longStructureZoneFound = counterTrendFreshBreakLong or sidewaysZoneFound
shortStructureZoneFound = counterTrendFreshBreakShort or
     transitionLiquiditySweepShort or sidewaysZoneFound
pureRsiCounterTrendLongMature = pureRsiCounterTrendLongCandidate and
     strictBearEmaOrderAge >= rsiCounterTrendMaturityBars
pureRsiCounterTrendShortMature = pureRsiCounterTrendShortCandidate and
     strictBullEmaOrderAge >= rsiCounterTrendMaturityBars
pureRsiCounterTrendLongNearTarget = sidewaysZoneFound ? f_round_long_target(sidewaysZoneLow) : na
pureRsiCounterTrendLongFarTarget = sidewaysZoneFound ? f_round_long_target(sidewaysZoneHigh) : na
pureRsiCounterTrendShortNearTarget = sidewaysZoneFound ? f_round_short_target(sidewaysZoneHigh) : na
pureRsiCounterTrendShortFarTarget = sidewaysZoneFound ? f_round_short_target(sidewaysZoneLow) : na
pureRsiCounterTrendLongTarget = pureRsiCounterTrendLongMature ?
     pureRsiCounterTrendLongFarTarget : pureRsiCounterTrendLongNearTarget
pureRsiCounterTrendShortTarget = pureRsiCounterTrendShortMature ?
     pureRsiCounterTrendShortFarTarget : pureRsiCounterTrendShortNearTarget
selectedLongStructureTarget = pureRsiCounterTrendLongCandidate ?
     pureRsiCounterTrendLongTarget : longStructureTarget
selectedShortStructureTarget = pureRsiCounterTrendShortCandidate ?
     pureRsiCounterTrendShortTarget : shortStructureTarget
selectedLongStructureZoneFound = pureRsiCounterTrendLongCandidate ?
     sidewaysZoneFound : longStructureZoneFound
selectedShortStructureZoneFound = pureRsiCounterTrendShortCandidate ?
     sidewaysZoneFound : shortStructureZoneFound
counterTrendStructureLongCandidate = counterTrendLong and qualifiedRawLongCandidate and
     not threeBarEngulfReversalLong and not bollingerLowerReclaimLong and
     not ema596ReclaimDepartureLong
counterTrendStructureShortCandidate = not effortNoResultShort and
     (transitionLiquiditySweepShort or (counterTrendShort and qualifiedRawShortCandidate))

// 逆势交易没有已确认横盘区或目标已落在信号收盘价错误一侧时直接阻断，禁止回退到 ATR 止盈。
counterTrendLongReady = not counterTrendLong or
     (selectedLongStructureZoneFound and not na(selectedLongStructureTarget) and
      selectedLongStructureTarget > close)
counterTrendShortReady = transitionLiquiditySweepShort ?
     (not na(shortStructureTarget) and shortStructureTarget < close) :
     not counterTrendShort or
     (selectedShortStructureZoneFound and not na(selectedShortStructureTarget) and
      selectedShortStructureTarget < close)
// 两个独立反转家族使用各自结构止损和目标，不能被逆势横盘门禁改写成另一套交易。
allLongCandidate = (qualifiedRawLongCandidate and counterTrendLongReady) or
     threeBarEngulfReversalLong or bollingerLowerReclaimLong or ema596ReclaimDepartureLong
// “努力无结果”使用自身两高结构止损和 R 退出，因此不允许逆势横盘目标门禁静默改写或阻断它。
allShortCandidate = (qualifiedRawShortCandidate and counterTrendShortReady) or effortNoResultShort
longSignal = barstate.isconfirmed and allLongCandidate and not allShortCandidate
shortSignal = barstate.isconfirmed and allShortCandidate and not allLongCandidate
longEntryOrder = longSignal and strategy.position_size <= 0
shortEntryOrder = shortSignal and strategy.position_size >= 0

// 只有图表真正生成突破多单入场订单时才启动跨 K 线保护；未成交的冲突候选不会污染后续市场状态。
if longEntryOrder and currentBreakoutLongCandidate and not na(currentBreakoutLongLine)
    postBreakoutLongShortGuardActive := true
    postBreakoutLongFrozenLine := currentBreakoutLongLine
    postBreakoutLongSignalBarIndex := bar_index

string longTrigger = ""
longTrigger := f_append_trigger(longTrigger, standardLongCandidate, "量能事件")
longTrigger := f_append_trigger(longTrigger, rsiBullishDivergence, "RSI 结构性底背离")
longTrigger := f_append_trigger(longTrigger, rsiPatternLong and acceptedBullishEngulfing, "RSI 超卖 + 看涨吞没")
longTrigger := f_append_trigger(longTrigger, rsiPatternLong and longLowerShadow, "RSI 超卖 + 长下影")
longTrigger := f_append_trigger(longTrigger, emaLong, "EMA 多头趋势")
longTrigger := f_append_trigger(longTrigger, rangeUpsideBreakoutLong, "20根确认箱体突破后获得接受")
longTrigger := f_append_trigger(longTrigger, largeHorizontalRangeBreakoutLong, "大型水平箱体放量突破")
longTrigger := f_append_trigger(longTrigger, largeTriangleBreakoutLong, "大型上升三角放量突破")
longTrigger := f_append_trigger(longTrigger, emaCompressionExpansionLong, "EMA12/144/596 压缩后同步向上扩张")
longTrigger := f_append_trigger(longTrigger, threeBarEngulfReversalLong, "放量卖出高潮后三棒强势反包")
longTrigger := f_append_trigger(longTrigger, bollingerLowerReclaimLong, "放量下破布林下轨后收回")
longTrigger := f_append_trigger(longTrigger, ema596ReclaimDepartureLong, "EMA596收复后放量HH/HL离轨扩张")

string shortTrigger = ""
shortTrigger := f_append_trigger(shortTrigger, standardShortCandidate, "量能事件")
shortTrigger := f_append_trigger(shortTrigger, rsiBearishDivergence, "RSI 结构性顶背离")
shortTrigger := f_append_trigger(shortTrigger, rsiPatternShort and acceptedBearishEngulfing, "RSI 超买 + 看跌吞没")
shortTrigger := f_append_trigger(shortTrigger, rsiPatternShort and longUpperShadow, "RSI 超买 + 长上影")
shortTrigger := f_append_trigger(shortTrigger, emaShort, "EMA 空头趋势")
shortTrigger := f_append_trigger(shortTrigger, falseBreakoutShort, "放量上破20根锚定区间后8根内跌破下沿")
shortTrigger := f_append_trigger(shortTrigger, transitionLiquiditySweepShort, "多头切换后重复扫高假突破")
shortTrigger := f_append_trigger(shortTrigger, emaCompressionExpansionShort, "EMA12/144/596 压缩后同步向下扩张")
shortTrigger := f_append_trigger(shortTrigger, effortNoResultShort, "高位放量努力无结果 + 次高点拒绝 + 布林上轨收回")

string postBreakoutLongGuardDetails = ""
if longEntryOrder and currentBreakoutLongCandidate
    postBreakoutLongGuardDetails := "\n保护  冻结" + currentBreakoutLongSource +
         "突破线 " + str.tostring(currentBreakoutLongLine, format.mintick) +
         "\n      站在线上只拦普通RSI超买空单" +
         "\n解除  收盘跌回突破线 / 第二次扫高并收回" +
         "\n版本  " + postBreakoutLongShortGuardVersion

longStopDescription = bollingerLowerReclaimLong ?
     "信号低点下方1 tick " + str.tostring(bollingerLowerReclaimStop, format.mintick) :
     ema596ReclaimDepartureLong ?
     "前4根结构低点下方1 tick " + str.tostring(ema596ReclaimDepartureStop, format.mintick) :
     threeBarEngulfReversalLong ?
     "四棒形态低点 " + str.tostring(threeBarPatternLow, format.mintick) :
     patternLongParticipated ? (acceptedBullishEngulfing ? "吞没形态低点" : "下影线低点") : "1.5 ATR"
shortStopDescription = effortNoResultShort ?
     "两高较高者上方1 tick " + str.tostring(effortNoResultStop, format.mintick) :
     transitionLiquiditySweepShort ? "最终扫高高点" :
     falseBreakoutShort ? "冻结锚定区间上沿" :
     patternShortParticipated ? (acceptedBearishEngulfing ? "吞没形态高点" : "上影线高点") : "1.5 ATR"
longTakeProfitAtr = rangeUpsideBreakoutLong ? acceptedConfirmedRangeTakeProfitAtr :
     largeHorizontalRangeBreakoutLong or largeTriangleBreakoutLong ? takeProfitAtr :
     standardLongCandidate ? takeProfitAtr :
     emaCompressionExpansionLong ? emaExpansionTakeProfitAtr : na
shortBaseTakeProfitAtr = falseBreakoutShort ? falseBreakoutTakeProfitAtr :
     standardShortCandidate ? takeProfitAtr :
     emaCompressionExpansionShort ? emaExpansionTakeProfitAtr : na
shortTakeProfitAtr = shortTrendExtension ? shortTrendExtensionTargetAtr : shortBaseTakeProfitAtr
longTakeProfitDescription = bollingerLowerReclaimLong ?
     "冻结布林中轨 " + str.tostring(bollingerLowerReclaimTarget, format.mintick) + " · 100%" :
     ema596ReclaimDepartureLong ?
     "信号收盘风险2R " + str.tostring(ema596ReclaimDepartureTarget, format.mintick) + " · 100%" :
     threeBarEngulfReversalLong ? "1R激活近似保本 · 1.5R全平" :
     pureRsiCounterTrendLongCandidate ?
     (pureRsiCounterTrendLongMature ?
          "EMA逆势600+根 · 远边 " +
          str.tostring(pureRsiCounterTrendLongFarTarget, format.mintick) +
          " · 近边收盘确认后成本保本 · 2R后宽跟踪" :
          "EMA逆势" + str.tostring(strictBearEmaOrderAge) + "/600根 · 近边 " +
          str.tostring(pureRsiCounterTrendLongNearTarget, format.mintick) +
          " · 1R后1R跟踪") :
     counterTrendFreshBreakLong ?
     (counterTrendLargeDownDisplacement ? "96根大跌 · 放大到原横盘上沿 " : "刚跌破 · 回到原横盘下沿 ") +
     str.tostring(longStructureTarget, format.mintick) + " · 1R后移动保护" :
     counterTrendLong ? "横盘上沿 " + str.tostring(longStructureTarget, format.mintick) +
     " · 1R后移动保护" :
     divergenceReversalLongCandidate ? "1R激活近似保本 · 1.5R全平" :
     str.tostring(longTakeProfitAtr, "#.#") + " ATR"
shortTakeProfitDescription = effortNoResultShort ? "1R激活近似保本 · 1.5R全平" :
     pureRsiCounterTrendShortCandidate ?
     (pureRsiCounterTrendShortMature ?
          "EMA逆势600+根 · 远边 " +
          str.tostring(pureRsiCounterTrendShortFarTarget, format.mintick) +
          " · 近边收盘确认后成本保本 · 2R后宽跟踪" :
          "EMA逆势" + str.tostring(strictBullEmaOrderAge) + "/600根 · 近边 " +
          str.tostring(pureRsiCounterTrendShortNearTarget, format.mintick) +
          " · 1R后1R跟踪") :
     counterTrendFreshBreakShort ?
     (counterTrendLargeUpDisplacement ? "96根大涨 · 放大到原横盘下沿 " : "刚上破 · 回到原横盘上沿 ") +
     str.tostring(shortStructureTarget, format.mintick) + " · 1R后移动保护" :
     transitionLiquiditySweepShort ?
     "扫高盘整低点 " + str.tostring(shortStructureTarget, format.mintick) + " · 1R后移动保护" :
     counterTrendShort ? "横盘下沿 " + str.tostring(shortStructureTarget, format.mintick) +
     " · 1R后移动保护" :
     divergenceReversalShortCandidate ? "1R激活近似保本 · 1.5R全平" :
     shortTrendExtension ?
     str.tostring(shortBaseTakeProfitAtr, "#.#") + " ATR激活 · 近似保本 · 8 ATR全平" :
     str.tostring(shortTakeProfitAtr, "#.#") + " ATR"
longDisplayVolumeRatio = ema596ReclaimDepartureLong ? ema596DepartureMedianVolumeRatio :
     rangeUpsideBreakoutLong ? acceptedConfirmedRangeVolumeRatio : filteredVolumeRatio
shortDisplayVolumeRatio = falseBreakoutShort ? falseBreakoutVolumeRatio : filteredVolumeRatio
string longDivergenceDetails = ""
if rsiBullishDivergence
    longDivergenceDetails := "\n锚点  " + str.format_time(time[qOffset], "MM-dd HH:mm", "Asia/Shanghai") +
         " · 相隔 " + str.tostring(qOffset) + " 根" +
         "\n对比  低点 " + str.tostring(qLow, format.mintick) + " → " + str.tostring(low, format.mintick) +
         "\n      RSI " + str.tostring(qRsi, "#.##") + " → " + str.tostring(rsi14, "#.##") +
         "\n幅度  下破 " + str.tostring(bullishBreakRatio * 100, "#.##") + "% · " +
         str.tostring(bullishBreakAtr, "#.##") + " ATR" +
         "\n结构  中间反弹 " + str.tostring(bullishIntermediateSwingAtr, "#.##") + " ATR" +
         "\n等级  " + (bullishDivergenceWeak ? "弱背离 · 收回确认" : "完整背离") +
         "\n收回  " + (bullishDivergenceReclaimed ? "已收回锚点低点" : "完整背离可不收回") +
         "\nK线   " + (close > open ? "阳线确认" :
              "下影拒绝 " + str.tostring(lowerShadow / candleRange * 100, "#.##") + "%") +
         "\n路径  中间 RSI 最高 " + str.tostring(pathRsiMax, "#.##") + " ≤ 50" +
         "\n版本  " + divergenceStructureVersion
string shortDivergenceDetails = ""
if rsiBearishDivergence
    shortDivergenceDetails := "\n锚点  " + str.format_time(time[qOffset], "MM-dd HH:mm", "Asia/Shanghai") +
         " · 相隔 " + str.tostring(qOffset) + " 根" +
         "\n对比  高点 " + str.tostring(qHigh, format.mintick) + " → " + str.tostring(high, format.mintick) +
         "\n      RSI " + str.tostring(qRsi, "#.##") + " → " + str.tostring(rsi14, "#.##") +
         "\n幅度  上破 " + str.tostring(bearishBreakRatio * 100, "#.##") + "% · " +
         str.tostring(bearishBreakAtr, "#.##") + " ATR" +
         "\n结构  中间回落 " + str.tostring(bearishIntermediateSwingAtr, "#.##") + " ATR" +
         "\n等级  " + (bearishDivergenceWeak ? "弱背离 · 收回确认" : "完整背离") +
         "\n收回  " + (bearishDivergenceReclaimed ? "已跌回锚点高点" : "完整背离可不收回") +
         "\nK线   " + (close < open ? "阴线确认" :
              "上影拒绝 " + str.tostring(upperShadow / candleRange * 100, "#.##") + "%") +
         "\n路径  中间 RSI 最低 " + str.tostring(pathRsiMin, "#.##") + " ≥ 50" +
         "\n版本  " + divergenceStructureVersion
string effortNoResultDetails = ""
if effortNoResultShort
    effortNoResultDetails := "\n模式  高位放量努力无结果 · 次高点拒绝" +
         "\n锚点  " + str.format_time(time[effortNoResultAnchorOffset], "MM-dd HH:mm", "Asia/Shanghai") +
         " · 相隔 " + str.tostring(effortNoResultAnchorOffset) + " 根" +
         "\n高点  " + str.tostring(effortNoResultAnchorHigh, format.mintick) +
         " → " + str.tostring(high, format.mintick) +
         "\n差距  " + str.tostring(effortNoResultHighGapRatio * 100, "#.###") +
         "% · " + str.tostring(effortNoResultHighGapAtr, "#.##") + " ATR · OR通过" +
         "\n量能  vol_ccy " + str.tostring(effortNoResultAnchorVolume, "#.##") +
         " → " + str.tostring(volume, "#.##") +
         " · " + str.tostring(effortNoResultVolumeMultiple, "#.##") + "x" +
         "\n动量  RSI " + str.tostring(effortNoResultAnchorRsi, "#.##") +
         " → " + str.tostring(rsi14, "#.##") +
         "\n阴线  实体 " + str.tostring(bodyRangeRatio * 100, "#.##") +
         "%振幅 · " + str.tostring(effortNoResultBearBodyAtr, "#.##") +
         " ATR · 收盘位置 " + str.tostring(effortNoResultCloseLocation * 100, "#.##") + "%" +
         "\n布林  高点 " + str.tostring(high, format.mintick) +
         " > 上轨 " + str.tostring(bollingerUpper, format.mintick) +
         " · 收盘 " + str.tostring(close, format.mintick) + " 已回轨内" +
         "\n版本  " + effortNoResultShortVersion
string falseBreakoutDetails = ""
if falseBreakoutShort
    falseBreakoutDetails := "\n锚区  " +
         str.format_time(falseBreakoutAnchorStartTime, "MM-dd HH:mm", "Asia/Shanghai") + " → " +
         str.format_time(falseBreakoutAnchorEndTime, "MM-dd HH:mm", "Asia/Shanghai") +
         "\n边界  高 " + str.tostring(falseBreakoutFrozenHigh, format.mintick) +
         " · 低 " + str.tostring(falseBreakoutFrozenLow, format.mintick) +
         "\n突破  " + str.format_time(falseBreakoutSourceTime, "MM-dd HH:mm", "Asia/Shanghai") +
         " · 量比 " + str.tostring(falseBreakoutVolumeRatio, "#.##") + "x" +
         "\n失败  第 " + str.tostring(falseBreakoutBarsElapsed) + " 根收盘跌破下沿"
string transitionLiquiditySweepDetails = ""
if transitionLiquiditySweepShort
    transitionLiquiditySweepDetails := "\n模式  多头切换后重复扫高假突破" +
         "\n锚点  " + str.format_time(time[transitionSweepAnchorOffset], "MM-dd HH:mm", "Asia/Shanghai") +
         " · 相隔 " + str.tostring(transitionSweepAnchorOffset) + " 根" +
         "\n边界  前高 " + str.tostring(transitionSweepAnchorPriorHigh, format.mintick) +
         " · 锚高 " + str.tostring(transitionSweepAnchorHigh, format.mintick) +
         "\n量能  锚点量比 " + str.tostring(transitionSweepAnchorVolumeRatio, "#.##") + "x" +
         " · RSI " + str.tostring(transitionSweepAnchorRsi, "#.##") +
         "\n测试  " + str.tostring(transitionSweepTouchGroups) +
         "组 · 触碰带 " + str.tostring(transitionSweepTouchBand, format.mintick) +
         "\n扫高  " + str.tostring(transitionSweepAnchorHigh, format.mintick) +
         " → " + str.tostring(high, format.mintick) +
