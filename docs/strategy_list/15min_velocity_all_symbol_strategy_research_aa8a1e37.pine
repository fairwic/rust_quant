var int activeEffortNoResultTargetTicks = na
var bool pendingThreeBarEngulfReversalExit = false
var int pendingThreeBarEngulfActivationTicks = na
var int pendingThreeBarEngulfTargetTicks = na
var bool activeThreeBarEngulfReversalExit = false
var bool activeThreeBarEngulfActivated = false
var int activeThreeBarEngulfActivationTicks = na
var int activeThreeBarEngulfTargetTicks = na
var bool pendingShortTrendExtension = false
var int pendingShortExtensionActivationTicks = na
var int pendingShortExtensionLockTicks = na
var int pendingShortExtensionTargetTicks = na
var bool activeShortTrendExtension = false
var bool activeShortTrendExtensionActivated = false
var int activeShortExtensionActivationTicks = na
var int activeShortExtensionLockTicks = na
var int activeShortExtensionTargetTicks = na
var bool pendingLongCounterTrendStructureExit = false
var bool pendingShortCounterTrendStructureExit = false
var float pendingLongCounterTrendInitialStop = na
var float pendingShortCounterTrendInitialStop = na
var int pendingLongCounterTrendStopTicks = na
var int pendingShortCounterTrendStopTicks = na
var float pendingLongCounterTrendTarget = na
var float pendingShortCounterTrendTarget = na
var bool pendingLongRsiCounterTrendMature = false
var bool pendingShortRsiCounterTrendMature = false
var float pendingLongRsiCounterTrendNearTarget = na
var float pendingShortRsiCounterTrendNearTarget = na
var bool activeLongCounterTrendStructureExit = false
var bool activeShortCounterTrendStructureExit = false
var bool activeLongCounterTrendActivated = false
var bool activeShortCounterTrendActivated = false
var float activeLongCounterTrendInitialRisk = na
var float activeShortCounterTrendInitialRisk = na
var float activeLongCounterTrendBestPrice = na
var float activeShortCounterTrendBestPrice = na
var float activeLongCounterTrendTrailStop = na
var float activeShortCounterTrendTrailStop = na
var float activeLongCounterTrendTarget = na
var float activeShortCounterTrendTarget = na
// 成熟身份与近边都在信号棒冻结；持仓后不得用新K线重新识别横盘或改写保护门槛。
var bool activeLongRsiCounterTrendMature = false
var bool activeShortRsiCounterTrendMature = false
var bool activeLongRsiCounterTrendStructureConfirmed = false
var bool activeShortRsiCounterTrendStructureConfirmed = false
var float activeLongRsiCounterTrendNearTarget = na
var float activeShortRsiCounterTrendNearTarget = na
var float activeLongRsiCounterTrendNetBreakEven = na
var float activeShortRsiCounterTrendNetBreakEven = na

stopDistanceTicks = not na(atr14) ? f_stop_distance_ticks(1.5 * atr14) : na
longTargetDistanceTicks = not counterTrendLong and not na(atr14) and not na(longTakeProfitAtr) ?
     f_target_distance_ticks(longTakeProfitAtr * atr14) : na
shortTargetDistanceTicks = not counterTrendShort and not na(atr14) and not na(shortTakeProfitAtr) ?
     f_target_distance_ticks(shortTakeProfitAtr * atr14) : na
shortExtensionActivationTicks = shortTrendExtension and not na(atr14) and not na(shortBaseTakeProfitAtr) ?
     f_target_distance_ticks(shortBaseTakeProfitAtr * atr14) : na
divergenceActivationTicks = not na(stopDistanceTicks) ?
     int(math.max(1, math.floor(stopDistanceTicks * divergenceBreakEvenRisk))) : na
divergenceFinalTargetTicks = not na(stopDistanceTicks) ?
     int(math.max(1, math.floor(stopDistanceTicks * divergenceFinalTargetRisk))) : na
effortNoResultRiskTicks = effortNoResultShort and not na(effortNoResultStop) and effortNoResultStop > close ?
     f_stop_distance_ticks(effortNoResultStop - close) : na
effortNoResultActivationTicks = not na(effortNoResultRiskTicks) ?
     int(math.max(1, math.floor(effortNoResultRiskTicks * effortNoResultBreakEvenRisk))) : na
effortNoResultTargetTicks = not na(effortNoResultRiskTicks) ?
     int(math.max(1, math.floor(effortNoResultRiskTicks * effortNoResultFinalTargetRisk))) : na
threeBarEngulfRiskTicks = threeBarEngulfReversalLong and close > threeBarPatternLow ?
     f_stop_distance_ticks(close - threeBarPatternLow) : na
threeBarEngulfActivationTicks = not na(threeBarEngulfRiskTicks) ?
     int(math.max(1, math.floor(threeBarEngulfRiskTicks * threeBarEngulfBreakEvenRisk))) : na
threeBarEngulfTargetTicks = not na(threeBarEngulfRiskTicks) ?
     int(math.max(1, math.floor(threeBarEngulfRiskTicks * threeBarEngulfFinalTargetRisk))) : na
// Research 图表未计手续费与滑点，1 tick 仅表示“略过成交价”的近似保本；正式回测必须改为成本后保本价。
shortExtensionLockTicks = shortTrendExtension ? 1 : na

// 组合箭头直接锚定 K 线高低点：三角头贴近 K 线，6 像素实线保证箭尾在高分屏上仍清晰。
entryMarkerGap = math.max(syminfo.mintick * 4, atr14 * 0.08)
entryMarkerTailInner = atr14 * 0.12
entryMarkerTailOuter = atr14 * 0.70

if longEntryOrder
    pendingStopTicks := stopDistanceTicks
    // 下一根开盘才成交；冻结信号棒 ATR，避免把开仓后尚不可见的高低点纳入入场风险尺度。
    pendingEntryAtr := atr14
    pendingTargetTicks := threeBarEngulfReversalLong ? threeBarEngulfTargetTicks :
         divergenceReversalLongCandidate and not counterTrendLong ?
         divergenceFinalTargetTicks : longTargetDistanceTicks
    pendingStructureTarget := bollingerLowerReclaimLong ? bollingerLowerReclaimTarget :
         ema596ReclaimDepartureLong ? ema596ReclaimDepartureTarget :
         counterTrendLong and not threeBarEngulfReversalLong ? selectedLongStructureTarget : na
    pendingLongDivergenceReversalExit := divergenceReversalLongCandidate and
         not counterTrendLong and not threeBarEngulfReversalLong and
         not bollingerLowerReclaimLong and not ema596ReclaimDepartureLong
    pendingLongDivergenceActivationTicks := pendingLongDivergenceReversalExit ? divergenceActivationTicks : na
    pendingLongDivergenceTargetTicks := pendingLongDivergenceReversalExit ? divergenceFinalTargetTicks : na
    pendingThreeBarEngulfReversalExit := threeBarEngulfReversalLong and not bollingerLowerReclaimLong
    pendingThreeBarEngulfActivationTicks := pendingThreeBarEngulfReversalExit ? threeBarEngulfActivationTicks : na
    pendingThreeBarEngulfTargetTicks := pendingThreeBarEngulfReversalExit ? threeBarEngulfTargetTicks : na
    pendingPatternStop := bollingerLowerReclaimLong ? bollingerLowerReclaimStop :
         ema596ReclaimDepartureLong ? ema596ReclaimDepartureStop :
         threeBarEngulfReversalLong ? f_round_long_stop(threeBarPatternLow) :
         patternLongParticipated ? f_round_long_stop(acceptedBullishEngulfing ? math.min(low[1], low) : low) : na
    pendingLongCounterTrendStructureExit := counterTrendStructureLongCandidate
    pendingLongCounterTrendInitialStop := pendingLongCounterTrendStructureExit ? pendingPatternStop : na
    pendingLongCounterTrendStopTicks := pendingLongCounterTrendStructureExit and na(pendingPatternStop) ?
         pendingStopTicks : na
    pendingLongCounterTrendTarget := pendingLongCounterTrendStructureExit ? pendingStructureTarget : na
    pendingLongRsiCounterTrendMature := pendingLongCounterTrendStructureExit and
         pureRsiCounterTrendLongMature
    pendingLongRsiCounterTrendNearTarget := pendingLongCounterTrendStructureExit and
         pureRsiCounterTrendLongCandidate ? pureRsiCounterTrendLongNearTarget : na
    f_add_hover_target(bar_index, hl2, longTooltip)
    longMarkerTip = low - entryMarkerGap
    label.new(bar_index, longMarkerTip, "", xloc = xloc.bar_index, yloc = yloc.price,
         style = label.style_triangleup, color = color.green, size = size.small, tooltip = longTooltip)
    line.new(bar_index, longMarkerTip - entryMarkerTailOuter, bar_index, longMarkerTip - entryMarkerTailInner,
         xloc = xloc.bar_index, color = color.green, width = 6)
    if bollingerLowerReclaimLong
        strategy.entry("Long BLR", strategy.long, comment = bollingerLowerReclaimLongVersion)
        strategy.exit("Long BLR protection", from_entry = "Long BLR",
             stop = pendingPatternStop, limit = pendingStructureTarget, qty_percent = 100,
             comment_profit = "BLR_TP", comment_loss = "SL")
    else if ema596ReclaimDepartureLong
        strategy.entry("Long EMA596-D2", strategy.long, comment = ema596ReclaimDepartureLongVersion)
        strategy.exit("Long EMA596-D2 protection", from_entry = "Long EMA596-D2",
             stop = pendingPatternStop, limit = pendingStructureTarget, qty_percent = 100,
             comment_profit = "EMA596_TP", comment_loss = "SL")
    else if threeBarEngulfReversalLong
        strategy.entry("Long 3Bar", strategy.long, comment = threeBarEngulfReversalLongVersion)
        strategy.exit("Long 3Bar protection", from_entry = "Long 3Bar",
             stop = pendingPatternStop, profit = pendingTargetTicks,
             comment_profit = "ENG_TP", comment_loss = "SL")
    else
        strategy.entry("Long", strategy.long, comment = "15m velocity long")
        if na(pendingPatternStop)
            if na(pendingStructureTarget)
                strategy.exit("Long protection", from_entry = "Long", loss = pendingStopTicks, profit = pendingTargetTicks,
                     comment_profit = "TP", comment_loss = "SL")
            else
                strategy.exit("Long protection", from_entry = "Long", loss = pendingStopTicks, limit = pendingStructureTarget,
                     qty_percent = 100, comment_profit = "TP_STRUCT", comment_loss = "SL")
        else
            if na(pendingStructureTarget)
                strategy.exit("Long protection", from_entry = "Long", stop = pendingPatternStop, profit = pendingTargetTicks,
                     comment_profit = "TP", comment_loss = "SL")
            else
                strategy.exit("Long protection", from_entry = "Long", stop = pendingPatternStop, limit = pendingStructureTarget,
                     qty_percent = 100, comment_profit = "TP_STRUCT", comment_loss = "SL")

if shortEntryOrder
    pendingStopTicks := stopDistanceTicks
    pendingEntryAtr := atr14
    pendingTargetTicks := effortNoResultShort ? effortNoResultTargetTicks :
         divergenceReversalShortCandidate and not counterTrendShort ?
         divergenceFinalTargetTicks : shortTargetDistanceTicks
    pendingStructureTarget := effortNoResultShort ? na :
         transitionLiquiditySweepShort ?
         shortStructureTarget : counterTrendShort ? selectedShortStructureTarget : na
    pendingShortDivergenceReversalExit := divergenceReversalShortCandidate and
         not counterTrendShort and not effortNoResultShort
    pendingShortDivergenceActivationTicks := pendingShortDivergenceReversalExit ? divergenceActivationTicks : na
    pendingShortDivergenceTargetTicks := pendingShortDivergenceReversalExit ? divergenceFinalTargetTicks : na
    pendingEffortNoResultReversalExit := effortNoResultShort
    pendingEffortNoResultActivationTicks := pendingEffortNoResultReversalExit ? effortNoResultActivationTicks : na
    pendingEffortNoResultTargetTicks := pendingEffortNoResultReversalExit ? effortNoResultTargetTicks : na
    pendingShortTrendExtension := shortTrendExtension and not counterTrendShort and not effortNoResultShort
    pendingShortExtensionActivationTicks := pendingShortTrendExtension ? shortExtensionActivationTicks : na
    pendingShortExtensionLockTicks := pendingShortTrendExtension ? shortExtensionLockTicks : na
    pendingShortExtensionTargetTicks := pendingShortTrendExtension ? shortTargetDistanceTicks : na
    // 独立高位拒绝与两类假突破都使用各自冻结的结构失效位，优先于同根偶然出现的普通K线形态。
    pendingPatternStop := effortNoResultShort ? effortNoResultStop :
         transitionLiquiditySweepShort ? f_round_short_stop(high) :
         falseBreakoutShort ? f_round_short_stop(falseBreakoutFrozenHigh) :
         patternShortParticipated ? f_round_short_stop(acceptedBearishEngulfing ? math.max(high[1], high) : high) : na
    pendingShortCounterTrendStructureExit := counterTrendStructureShortCandidate
    pendingShortCounterTrendInitialStop := pendingShortCounterTrendStructureExit ? pendingPatternStop : na
    pendingShortCounterTrendStopTicks := pendingShortCounterTrendStructureExit and na(pendingPatternStop) ?
         pendingStopTicks : na
    pendingShortCounterTrendTarget := pendingShortCounterTrendStructureExit ? pendingStructureTarget : na
    pendingShortRsiCounterTrendMature := pendingShortCounterTrendStructureExit and
         pureRsiCounterTrendShortMature
    pendingShortRsiCounterTrendNearTarget := pendingShortCounterTrendStructureExit and
         pureRsiCounterTrendShortCandidate ? pureRsiCounterTrendShortNearTarget : na
    f_add_hover_target(bar_index, hl2, shortTooltip)
    shortMarkerTip = high + entryMarkerGap
    label.new(bar_index, shortMarkerTip, "", xloc = xloc.bar_index, yloc = yloc.price,
         style = label.style_triangledown, color = color.red, size = size.small, tooltip = shortTooltip)
    line.new(bar_index, shortMarkerTip + entryMarkerTailOuter, bar_index, shortMarkerTip + entryMarkerTailInner,
         xloc = xloc.bar_index, color = color.red, width = 6)
    if effortNoResultShort
        strategy.entry("Short ENR", strategy.short, comment = effortNoResultShortVersion)
        strategy.exit("Short ENR protection", from_entry = "Short ENR",
             stop = pendingPatternStop, profit = pendingTargetTicks,
             comment_profit = "ENR_TP", comment_loss = "SL")
    else
        strategy.entry("Short", strategy.short, comment = "15m velocity short")
        if na(pendingPatternStop)
            if na(pendingStructureTarget)
                strategy.exit("Short protection", from_entry = "Short", loss = pendingStopTicks, profit = pendingTargetTicks,
                     comment_profit = shortTrendExtension ? "TP_EXT" : "TP", comment_loss = "SL")
            else
                strategy.exit("Short protection", from_entry = "Short", loss = pendingStopTicks, limit = pendingStructureTarget,
                     qty_percent = 100, comment_profit = "TP_STRUCT", comment_loss = "SL")
        else
            if na(pendingStructureTarget)
                strategy.exit("Short protection", from_entry = "Short", stop = pendingPatternStop, profit = pendingTargetTicks,
                     comment_profit = shortTrendExtension ? "TP_EXT" : "TP", comment_loss = "SL")
            else
                strategy.exit("Short protection", from_entry = "Short", stop = pendingPatternStop, limit = pendingStructureTarget,
                     qty_percent = 100, comment_profit = "TP_STRUCT", comment_loss = "SL")

newLongPosition = strategy.position_size > 0 and strategy.position_size[1] <= 0
if newLongPosition
    activeEntryAtr := pendingEntryAtr
    pendingEntryAtr := na
    activeLongDivergenceReversalExit := pendingLongDivergenceReversalExit
    activeLongDivergenceActivated := false
    activeLongDivergenceActivationTicks := pendingLongDivergenceActivationTicks
    activeLongDivergenceTargetTicks := pendingLongDivergenceTargetTicks
    activeThreeBarEngulfReversalExit := pendingThreeBarEngulfReversalExit
    activeThreeBarEngulfActivated := false
    activeThreeBarEngulfActivationTicks := pendingThreeBarEngulfActivationTicks
    activeThreeBarEngulfTargetTicks := pendingThreeBarEngulfTargetTicks
    activeLongCounterTrendStructureExit := pendingLongCounterTrendStructureExit
    activeLongCounterTrendActivated := false
    longCounterTrendInitialStop = not na(pendingLongCounterTrendInitialStop) ?
         pendingLongCounterTrendInitialStop :
         strategy.position_avg_price - pendingLongCounterTrendStopTicks * syminfo.mintick
    activeLongCounterTrendInitialRisk := activeLongCounterTrendStructureExit ?
         math.abs(strategy.position_avg_price - longCounterTrendInitialStop) : na
    activeLongCounterTrendBestPrice := activeLongCounterTrendStructureExit ?
         strategy.position_avg_price : na
    activeLongCounterTrendTrailStop := activeLongCounterTrendStructureExit ?
         longCounterTrendInitialStop : na
    activeLongCounterTrendTarget := activeLongCounterTrendStructureExit ?
         pendingLongCounterTrendTarget : na
    activeLongRsiCounterTrendMature := pendingLongRsiCounterTrendMature
    activeLongRsiCounterTrendStructureConfirmed := false
    activeLongRsiCounterTrendNearTarget := pendingLongRsiCounterTrendNearTarget
    activeLongRsiCounterTrendNetBreakEven := pendingLongRsiCounterTrendMature ?
         f_round_long_net_break_even(
              strategy.position_avg_price * (1 + rsiCounterTrendCostRatePerSide) /
              (1 - rsiCounterTrendCostRatePerSide)) : na
    pendingLongCounterTrendStructureExit := false
    pendingLongCounterTrendInitialStop := na
    pendingLongCounterTrendStopTicks := na
    pendingLongCounterTrendTarget := na
    pendingLongRsiCounterTrendMature := false
    pendingLongRsiCounterTrendNearTarget := na

newShortPosition = strategy.position_size < 0 and strategy.position_size[1] >= 0
if newShortPosition
    activeEntryAtr := pendingEntryAtr
    pendingEntryAtr := na
    activeShortDivergenceReversalExit := pendingShortDivergenceReversalExit
    activeShortDivergenceActivated := false
    activeShortDivergenceActivationTicks := pendingShortDivergenceActivationTicks
    activeShortDivergenceTargetTicks := pendingShortDivergenceTargetTicks
    activeEffortNoResultReversalExit := pendingEffortNoResultReversalExit
    activeEffortNoResultActivated := false
    activeEffortNoResultActivationTicks := pendingEffortNoResultActivationTicks
    activeEffortNoResultTargetTicks := pendingEffortNoResultTargetTicks
    activeShortTrendExtension := pendingShortTrendExtension
    activeShortTrendExtensionActivated := false
    activeShortExtensionActivationTicks := pendingShortExtensionActivationTicks
    activeShortExtensionLockTicks := pendingShortExtensionLockTicks
    activeShortExtensionTargetTicks := pendingShortExtensionTargetTicks
    activeShortCounterTrendStructureExit := pendingShortCounterTrendStructureExit
    activeShortCounterTrendActivated := false
    shortCounterTrendInitialStop = not na(pendingShortCounterTrendInitialStop) ?
         pendingShortCounterTrendInitialStop :
         strategy.position_avg_price + pendingShortCounterTrendStopTicks * syminfo.mintick
    activeShortCounterTrendInitialRisk := activeShortCounterTrendStructureExit ?
         math.abs(shortCounterTrendInitialStop - strategy.position_avg_price) : na
    activeShortCounterTrendBestPrice := activeShortCounterTrendStructureExit ?
         strategy.position_avg_price : na
    activeShortCounterTrendTrailStop := activeShortCounterTrendStructureExit ?
         shortCounterTrendInitialStop : na
    activeShortCounterTrendTarget := activeShortCounterTrendStructureExit ?
         pendingShortCounterTrendTarget : na
    activeShortRsiCounterTrendMature := pendingShortRsiCounterTrendMature
    activeShortRsiCounterTrendStructureConfirmed := false
    activeShortRsiCounterTrendNearTarget := pendingShortRsiCounterTrendNearTarget
    activeShortRsiCounterTrendNetBreakEven := pendingShortRsiCounterTrendMature ?
         f_round_short_net_break_even(
              strategy.position_avg_price * (1 - rsiCounterTrendCostRatePerSide) /
              (1 + rsiCounterTrendCostRatePerSide)) : na
    pendingShortCounterTrendStructureExit := false
    pendingShortCounterTrendInitialStop := na
    pendingShortCounterTrendStopTicks := na
    pendingShortCounterTrendTarget := na
    pendingShortRsiCounterTrendMature := false
    pendingShortRsiCounterTrendNearTarget := na

// 逆势结构仓以真实开盘成交价到初始止损的距离定义1R；信号收盘价只负责预检，不能替代实际风险。
// 成熟 RSI 逆势在1R不移动止损：只有完成棒突破冻结近边后才升到成本净保本，2R后才启动2R宽跟踪。
// 最高/最低有利价可以读取当前完成棒，但新保护只在本次收盘提交并从下一棒生效，不回填棒内触发顺序。
if barstate.isconfirmed and activeLongCounterTrendStructureExit and
     strategy.position_size > 0 and activeLongCounterTrendInitialRisk > 0
    activeLongCounterTrendBestPrice := math.max(activeLongCounterTrendBestPrice, high)
    if activeLongRsiCounterTrendMature
        if not activeLongRsiCounterTrendStructureConfirmed and
             not na(activeLongRsiCounterTrendNearTarget) and
             close > activeLongRsiCounterTrendNearTarget
            activeLongRsiCounterTrendStructureConfirmed := true
        if activeLongRsiCounterTrendStructureConfirmed
            activeLongCounterTrendTrailStop := math.max(
                 activeLongCounterTrendTrailStop, activeLongRsiCounterTrendNetBreakEven)
            if not activeLongCounterTrendActivated and
                 activeLongCounterTrendBestPrice >=
                 strategy.position_avg_price +
                 rsiCounterTrendWideTrailRisk * activeLongCounterTrendInitialRisk
                activeLongCounterTrendActivated := true
            if activeLongCounterTrendActivated
                longCounterTrendCandidateStop = math.max(
                     activeLongRsiCounterTrendNetBreakEven,
                     f_round_long_stop(
                          activeLongCounterTrendBestPrice -
                          rsiCounterTrendWideTrailRisk * activeLongCounterTrendInitialRisk))
                activeLongCounterTrendTrailStop := math.max(
                     activeLongCounterTrendTrailStop, longCounterTrendCandidateStop)
            matureLongExitComment = activeLongCounterTrendActivated ? "CT_V5_TRAIL" : "CT_V5_BE"
            if close <= activeLongCounterTrendTrailStop
                strategy.close("Long", comment = matureLongExitComment)
            else
                strategy.exit("Long protection", from_entry = "Long",
                     stop = activeLongCounterTrendTrailStop, limit = activeLongCounterTrendTarget,
                     qty_percent = 100, comment_profit = "TP_STRUCT",
                     comment_loss = matureLongExitComment)
    else
        if not activeLongCounterTrendActivated and
             activeLongCounterTrendBestPrice >= strategy.position_avg_price + activeLongCounterTrendInitialRisk
            activeLongCounterTrendActivated := true
        if activeLongCounterTrendActivated
            longCounterTrendCandidateStop = f_round_long_stop(math.max(
                 strategy.position_avg_price + syminfo.mintick,
                 activeLongCounterTrendBestPrice -
                 counterTrendTrailingDistanceRisk * activeLongCounterTrendInitialRisk))
            activeLongCounterTrendTrailStop := math.max(
                 activeLongCounterTrendTrailStop, longCounterTrendCandidateStop)
            if close <= activeLongCounterTrendTrailStop
                strategy.close("Long", comment = "CT_TRAIL")
            else
                strategy.exit("Long protection", from_entry = "Long",
                     stop = activeLongCounterTrendTrailStop, limit = activeLongCounterTrendTarget,
                     qty_percent = 100, comment_profit = "TP_STRUCT", comment_loss = "CT_TRAIL")

if barstate.isconfirmed and activeShortCounterTrendStructureExit and
     strategy.position_size < 0 and activeShortCounterTrendInitialRisk > 0
    activeShortCounterTrendBestPrice := math.min(activeShortCounterTrendBestPrice, low)
    if activeShortRsiCounterTrendMature
        if not activeShortRsiCounterTrendStructureConfirmed and
             not na(activeShortRsiCounterTrendNearTarget) and
             close < activeShortRsiCounterTrendNearTarget
            activeShortRsiCounterTrendStructureConfirmed := true
        if activeShortRsiCounterTrendStructureConfirmed
            activeShortCounterTrendTrailStop := math.min(
                 activeShortCounterTrendTrailStop, activeShortRsiCounterTrendNetBreakEven)
            if not activeShortCounterTrendActivated and
                 activeShortCounterTrendBestPrice <=
                 strategy.position_avg_price -
                 rsiCounterTrendWideTrailRisk * activeShortCounterTrendInitialRisk
                activeShortCounterTrendActivated := true
            if activeShortCounterTrendActivated
                shortCounterTrendCandidateStop = math.min(
                     activeShortRsiCounterTrendNetBreakEven,
                     f_round_short_stop(
                          activeShortCounterTrendBestPrice +
                          rsiCounterTrendWideTrailRisk * activeShortCounterTrendInitialRisk))
                activeShortCounterTrendTrailStop := math.min(
                     activeShortCounterTrendTrailStop, shortCounterTrendCandidateStop)
            matureShortExitComment = activeShortCounterTrendActivated ? "CT_V5_TRAIL" : "CT_V5_BE"
            if close >= activeShortCounterTrendTrailStop
                strategy.close("Short", comment = matureShortExitComment)
            else
                strategy.exit("Short protection", from_entry = "Short",
                     stop = activeShortCounterTrendTrailStop, limit = activeShortCounterTrendTarget,
                     qty_percent = 100, comment_profit = "TP_STRUCT",
                     comment_loss = matureShortExitComment)
    else
        if not activeShortCounterTrendActivated and
             activeShortCounterTrendBestPrice <= strategy.position_avg_price - activeShortCounterTrendInitialRisk
            activeShortCounterTrendActivated := true
        if activeShortCounterTrendActivated
            shortCounterTrendCandidateStop = f_round_short_stop(math.min(
                 strategy.position_avg_price - syminfo.mintick,
                 activeShortCounterTrendBestPrice +
                 counterTrendTrailingDistanceRisk * activeShortCounterTrendInitialRisk))
            activeShortCounterTrendTrailStop := math.min(
                 activeShortCounterTrendTrailStop, shortCounterTrendCandidateStop)
            if close >= activeShortCounterTrendTrailStop
                strategy.close("Short", comment = "CT_TRAIL")
            else
                strategy.exit("Short protection", from_entry = "Short",
                     stop = activeShortCounterTrendTrailStop, limit = activeShortCounterTrendTarget,
                     qty_percent = 100, comment_profit = "TP_STRUCT", comment_loss = "CT_TRAIL")

if activeLongDivergenceReversalExit and strategy.position_size > 0 and
     not activeLongDivergenceActivated and
     high >= strategy.position_avg_price + activeLongDivergenceActivationTicks * syminfo.mintick
    activeLongDivergenceActivated := true

if activeThreeBarEngulfReversalExit and strategy.position_size > 0 and
     not activeThreeBarEngulfActivated and
     high >= strategy.position_avg_price + activeThreeBarEngulfActivationTicks * syminfo.mintick
    activeThreeBarEngulfActivated := true

if activeShortDivergenceReversalExit and strategy.position_size < 0 and
     not activeShortDivergenceActivated and
     low <= strategy.position_avg_price - activeShortDivergenceActivationTicks * syminfo.mintick
    activeShortDivergenceActivated := true

if activeEffortNoResultReversalExit and strategy.position_size < 0 and
     not activeEffortNoResultActivated and
     low <= strategy.position_avg_price - activeEffortNoResultActivationTicks * syminfo.mintick
    activeEffortNoResultActivated := true

// 背离反转的保本保护只在确认棒收盘后更新；15m OHLC 无法证明同棒内的先后触价顺序。
if activeLongDivergenceReversalExit and activeLongDivergenceActivated and strategy.position_size > 0
    longDivergenceLockStop = f_round_long_stop(strategy.position_avg_price + syminfo.mintick)
    longDivergenceFinalTarget = f_round_long_target(
         strategy.position_avg_price + activeLongDivergenceTargetTicks * syminfo.mintick)
    if close <= longDivergenceLockStop
        strategy.close("Long", comment = "DIV_BE")
    else
        strategy.exit("Long protection", from_entry = "Long", stop = longDivergenceLockStop,
             limit = longDivergenceFinalTarget, qty_percent = 100,
             comment_profit = "DIV_TP", comment_loss = "DIV_BE")

// 反包棒达到 1R 后才在确认棒收盘更新保护；同棒先触目标还是先回撤在 15m OHLC 中不可判定。
if activeThreeBarEngulfReversalExit and activeThreeBarEngulfActivated and strategy.position_size > 0
    threeBarEngulfLockStop = f_round_long_stop(strategy.position_avg_price + syminfo.mintick)
    threeBarEngulfFinalTarget = f_round_long_target(
         strategy.position_avg_price + activeThreeBarEngulfTargetTicks * syminfo.mintick)
    if close <= threeBarEngulfLockStop
        strategy.close("Long 3Bar", comment = "ENG_BE")
    else
        strategy.exit("Long 3Bar protection", from_entry = "Long 3Bar",
             stop = threeBarEngulfLockStop, limit = threeBarEngulfFinalTarget, qty_percent = 100,
             comment_profit = "ENG_TP", comment_loss = "ENG_BE")

if activeShortDivergenceReversalExit and activeShortDivergenceActivated and strategy.position_size < 0
    shortDivergenceLockStop = f_round_short_stop(strategy.position_avg_price - syminfo.mintick)
    shortDivergenceFinalTarget = f_round_short_target(
         strategy.position_avg_price - activeShortDivergenceTargetTicks * syminfo.mintick)
    if close >= shortDivergenceLockStop
        strategy.close("Short", comment = "DIV_BE")
    else
        strategy.exit("Short protection", from_entry = "Short", stop = shortDivergenceLockStop,
             limit = shortDivergenceFinalTarget, qty_percent = 100,
             comment_profit = "DIV_TP", comment_loss = "DIV_BE")

// 努力无结果反转在1R确认后才更新近似保本；同棒先触目标或先回撤仍遵循15分钟 broker 路径。
if activeEffortNoResultReversalExit and activeEffortNoResultActivated and strategy.position_size < 0
    effortNoResultLockStop = f_round_short_stop(strategy.position_avg_price - syminfo.mintick)
    effortNoResultFinalTarget = f_round_short_target(
         strategy.position_avg_price - activeEffortNoResultTargetTicks * syminfo.mintick)
    if close >= effortNoResultLockStop
        strategy.close("Short ENR", comment = "ENR_BE")
    else
        strategy.exit("Short ENR protection", from_entry = "Short ENR",
             stop = effortNoResultLockStop, limit = effortNoResultFinalTarget, qty_percent = 100,
             comment_profit = "ENR_TP", comment_loss = "ENR_BE")

if activeShortTrendExtension and strategy.position_size < 0 and
     not activeShortTrendExtensionActivated and
     low <= strategy.position_avg_price - activeShortExtensionActivationTicks * syminfo.mintick
    activeShortTrendExtensionActivated := true

// 原固定目标只负责证明趋势已经走出足够位移；近似保本在该确认棒收盘后才提交，下一根开始生效。
// 若确认棒已经收回保本价之上，只能下一开盘主动退出，不能回看棒内路径伪造保本成交。
if activeShortTrendExtension and activeShortTrendExtensionActivated and strategy.position_size < 0
    shortExtensionLockStop = f_round_short_stop(
         strategy.position_avg_price - activeShortExtensionLockTicks * syminfo.mintick)
    shortExtensionFinalTarget = f_round_short_target(
         strategy.position_avg_price - activeShortExtensionTargetTicks * syminfo.mintick)
    if close >= shortExtensionLockStop
        strategy.close("Short", comment = "TP_BE")
    else
        strategy.exit("Short protection", from_entry = "Short", stop = shortExtensionLockStop,
             limit = shortExtensionFinalTarget, qty_percent = 100,
             comment_profit = "TP_EXT", comment_loss = "TP_BE")

if strategy.position_size <= 0 and strategy.position_size[1] > 0
    activeLongDivergenceReversalExit := false
    activeLongDivergenceActivated := false
    activeLongDivergenceActivationTicks := na
    activeLongDivergenceTargetTicks := na
    activeThreeBarEngulfReversalExit := false
    activeThreeBarEngulfActivated := false
    activeThreeBarEngulfActivationTicks := na
    activeThreeBarEngulfTargetTicks := na
    activeLongCounterTrendStructureExit := false
    activeLongCounterTrendActivated := false
    activeLongCounterTrendInitialRisk := na
    activeLongCounterTrendBestPrice := na
    activeLongCounterTrendTrailStop := na
    activeLongCounterTrendTarget := na
    activeLongRsiCounterTrendMature := false
    activeLongRsiCounterTrendStructureConfirmed := false
    activeLongRsiCounterTrendNearTarget := na
    activeLongRsiCounterTrendNetBreakEven := na

if strategy.position_size >= 0 and strategy.position_size[1] < 0
    activeShortDivergenceReversalExit := false
    activeShortDivergenceActivated := false
    activeShortDivergenceActivationTicks := na
    activeShortDivergenceTargetTicks := na
    activeEffortNoResultReversalExit := false
    activeEffortNoResultActivated := false
    activeEffortNoResultActivationTicks := na
    activeEffortNoResultTargetTicks := na
    activeShortTrendExtension := false
    activeShortTrendExtensionActivated := false
    activeShortExtensionActivationTicks := na
    activeShortExtensionLockTicks := na
    activeShortExtensionTargetTicks := na
    activeShortCounterTrendStructureExit := false
    activeShortCounterTrendActivated := false
    activeShortCounterTrendInitialRisk := na
    activeShortCounterTrendBestPrice := na
    activeShortCounterTrendTrailStop := na
    activeShortCounterTrendTarget := na
    activeShortRsiCounterTrendMature := false
    activeShortRsiCounterTrendStructureConfirmed := false
    activeShortRsiCounterTrendNearTarget := na
    activeShortRsiCounterTrendNetBreakEven := na

if strategy.position_size == 0 and strategy.position_size[1] != 0
    activeEntryAtr := na

activeEntryPrice = strategy.position_size != 0 and not na(activeEntryAtr) ?
     strategy.position_avg_price : na
activeEntryAtrUpper = not na(activeEntryPrice) ? activeEntryPrice + activeEntryAtr : na
activeEntryAtrLower = not na(activeEntryPrice) ? activeEntryPrice - activeEntryAtr : na
activeEntryAtrColor = strategy.position_size > 0 ? color.rgb(76, 175, 80) : color.rgb(244, 67, 54)
entryAtrUpperPlot = plot(activeEntryAtrUpper, "Entry +1 ATR", color = color.new(activeEntryAtrColor, 15),
     linewidth = 1, style = plot.style_linebr)
plot(activeEntryPrice, "Entry Price", color = activeEntryAtrColor, linewidth = 2, style = plot.style_linebr)
entryAtrLowerPlot = plot(activeEntryAtrLower, "Entry -1 ATR", color = color.new(activeEntryAtrColor, 15),
     linewidth = 1, style = plot.style_linebr)
fill(entryAtrUpperPlot, entryAtrLowerPlot, color = color.new(activeEntryAtrColor, 92), title = "Entry ±1 ATR")

// 使用成交记录上的退出注释识别止盈/止损，避免同根 K 线同时触及两侧时靠价格猜测。
newClosedTrade = ta.change(strategy.closedtrades) > 0
bool closedTradeIsStop = false
bool closedTradeIsProfit = false
bool closedTradeWasLong = false

if newClosedTrade
    lastTrade = strategy.closedtrades - 1
    exitComment = strategy.closedtrades.exit_comment(lastTrade)
    if exitComment == "SL" or exitComment == "TP" or exitComment == "TP_STRUCT" or
         exitComment == "TP_EXT" or exitComment == "TP_BE" or
         exitComment == "DIV_TP" or exitComment == "DIV_BE" or
         exitComment == "ENG_TP" or exitComment == "ENG_BE" or
         exitComment == "ENR_TP" or exitComment == "ENR_BE" or exitComment == "BLR_TP" or
         exitComment == "EMA596_TP" or exitComment == "CT_TRAIL" or
         exitComment == "CT_V5_BE" or exitComment == "CT_V5_TRAIL"
        exitPrice = strategy.closedtrades.exit_price(lastTrade)
        exitBarIndex = strategy.closedtrades.exit_bar_index(lastTrade)
        closedTradeIsStop := exitComment == "SL"
        closedTradeIsProfit := exitComment == "TP" or exitComment == "TP_STRUCT" or
             exitComment == "TP_EXT" or exitComment == "TP_BE" or
             exitComment == "DIV_TP" or exitComment == "DIV_BE" or
             exitComment == "ENG_TP" or exitComment == "ENG_BE" or
             exitComment == "ENR_TP" or exitComment == "ENR_BE" or exitComment == "BLR_TP" or
             exitComment == "EMA596_TP" or exitComment == "CT_TRAIL" or
             exitComment == "CT_V5_BE" or exitComment == "CT_V5_TRAIL"
        closedTradeWasLong := str.contains(strategy.closedtrades.entry_id(lastTrade), "Long")
        entrySide = closedTradeWasLong ? "多单" : "空单"
        exitTitle = exitComment == "SL" ? "止损平仓" :
             exitComment == "TP_STRUCT" ? "横盘结构止盈" :
             exitComment == "TP_EXT" ? "趋势扩展止盈" :
             exitComment == "TP_BE" ? "趋势保本" :
             exitComment == "DIV_TP" ? "背离止盈" :
             exitComment == "DIV_BE" ? "背离保本" :
             exitComment == "ENG_TP" ? "三棒反包止盈" :
             exitComment == "ENG_BE" ? "三棒反包保本" :
             exitComment == "ENR_TP" ? "努力无结果止盈" :
             exitComment == "ENR_BE" ? "努力无结果保本" :
             exitComment == "BLR_TP" ? "布林中轨结构止盈" :
             exitComment == "CT_TRAIL" ? "逆势1R移动保护" :
             exitComment == "CT_V5_BE" ? "成熟逆势成本净保本" :
             exitComment == "CT_V5_TRAIL" ? "成熟逆势2R宽跟踪" :
             exitComment == "EMA596_TP" ? "EMA596离轨2R止盈" : "止盈平仓"
        exitTooltip = exitTitle + " · " + entrySide +
             "\n价格  " + str.tostring(exitPrice, format.mintick) +
             "\n结果  " + str.tostring(strategy.closedtrades.profit_percent(lastTrade), "#.##") + "%"
        f_add_hover_target(exitBarIndex, exitPrice, exitTooltip)

// plotshape 的 tiny 圆点明显小于 label 圆形；方向决定上下位置，颜色只表达止损或止盈。
plotshape(closedTradeIsStop and closedTradeWasLong, title = "多单止损", style = shape.circle,
     location = location.belowbar, color = color.red, size = size.tiny, display = display.pane)
plotshape(closedTradeIsStop and not closedTradeWasLong, title = "空单止损", style = shape.circle,
     location = location.abovebar, color = color.red, size = size.tiny, display = display.pane)
plotshape(closedTradeIsProfit and closedTradeWasLong, title = "多单止盈", style = shape.circle,
     location = location.belowbar, color = color.green, size = size.tiny, display = display.pane)
plotshape(closedTradeIsProfit and not closedTradeWasLong, title = "空单止盈", style = shape.circle,
     location = location.abovebar, color = color.green, size = size.tiny, display = display.pane)
